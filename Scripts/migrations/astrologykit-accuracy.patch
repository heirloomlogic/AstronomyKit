diff --git a/Tests/AstrologyKitTests/DatedEclipticObservationTests.swift b/Tests/AstrologyKitTests/DatedEclipticObservationTests.swift
new file mode 100644
index 00000000..7d95ebec
--- /dev/null
+++ b/Tests/AstrologyKitTests/DatedEclipticObservationTests.swift
@@ -0,0 +1,47 @@
+import AstronomyKit
+import Foundation
+import Testing
+
+@testable import AstrologyKit
+
+@Suite("Dated apparent ecliptic observations")
+struct DatedEclipticObservationTests {
+    @Test("Planetary longitude and latitude share the dated vector")
+    func datedVector() throws {
+        for year in [1_900, 2_041, 2_100] {
+            let time = AstroTime(year: year, month: 2, day: 1)
+            for body in [CelestialBody.mercury, .venus, .mars, .jupiter, .saturn, .uranus, .neptune, .pluto] {
+                let equatorialRotation = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)
+                let vector = try body.geocentricPosition(at: time).rotated(by: equatorialRotation)
+                let rotation = try RotationMatrix.equatorialOfDateToEclipticOfDate(at: time)
+                let expected = try vector.rotated(by: rotation).toSpherical()
+                let longitude = try GeocentricCalculations.eclipticLongitude(for: body, at: time)
+                let latitude = try GeocentricCalculations.eclipticLatitude(for: body, at: time)
+                #expect(abs(longitude - expected.longitude) < 1e-10)
+                #expect(abs(latitude - expected.latitude) < 1e-10)
+            }
+        }
+    }
+
+    @Test("Fact latitudes use the shared dated observation")
+    func factLatitudes() throws {
+        let time = AstroTime(year: 2_041, month: 2, day: 1)
+        let observed = ElectionFactBuilder.observeEquatorial(at: time, observer: .geocentric)
+        for planet in Planet.allCases {
+            guard let body = GeocentricCalculations.celestialBody(for: planet) else { continue }
+            let expected = try GeocentricCalculations.eclipticLatitude(for: body, at: time)
+            #expect(observed.latitudes[planet] == expected)
+        }
+    }
+
+    @Test("Dedicated Sun and Moon observations preserve their conventions")
+    func luminaries() throws {
+        let time = AstroTime(year: 2_041, month: 2, day: 1)
+        let sun = try Sun.position(at: time)
+        let moon = try Moon.ecliptic(at: time)
+        #expect(try GeocentricCalculations.eclipticLongitude(for: .sun, at: time) == sun.longitude)
+        #expect(try GeocentricCalculations.eclipticLatitude(for: .sun, at: time) == sun.latitude)
+        #expect(try GeocentricCalculations.eclipticLongitude(for: .moon, at: time) == moon.longitude)
+        #expect(try GeocentricCalculations.eclipticLatitude(for: .moon, at: time) == moon.latitude)
+    }
+}
