"text"},{"text":"position calculations at any time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unlike solar system bodies (which require orbital calculations), fixed stars"},{"type":"text","text":" "},{"type":"text","text":"are defined by their J2000 mean equator coordinates and distance. The library"},{"type":"text","text":" "},{"type":"text","text":"handles precession, nutation, and aberration automatically."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"code":["let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","let longitude = try algol.eclipticLongitude(at: .now)","print(\"Algol is at \\(longitude)°\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Coordinate Sources","level":2,"anchor":"Coordinate-Sources"},{"type":"paragraph","inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","type":"reference","isActive":true}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Hipparcos Catalog"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yale Bright Star Catalog"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Concurrency","anchor":"Concurrency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The C library exposes eight user-defined star slots ("},{"code":"BODY_STAR1","type":"codeVoice"},{"type":"text","text":"…"},{"code":"BODY_STAR8","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"each an independent record. Calculations map a star to a slot by a stable hash of"},{"type":"text","text":" "},{"type":"text","text":"its coordinates, so up to e