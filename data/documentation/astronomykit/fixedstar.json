t\/SH","doc:\/\/AstronomyKit\/s8SendableP","doc:\/\/AstronomyKit\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"metadata":{"roleHeading":"Structure","externalID":"s:12AstronomyKit9FixedStarV","symbolKind":"struct","modules":[{"name":"AstronomyKit"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"title":"FixedStar","role":"symbol","navigatorTitle":[{"text":"FixedStar","kind":"identifier"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Fixed stars are celestial objects whose positions are essentially constant"},{"type":"text","text":" "},{"type":"text","text":"on the celestial sphere. This struct stores catalog coordinates and provides"},{"type":"text","text":" "},{"type":"text","text":"position calculations at any time."}],"type":"paragraph"},{"inlineContent":[{"text":"Unlike solar system bodies (which require orbital calculations), fixed stars","type":"text"},{"text":" ","type":"text"},{"text":"are defined by their J2000 mean equator coordinates and distance. The library","type":"text"},{"text":" ","type":"text"},{"text":"handles precession, nutation, and aberration automatically. Ecliptic results","type":"text"},{"text":" ","type":"text"},{"text":"are in the true ecliptic and equinox of date, like the planet positions.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"syntax":"swift","code":["let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","let longitude = try algol.eclipticLongitude(at: .now)","print(\"Algol is at \\(longitude)°\")"],"type":"codeListing"},{"anchor":"Coordinate-Sources","level":2,"text":"Coordinate Sources","type":"heading"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hipparcos Catalog","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Yale Bright Star Catalog"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Concurrency","level":2,"text":"Concurrency","type":"heading"},{"inlineContent":[{"text":"The C library exposes eight user-defined star slots (","type":"text"},{"code":"BODY_STAR1","type":"codeVoice"},{"text":"…","type":"text"},{"code":"BODY_STAR8","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"each an independent record. Calculations map a star to a slot by a stable hash of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"its coordinates, so up to eight distinct stars can be computed fully in parallel."},{"text":" ","type":"text"},{"text":"A slot is only redefined when the star currently loaded in it differs, so repeated","type":"text"},{"text":" ","type":"text"},{"text":"calls for the same star skip the redefinition entirely. Stars whose hashes collide","type":"text"},{"text":" ","type":"text"},{"text":"on the same slot serialize on that slot’s mutex (correct, just slower).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures","doc:\/\/Astrono