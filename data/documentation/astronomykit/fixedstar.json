{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"navigatorTitle":[{"text":"FixedStar","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"AstronomyKit"}],"role":"symbol","externalID":"s:12AstronomyKit9FixedStarV","roleHeading":"Structure","title":"FixedStar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}]},"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/init(name:rightAscension:declination:distance:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/declination","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/distance","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/name","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/rightAscension"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/constellation(at:)","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/ecliptic(at:)","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/eclipticLatitude(at:)","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/eclipticLongitude(at:)","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/equatorial(at:from:equatorDate:)","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/horizon(at:from:refraction:)"],"title":"Instance Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/CustomStringConvertible-Implementations","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fixed stars are celestial objects whose positions are essentially constant"},{"type":"text","text":" "},{"type":"text","text":"on the celestial sphere. This struct stores catalog coordinates and provides"},{"type":"text","text":" "},{"type":"text","text":"position calculations at any time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike solar system bodies (which require orbital calculations), fixed stars"},{"type":"text","text":" "},{"type":"text","text":"are defined by their J2000 mean equator coordinates and distance. The library"},{"type":"text","text":" "},{"type":"text","text":"handles precession, nutation, and aberration automatically. Ecliptic results"},{"type":"text","text":" "},{"type":"text","text":"are in the true ecliptic and equinox of date, like the planet positions."}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","let longitude = try algol.eclipticLongitude(at: .now)","print(\"Algol is at \\(longitude)°\")"]},{"text":"Coordinate Sources","type":"heading","level":2,"anchor":"Coordinate-Sources"},{"type":"paragraph","inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Hipparcos Catalog","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}],"type":"paragraph"}]}]},{"text":"Concurrency","type":"heading","level":2,"anchor":"Concurrency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The C library exposes eight user-defined star slots ("},{"type":"codeVoice","code":"BODY_STAR1"},{"type":"text","text":"…"},{"type":"codeVoice","code":"BODY_STAR8"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"each an independent record. Calculations map a star to a slot by a stable hash of"},{"type":"text","text":" "},{"type":"text","text":"its coordinates, so up to eight distinct stars can be computed fully in parallel."},{"type":"text","text":" "},{"type":"text","text":"A slot is only redefined when the star currently loaded in it differs, so repeated"},{"type":"text","text":" "},{"type":"text","text":"calls for the same star skip the redefinition entirely. Stars whose hashes collide"},{"type":"text","text":" "},{"type":"text","text":"on the same slot serialize on that slot’s mutex (correct, just slower)."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/fixedstar"]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/AstronomyKit\/s8CopyableP","doc:\/\/AstronomyKit\/s23CustomStringConvertibleP","doc:\/\/AstronomyKit\/SQ","doc:\/\/AstronomyKit\/s9EscapableP","doc:\/\/AstronomyKit\/SH","doc:\/\/AstronomyKit\/s8SendableP","doc:\/\/AstronomyKit\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"sections":[],"seeAlsoSections":[{"title":"Advanced","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentatio