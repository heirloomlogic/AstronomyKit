{"kind":"symbol","abstract":[{"text":"A fixed star defined by its J2000 equatorial coordinates.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"Fixed stars are celestial objects whose positions are essentially constant","type":"text"},{"text":" ","type":"text"},{"text":"on the celestial sphere. This struct stores catalog coordinates and provides","type":"text"},{"text":" ","type":"text"},{"text":"position calculations at any time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Unlike solar system bodies (which require orbital calculations), fixed stars","type":"text"},{"text":" ","type":"text"},{"text":"are defined by their J2000 mean equator coordinates and distance. The library","type":"text"},{"text":" ","type":"text"},{"text":"handles precession, nutation, and aberration automatically.","type":"text"}],"type":"paragraph"},{"text":"Example","anchor":"Example","type":"heading","level":2},{"code":["let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","let longitude = try algol.eclipticLongitude(at: .now)","print(\"Algol is at \\(longitude)°\")"],"syntax":"swift","type":"codeListing"},{"text":"Coordinate Sources","anchor":"Coordinate-Sources","type":"heading","level":2},{"inlineContent":[{"text":"J2000 coordinates can be found from:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hipparcos Catalog","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}]}]}],"type":"unorderedList"},{"text":"Concurrency","anchor":"Concurrency","type":"heading","level":2},{"inlineContent":[{"text":"The C library exposes eight user-defined star slots (","type":"text"},{"code":"BODY_STAR1","type":"codeVoice"},{"text":"…","type":"text"},{"code":"BODY_STAR8","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"each an independent record. Calculations map a star to a slot by a stable hash of","type":"text"},{"text":" ","type":"text"},{"text":"its coordinates, so up to eight distinct stars can be computed fully in parallel.","type":"text"},{"text":" ","type":"text"},{"text":"A slot is only redefined when the star currently loaded in it differs, so repeated","type":"text"},{"text":" ","type":"text"},{"text":"calls for the same star skip the redefinition entirely. Stars whose hashes collide","type":"text"},{"text":" ","type":"text"},{"text":"on the same slot serialize on that slot’s mutex (correct, just slower).","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/init(name:rightAscension:declination:distance:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/declination","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/distance","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/name","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/rightAscension"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Fix