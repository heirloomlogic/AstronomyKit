ere. This struct stores catalog coordinates and provides"},{"type":"text","text":" "},{"type":"text","text":"position calculations at any time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unlike solar system bodies (which require orbital calculations), fixed stars"},{"type":"text","text":" "},{"type":"text","text":"are defined by their J2000 mean equator coordinates and distance. The library"},{"type":"text","text":" "},{"type":"text","text":"handles precession, nutation, and aberration automatically."}],"type":"paragraph"},{"anchor":"Example","text":"Example","type":"heading","level":2},{"syntax":"swift","code":["let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","let longitude = try algol.eclipticLongitude(at: .now)","print(\"Algol is at \\(longitude)°\")"],"type":"codeListing"},{"anchor":"Coordinate-Sources","text":"Coordinate Sources","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hipparcos Catalog"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yale Bright Star Catalog"}]}]}],"type":"unorderedList"},{"anchor":"Concurrency","text":"Concurrency","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The C library exposes eight user-defined star slots ("},{"type":"codeVoice","code":"BODY_STAR1"},{"type":"text","text":"…"},{"type":"codeVoice","code":"BODY_STAR8"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"each an independent record. Calculations map a star to a slot by a stable hash of"},{"type":"text","text":" "},{"type":"text","text":"its coordinates, so up to eight distinct stars can be computed fully in parallel."},{"type":"text","text":" "},{"type":"text","text":"A slot is only redefined when the star currently loaded in it differs, so repeated"},{"type":"text","text":" "},{"type":"text","text":"calls for the same star skip the redefinition entirely. Stars whose hashes collide"},{"type":"text","text":" "},{"type":"text","text":"on the same slot serialize on that slot’s mutex (correct, just slower)."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/RotationAxis":{"url":"\/documentation\/astronomykit\/rotationaxis","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RotationAxis"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","abstract":[{"type":"text","text":"Information about a body’s rotation axis orientation."}],"navigatorTitle":[{"kind":"identifier","text":"RotationAxis"}],"title":"RotationAxis"},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar/distance":{"url":"\/documentation\/astronomykit\/fixedstar\/distance","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/distance","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Distance from Earth in light-years."}],"title":"distance","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}]},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar/constellation(at:)":{"url":"\/documentation\/astronomykit\/fixedstar\/constellation(at:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar\/constellation(at:)","type":"topic","abstract":[{"text":"Determines which cons