{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems."}]},{"type":"heading","level":2,"anchor":"Celestial-Bodies","text":"Celestial Bodies"},{"type":"heading","level":3,"anchor":"Available-Bodies","text":"Available Bodies"},{"type":"codeListing","syntax":"swift","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"]},{"anchor":"Body-Properties","type":"heading","level":3,"text":"Body Properties"},{"type":"codeListing","syntax":"swift","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"]},{"anchor":"Looking-Up-Bodies-by-Name","type":"heading","level":3,"text":"Looking Up Bodies by Name"},{"code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Horizon-Coordinates","type":"heading","level":2,"text":"Horizon Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where does a body appear in your local sky?"}]},{"code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Equatorial-Coordinates","type":"heading","level":2,"text":"Equatorial Coordinates"},{"inlineContent":[{"type":"text","text":"Right ascension and declination on the celestial sphere:"}],"type":"paragraph"},{"code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Equator-Date-Options","text":"Equator Date Options"},{"inlineContent":[{"type":"text","text":"Choose the reference equinox:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"type":"heading","text":"Ecliptic Coordinates","anchor":"Ecliptic-Coordinates","level":2},{"inlineContent":[{"type":"text","text":"Position relative to the ecliptic plane:"}],"type":"paragraph"},{"code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Position Vectors","anchor":"Position-Vectors","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cartesian coordinates in 3D space:"}]},{"type":"codeListing","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"],"syntax":"swift"},{"type":"heading","anchor":"Distance-Calculations","level":2,"text":"Distance Calculations"},{"type":"codeListing","syntax":"swift","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"]},{"type":"heading","text":"Constellation Identification","anchor":"Constellation-Identification","level":2},{"inlineContent":[{"text":"Find which constellation contains a body:","type":"text"}],"type":"paragraph"},{"code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Fixed Stars","anchor":"Fixed-Stars","type":"heading"},{"inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates using "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog."}],"type":"paragraph"},{"level":2,"text":"Aberration Correction","anchor":"Aberration-Correction","type":"heading"},{"inlineContent":[{"type":"text","text":"Control light-time and aberration corrections:"}],"type":"paragraph"},{"code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Refraction Correction","anchor":"Refraction-Correction","type":"heading"},{"inlineContent":[{"type":"text","text":"Atmospheric refraction affects horizon coordinates:"}],"type":"paragraph"},{"code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"type":"codeListing","syntax":"swift"}]}],"abstract":[{"type":"text","text":"Calculate the positions of celestial bodies in various coordinate systems."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"anchor":"Position-Calculations","title":"Position Calculations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/celestialpositions"]}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"AstronomyKit"}],"title":"Celestial Positions"},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"sections":[],"references":{"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"url":"\/documentation\/astronomykit\/observer","abstract":[{"type":"text","text":"A geographic location for observing celestial objects."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observer","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","navigatorTitle":[{"text":"Observer","kind":"identifier"}],"title":"Observer"},"https://github.com/cosinekitty/astronomy":{"titleInlineContent":[{"text":"Astronomy Engine","type":"text"}],"url":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"link"},"doc://AstronomyKit/documentation/AstronomyKit/EquatorDate":{"title":"EquatorDate","type":"topic","url":"\/documentation\/astronomykit\/equatordate","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate","abstract":[{"text":"The equinox reference for equatorial coordinates.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatorDate","kind":"identifier"}],"navigatorTitle":[{"text":"EquatorDate","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CelestialBody","kind":"identifier"}],"abstract":[{"type":"text","text":"A celestial body in the solar system."}],"type":"topic","url":"\/documentation\/astronomykit\/celestialbody","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","title":"CelestialBody","navigatorTitle":[{"text":"CelestialBody","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Constellation":{"title":"Constellation","type":"topic","url":"\/documentation\/astronomykit\/constellation","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","abstract":[{"type":"text","text":"A constellation identified from celestial coordinates."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constellation","kind":"identifier"}],"navigatorTitle":[{"text":"Constellation","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystems":{"url":"\/documentation\/astronomykit\/coordinatesystems","abstract":[{"type":"text","text":"Transform positions between different astronomical coordinate systems."}],"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","title":"Coordinate Systems"},"doc://AstronomyKit/documentation/AstronomyKit":{"title":"AstronomyKit","type":"topic","url":"\/documentation\/astronomykit","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","abstract":[{"type":"text","text":"Swift bindings for Don Cross’ "},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"type":"text","text":" library."}],"kind":"symbol","role":"collection"},"doc://AstronomyKit/documentation/AstronomyKit/Aberration":{"title":"Aberration","type":"topic","url":"\/documentation\/astronomykit\/aberration","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","abstract":[{"type":"text","text":"Light aberration correction mode."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Aberration","kind":"identifier"}],"navigatorTitle":[{"text":"Aberration","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"url":"\/documentation\/astronomykit\/fixedstar","abstract":[{"type":"text","text":"A fixed star defined by its J2000 equatorial coordinates."}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","navigatorTitle":[{"text":"FixedStar","kind":"identifier"}],"title":"FixedStar"}}}