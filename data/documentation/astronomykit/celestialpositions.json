{"abstract":[{"type":"text","text":"Calculate the positions of celestial bodies in various coordinate systems."}],"kind":"article","metadata":{"modules":[{"name":"AstronomyKit"}],"role":"article","title":"Celestial Positions","roleHeading":"Article"},"seeAlsoSections":[{"title":"Position Calculations","generated":true,"anchor":"Position-Calculations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"]}],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems."}]},{"anchor":"Celestial-Bodies","text":"Celestial Bodies","type":"heading","level":2},{"anchor":"Available-Bodies","text":"Available Bodies","type":"heading","level":3},{"syntax":"swift","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"],"type":"codeListing"},{"anchor":"Body-Properties","text":"Body Properties","type":"heading","level":3},{"syntax":"swift","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"],"type":"codeListing"},{"anchor":"Looking-Up-Bodies-by-Name","text":"Looking Up Bodies by Name","type":"heading","level":3},{"syntax":"swift","code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"],"type":"codeListing"},{"anchor":"Horizon-Coordinates","text":"Horizon Coordinates","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Where does a body appear in your local sky?","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"]},{"level":2,"type":"heading","anchor":"Equatorial-Coordinates","text":"Equatorial Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Right ascension and declination on the celestial sphere:"}]},{"type":"codeListing","code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""],"syntax":"swift"},{"type":"heading","level":3,"text":"Equator Date Options","anchor":"Equator-Date-Options"},{"type":"paragraph","inlineContent":[{"text":"Choose the reference equinox:","type":"text"}]},{"type":"codeListing","code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Ecliptic Coordinates","anchor":"Ecliptic-Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position relative to the ecliptic plane:"}]},{"type":"codeListing","code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Position Vectors","anchor":"Position-Vectors"},{"type":"paragraph","inlineContent":[{"text":"Cartesian coordinates in 3D space:","type":"text"}]},{"type":"codeListing","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Distance Calculations","anchor":"Distance-Calculations"},{"type":"codeListing","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Constellation Identification","anchor":"Constellation-Identification"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find which constellation contains a body:"}]},{"type":"codeListing","code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""],"syntax":"swift"},{"type":"heading","level":2,"text":"Fixed Stars","anchor":"Fixed-Stars"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude (true ecliptic and equinox of date, same frame as the planets)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog.","type":"text"}]},{"type":"heading","level":2,"text":"Aberration Correction","anchor":"Aberration-Correction"},{"type":"paragraph","inlineContent":[{"text":"Control light-time and aberration corrections:","type":"text"}]},{"type":"codeListing","code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Refraction Correction","anchor":"Refraction-Correction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Atmospheric refraction affects horizon coordinates:"}]},{"type":"codeListing","code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"paths":["\/documentation\/astronomykit\/celestialpositions"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"title":"CelestialBody","kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","abstract":[{"text":"A celestial body in the solar system.","type":"text"}],"url":"\/documentation\/astronomykit\/celestialbody","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CelestialBody","kind":"identifier"}],"navigatorTitle":[{"text":"CelestialBody","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit":{"title":"AstronomyKit","role":"collection","type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","url":"\/documentation\/astronomykit","abstract":[{"text":"Swift bindings for Don Cross’ ","type":"text"},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","isActive":true,"type":"reference"},{"text":" library.","type":"text"}],"kind":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Aberration":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Aberration","kind":"identifier"}],"title":"Aberration","role":"symbol","type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","url":"\/documentation\/astronomykit\/aberration","navigatorTitle":[{"text":"Aberration","kind":"identifier"}],"abstract":[{"type":"text","text":"Light aberration correction mode."}],"kind":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observer","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","type":"topic","navigatorTitle":[{"text":"Observer","kind":"identifier"}],"abstract":[{"type":"text","text":"A geographic location for observing celestial objects."}],"title":"Observer","kind":"symbol","url":"\/documentation\/astronomykit\/observer"},"doc://AstronomyKit/documentation/AstronomyKit/EquatorDate":{"navigatorTitle":[{"text":"EquatorDate","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","title":"EquatorDate","url":"\/documentation\/astronomykit\/equatordate","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatorDate","kind":"identifier"}],"abstract":[{"type":"text","text":"The equinox reference for equatorial coordinates."}]},"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystems":{"title":"Coordinate Systems","kind":"article","type":"topic","abstract":[{"type":"text","text":"Transform positions between different astronomical coordinate systems."}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","url":"\/documentation\/astronomykit\/coordinatesystems","role":"article"},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FixedStar"}],"abstract":[{"type":"text","text":"A fixed star defined by its J2000 equatorial coordinates."}],"title":"FixedStar","kind":"symbol","url":"\/documentation\/astronomykit\/fixedstar"},"doc://AstronomyKit/documentation/AstronomyKit/Constellation":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constellation"}],"title":"Constellation","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","type":"topic","url":"\/documentation\/astronomykit\/constellation","navigatorTitle":[{"kind":"identifier","text":"Constellation"}],"abstract":[{"type":"text","text":"A constellation identified from celestial coordinates."}],"kind":"symbol"},"https://github.com/cosinekitty/astronomy":{"title":"Astronomy Engine","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"url":"https:\/\/github.com\/cosinekitty\/astronomy","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"link"}}}