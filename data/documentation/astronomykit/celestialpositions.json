{"seeAlsoSections":[{"generated":true,"anchor":"Position-Calculations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"title":"Position Calculations"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"AstronomyKit"}],"title":"Celestial Positions"},"abstract":[{"type":"text","text":"Calculate the positions of celestial bodies in various coordinate systems."}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/celestialpositions"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems."}]},{"type":"heading","level":2,"anchor":"Celestial-Bodies","text":"Celestial Bodies"},{"type":"heading","level":3,"anchor":"Available-Bodies","text":"Available Bodies"},{"type":"codeListing","syntax":"swift","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"]},{"type":"heading","level":3,"anchor":"Body-Properties","text":"Body Properties"},{"type":"codeListing","syntax":"swift","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"]},{"type":"heading","level":3,"anchor":"Looking-Up-Bodies-by-Name","text":"Looking Up Bodies by Name"},{"type":"codeListing","syntax":"swift","code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"]},{"type":"heading","level":2,"anchor":"Horizon-Coordinates","text":"Horizon Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where does a body appear in your local sky?"}]},{"type":"codeListing","syntax":"swift","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"]},{"type":"heading","level":2,"anchor":"Equatorial-Coordinates","text":"Equatorial Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Right ascension and declination on the celestial sphere:"}]},{"type":"codeListing","syntax":"swift","code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""]},{"type":"heading","level":3,"anchor":"Equator-Date-Options","text":"Equator Date Options"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the reference equinox:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"]},{"type":"heading","level":2,"anchor":"Ecliptic-Coordinates","text":"Ecliptic Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position relative to the ecliptic plane:"}]},{"type":"codeListing","syntax":"swift","code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"]},{"type":"heading","level":3,"anchor":"Ecliptic-Position-and-Velocity","text":"Ecliptic Position and Velocity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need the rate of motion as well as the position, ask for the state in one call instead of differencing positions:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Apparent geocentric position and velocity, true ecliptic and equinox of date","let mars = try CelestialBody.mars.geocentricEclipticState(at: .now)","print(\"Mars: λ=\\(mars.longitude)°, λ̇=\\(mars.longitudeRate)°\/day\")","if mars.longitudeRate < 0 { print(\"Mars is retrograde\") }","","\/\/ Sun and Moon through their dedicated ephemerides","let sun = try Sun.eclipticState(at: .now)","let moon = try Moon.eclipticState(at: .now)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The position fields are bit-identical to the position call each state mirrors: "},{"type":"codeVoice","code":"geocentricPosition(at:aberration:).toEcliptic()"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sun.position(at:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Moon.ecliptic(at:)"},{"type":"text","text":". The rates are the time derivative of that position in degrees (or AU) per Terrestrial Time day with Delta T held fixed. For the Sun and planets they are analytic and include the light-time derivative, the observer’s motion under the aberration approximation, and the rotation of the true ecliptic and equinox of date, so they stay smooth where a finite difference would be noisy, such as near a station. The Moon’s rates are a central difference of the lunar series inside the engine over about 43 seconds, accurate to roughly 1e-7 degrees per day."}]},{"type":"heading","level":2,"anchor":"Position-Vectors","text":"Position Vectors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cartesian coordinates in 3D space:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"]},{"type":"heading","level":2,"anchor":"Distance-Calculations","text":"Distance Calculations"},{"type":"codeListing","syntax":"swift","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"]},{"type":"heading","level":2,"anchor":"Constellation-Identification","text":"Constellation Identification"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find which constellation contains a body:"}]},{"type":"codeListing","syntax":"swift","code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""]},{"type":"heading","level":2,"anchor":"Fixed-Stars","text":"Fixed Stars"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates using "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog."}]},{"type":"heading","level":2,"anchor":"Aberration-Correction","text":"Aberration Correction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control light-time and aberration corrections:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"]},{"type":"heading","level":2,"anchor":"Refraction-Correction","text":"Refraction Correction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Atmospheric refraction affects horizon coordinates:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"]}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","kind":"symbol","title":"Observer","abstract":[{"type":"text","text":"A geographic location for observing celestial objects."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observer","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Observer","kind":"identifier"}],"url":"\/documentation\/astronomykit\/observer"},"doc://AstronomyKit/documentation/AstronomyKit":{"type":"topic","kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","title":"AstronomyKit","abstract":[{"type":"text","text":"Swift bindings for Don Cross’ "},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","isActive":true,"type":"reference"},{"type":"text","text":" library."}],"role":"collection","url":"\/documentation\/astronomykit"},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"url":"\/documentation\/astronomykit\/fixedstar","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedStar"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","abstract":[{"type":"text","text":"A fixed star defined by its J2000 equatorial coordinates."}],"navigatorTitle":[{"kind":"identifier","text":"FixedStar"}],"title":"FixedStar"},"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystem