{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"},"abstract":[{"type":"text","text":"Calculate the positions of celestial bodies in various coordinate systems."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/celestialpositions"]}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","roleHeading":"Article","title":"Celestial Positions","modules":[{"name":"AstronomyKit"}]},"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"anchor":"Position-Calculations","title":"Position Calculations"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems.","type":"text"}]},{"type":"heading","level":2,"anchor":"Celestial-Bodies","text":"Celestial Bodies"},{"type":"heading","level":3,"anchor":"Available-Bodies","text":"Available Bodies"},{"type":"codeListing","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"],"syntax":"swift"},{"text":"Body Properties","anchor":"Body-Properties","type":"heading","level":3},{"type":"codeListing","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Looking-Up-Bodies-by-Name","text":"Looking Up Bodies by Name"},{"type":"codeListing","code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"],"syntax":"swift"},{"text":"Horizon Coordinates","level":2,"type":"heading","anchor":"Horizon-Coordinates"},{"inlineContent":[{"type":"text","text":"Where does a body appear in your local sky?"}],"type":"paragraph"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"],"type":"codeListing"},{"text":"Equatorial Coordinates","anchor":"Equatorial-Coordinates","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Right ascension and declination on the celestial sphere:"}]},{"syntax":"swift","code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""],"type":"codeListing"},{"type":"heading","level":3,"anchor":"Equator-Date-Options","text":"Equator Date Options"},{"type":"paragraph","inlineContent":[{"text":"Choose the reference equinox:","type":"text"}]},{"type":"codeListing","code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Ecliptic-Coordinates","text":"Ecliptic Coordinates"},{"type":"paragraph","inlineContent":[{"text":"Position relative to the ecliptic plane:","type":"text"}]},{"type":"codeListing","code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Position-Vectors","text":"Position Vectors"},{"inlineContent":[{"type":"text","text":"Cartesian coordinates in 3D space:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"],"type":"codeListing"},{"text":"Distance Calculations","level":2,"type":"heading","anchor":"Distance-Calculations"},{"syntax":"swift","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"],"type":"codeListing"},{"text":"Constellation Identification","level":2,"type":"heading","anchor":"Constellation-Identification"},{"inlineContent":[{"type":"text","text":"Find which constellation contains a body:"}],"type":"paragraph"},{"syntax":"swift","code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""],"type":"codeListing"},{"text":"Fixed Stars","level":2,"type":"heading","anchor":"Fixed-Stars"},{"inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates using "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude (true ecliptic and equinox of date, same frame as the planets)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog."}],"type":"paragraph"},{"text":"Aberration Correction","level":2,"type":"heading","anchor":"Aberration-Correction"},{"inlineContent":[{"type":"text","text":"Control light-time and aberration corrections:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"type":"codeListing"},{"text":"Refraction Correction","level":2,"type":"heading","anchor":"Refraction-Correction"},{"inlineContent":[{"type":"text","text":"Atmospheric refraction affects horizon coordinates:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"references":{"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystems":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","abstract":[{"text":"Transform positions between different astronomical coordinate systems.","type":"text"}],"url":"\/documentation\/astronomykit\/coordinatesystems","kind":"article","type":"topic","title":"Coordinate Systems","role":"article"},"https://github.com/cosinekitty/astronomy":{"url":"https:\/\/github.com\/cosinekitty\/astronomy","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"type":"link","title":"Astronomy Engine","identifier":"https:\/\/github.com\/cosinekitty\/astronomy"},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observer"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","abstract":[{"text":"A geographic location for observing celestial objects.","type":"text"}],"url":"\/documentation\/astronomykit\/observer","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Observer"}],"title":"Observer","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CelestialBody"}],"type":"topic","title":"CelestialBody","abstract":[{"type":"text","text":"A celestial body in the solar system."}],"role":"symbol","url":"\/documentation\/astronomykit\/celestialbody","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CelestialBody"}]},"doc://AstronomyKit/documentation/AstronomyKit/EquatorDate":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatorDate","kind":"identifier"}],"type":"topic","title":"EquatorDate","abstract":[{"type":"text","text":"The equinox reference for equatorial coordinates."}],"role":"symbol","url":"\/documentation\/astronomykit\/equatordate","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EquatorDate"}]},"doc://AstronomyKit/documentation/AstronomyKit/Constellation":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constellation","kind":"identifier"}],"type":"topic","title":"Constellation","abstract":[{"text":"A constellation identified from celestial coordinates.","type":"text"}],"role":"symbol","url":"\/documentation\/astronomykit\/constellation","kind":"symbol","navigatorTitle":[{"text":"Constellation","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/Aberration":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Aberration","kind":"identifier"}],"type":"topic","title":"Aberration","abstract":[{"text":"Light aberration correction mode.","type":"text"}],"role":"symbol","url":"\/documentation\/astronomykit\/aberration","kind":"symbol","navigatorTitle":[{"text":"Aberration","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedStar"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","abstract":[{"type":"text","text":"A fixed star defined by its J2000 equatorial coordinates."}],"url":"\/documentation\/astronomykit\/fixedstar","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FixedStar"}],"title":"FixedStar","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","type":"topic","abstract":[{"text":"Swift bindings for Don Cross’ ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/cosinekitty\/astronomy"},{"type":"text","text":" library."}],"kind":"symbol","url":"\/documentation\/astronomykit","title":"AstronomyKit","role":"collection"}}}