{"metadata":{"roleHeading":"Article","title":"Celestial Positions","role":"article","modules":[{"name":"AstronomyKit"}]},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Position-Calculations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"title":"Position Calculations"}],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"abstract":[{"type":"text","text":"Calculate the positions of celestial bodies in various coordinate systems."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems."}],"type":"paragraph"},{"anchor":"Celestial-Bodies","type":"heading","level":2,"text":"Celestial Bodies"},{"anchor":"Available-Bodies","type":"heading","level":3,"text":"Available Bodies"},{"type":"codeListing","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"],"syntax":"swift"},{"anchor":"Body-Properties","type":"heading","level":3,"text":"Body Properties"},{"type":"codeListing","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"],"syntax":"swift"},{"anchor":"Looking-Up-Bodies-by-Name","type":"heading","level":3,"text":"Looking Up Bodies by Name"},{"type":"codeListing","code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"],"syntax":"swift"},{"anchor":"Horizon-Coordinates","type":"heading","level":2,"text":"Horizon Coordinates"},{"inlineContent":[{"type":"text","text":"Where does a body appear in your local sky?"}],"type":"paragraph"},{"type":"codeListing","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"],"syntax":"swift"},{"anchor":"Equatorial-Coordinates","type":"heading","level":2,"text":"Equatorial Coordinates"},{"inlineContent":[{"text":"Right ascension and declination on the celestial sphere:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""],"syntax":"swift"},{"anchor":"Equator-Date-Options","type":"heading","level":3,"text":"Equator Date Options"},{"inlineContent":[{"text":"Choose the reference equinox:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"level":2,"anchor":"Ecliptic-Coordinates","type":"heading","text":"Ecliptic Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position relative to the ecliptic plane:"}]},{"type":"codeListing","code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"],"syntax":"swift"},{"level":2,"anchor":"Position-Vectors","type":"heading","text":"Position Vectors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cartesian coordinates in 3D space:"}]},{"type":"codeListing","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"],"syntax":"swift"},{"level":2,"anchor":"Distance-Calculations","type":"heading","text":"Distance Calculations"},{"type":"codeListing","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"],"syntax":"swift"},{"level":2,"anchor":"Constellation-Identification","type":"heading","text":"Constellation Identification"},{"type":"paragraph","inlineContent":[{"text":"Find which constellation contains a body:","type":"text"}]},{"type":"codeListing","code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""],"syntax":"swift"},{"level":2,"anchor":"Fixed-Stars","type":"heading","text":"Fixed Stars"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog."}]},{"level":2,"anchor":"Aberration-Correction","type":"heading","text":"Aberration Correction"},{"type":"paragraph","inlineContent":[{"text":"Control light-time and aberration corrections:","type":"text"}]},{"type":"codeListing","code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"syntax":"swift"},{"level":2,"anchor":"Refraction-Correction","type":"heading","text":"Refraction Correction"},{"type":"paragraph","inlineContent":[{"text":"Atmospheric refraction affects horizon coordinates:","type":"text"}]},{"type":"codeListing","code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift"}],"kind":"content"}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/astronomykit\/celestialpositions"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/Aberration":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Aberration"}],"navigatorTitle":[{"kind":"identifier","text":"Aberration"}],"url":"\/documentation\/astronomykit\/aberration","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","abstract":[{"type":"text","text":"Light aberration correction mode."}],"type":"topic","role":"symbol","title":"Aberration","kind":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"kind":"symbol","type":"topic","abstract":[{"text":"A celestial body in the solar system.","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CelestialBody","kind":"identifier"}],"navigatorTitle":[{"text":"CelestialBody","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","title":"CelestialBody","url":"\/documentation\/astronomykit\/celestialbody"},"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystems":{"url":"\/documentation\/astronomykit\/coordinatesystems","abstract":[{"type":"text","text":"Transform positions between different astronomical coordinate systems."}],"identif