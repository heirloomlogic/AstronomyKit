{"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"seeAlsoSections":[{"anchor":"Position-Calculations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"generated":true,"title":"Position Calculations"}],"metadata":{"roleHeading":"Article","modules":[{"name":"AstronomyKit"}],"role":"article","title":"Celestial Positions"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Calculate the positions of celestial bodies in various coordinate systems."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/celestialpositions"]}],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems."}]},{"type":"heading","text":"Celestial Bodies","level":2,"anchor":"Celestial-Bodies"},{"type":"heading","text":"Available Bodies","level":3,"anchor":"Available-Bodies"},{"syntax":"swift","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"],"type":"codeListing"},{"anchor":"Body-Properties","type":"heading","level":3,"text":"Body Properties"},{"type":"codeListing","syntax":"swift","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"]},{"level":3,"anchor":"Looking-Up-Bodies-by-Name","type":"heading","text":"Looking Up Bodies by Name"},{"code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Horizon Coordinates","level":2,"anchor":"Horizon-Coordinates"},{"type":"paragraph","inlineContent":[{"text":"Where does a body appear in your local sky?","type":"text"}]},{"type":"codeListing","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Equatorial-Coordinates","text":"Equatorial Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Right ascension and declination on the celestial sphere:"}]},{"code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Equator Date Options","level":3,"anchor":"Equator-Date-Options"},{"inlineContent":[{"type":"text","text":"Choose the reference equinox:"}],"type":"paragraph"},{"code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Ecliptic Coordinates","type":"heading","anchor":"Ecliptic-Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position relative to the ecliptic plane:"}]},{"type":"codeListing","code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"],"syntax":"swift"},{"type":"heading","anchor":"Ecliptic-Position-and-Velocity","text":"Ecliptic Position and Velocity","level":3},{"inlineContent":[{"text":"When you need the rate of motion as well as the position, ask for the state in one call instead of differencing positions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Apparent geocentric position and velocity, true ecliptic and equinox of date","let mars = try CelestialBody.mars.geocentricEclipticState(at: .now)","print(\"Mars: λ=\\(mars.longitude)°, λ̇=\\(mars.longitudeRate)°\/day\")","if mars.longitudeRate < 0 { print(\"Mars is retrograde\") }","","\/\/ Sun and Moon through their dedicated ephemerides","let sun = try Sun.eclipticState(at: .now)","let moon = try Moon.eclipticState(at: .now)"]},{"inlineContent":[{"text":"The position fields are bit-identical to the position call each state mirrors: ","type":"text"},{"code":"geocentricPosition(at:aberration:).toEcliptic()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Sun.position(at:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Moon.ecliptic(at:)","type":"codeVoice"},{"text":". The rates are the time derivative of that position in degrees (or AU) per Terrestrial Time day with Delta T held fixed. For the Sun and planets they are analytic and include the light-time derivative, the observer’s motion under the aberration approximation, and the rotation of the true ecliptic and equinox of date, so they stay smooth where a finite difference would be noisy, such as near a station. The Moon’s rates are a central difference of the lunar series inside the engine over about 43 seconds, accurate to roughly 1e-7 degrees per day.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Position-Vectors","text":"Position Vectors","level":2},{"inlineContent":[{"type":"text","text":"Cartesian coordinates in 3D space:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"]},{"type":"heading","anchor":"Distance-Calculations","text":"Distance Calculations","level":2},{"syntax":"swift","type":"codeListing","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"]},{"type":"heading","anchor":"Constellation-Identification","text":"Constellation Identification","level":2},{"inlineContent":[{"type":"text","text":"Find which constellation contains a body:"}],"type":"paragraph"},{"syntax":"swift","code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""],"type":"codeListing"},{"anchor":"Fixed-Stars","level":2,"text":"Fixed Stars","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Define and track fixed stars by their J2000 catalog coordinates using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar"},{"type":"text","text":":"}]},{"code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Aberration-Correction","text":"Aberration Correction"},{"inlineContent":[{"type":"text","text":"Control light-time and aberration corrections:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"]},{"type":"heading","level":2,"anchor":"Refraction-Correction","text":"Refraction Correction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Atmospheric refraction affects horizon coordinates:"}]},{"syntax":"swift","code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"type":"codeListing"}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","url":"\/documentation\/astronomykit\/fixedstar","kind":"symbol","type":"topic","abstract":[{"text":"A fixed star defined by its J2000 equatorial coordinates.","type":"text"}],"title":"FixedStar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"navigatorTitle":[{"text":"FixedStar","kind":"identifier"}],"role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystems":{"title":"Coordinate Systems","abstract":[{"text":"Transform positions between different astronomical coordinate systems.","type":"text"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","role":"article","url":"\/documentation\/astronomykit\/coordinatesystems","type":"topic","kind":"article"},"doc://AstronomyKit/documentation/AstronomyKit/Constellation":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","url":"\/documentation\/astronomykit\/constellation","kind":"symbol","type":"topic","abstract":[{"text":"A constellation identified from celestial coordinates.","type":"text"}],"title":"Constellation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Constellation","kind":"identifier"}],"navigatorTitle":[{"text":"Constellation","kind":"identifier"}],"role":"symbol"},"https://github.com/cosinekitty/astronomy":{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"title":"Astronomy Engine","url":"https:\/\/github.com\/cosinekitty\/astronomy","type":"link"},"doc://AstronomyKit/documentation/AstronomyKit":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","url":"\/documentation\/astronomykit","kind":"symbol","type":"topic","abstract":[{"text":"Swift bindings for Don Cross’ ","type":"text"},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"text":" library.","type":"text"}],"title":"AstronomyKit","role":"collection"},"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"title":"CelestialBody","url":"\/documentation\/astronomykit\/celestialbody","abstract":[{"type":"text","text":"A celestial body in the solar system."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CelestialBody","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","navigatorTitle":[{"text":"CelestialBody","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/EquatorDate":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatorDate","kind":"identifier"}],"url":"\/documentation\/astronomykit\/equatordate","role":"symbol","abstract":[{"text":"The equinox reference for equatorial coordinates.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"EquatorDate","kind":"identifier"}],"kind":"symbol","title":"EquatorDate","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"},"doc://AstronomyKit/documentation/AstronomyKit/Aberration":{"abstract":[{"text":"Light aberration correction mode.","type":"text"}],"role":"symbol","kind":"symbol","title":"Aberration","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","navigatorTitle":[{"kind":"identifier","text":"Aberration"}],"type":"topic","url":"\/documentation\/astronomykit\/aberration","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Aberration","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","url":"\/documentation\/astronomykit\/observer","kind":"symbol","type":"topic","abstract":[{"text":"A geographic location for observing celestial objects.","type":"text"}],"title":"Observer","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observer"}],"navigatorTitle":[{"kind":"identifier","text":"Observer"}],"role":"symbol"}}}