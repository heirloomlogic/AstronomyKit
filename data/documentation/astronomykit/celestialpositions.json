{"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"AstronomyKit"}],"title":"Celestial Positions","role":"article","roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"title":"Position Calculations","anchor":"Position-Calculations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/celestialpositions"]}],"abstract":[{"text":"Calculate the positions of celestial bodies in various coordinate systems.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit can calculate positions for the Sun, Moon, planets, Jupiter’s moons, and fixed stars. Positions can be expressed in multiple coordinate systems."}]},{"text":"Celestial Bodies","type":"heading","anchor":"Celestial-Bodies","level":2},{"text":"Available Bodies","type":"heading","anchor":"Available-Bodies","level":3},{"type":"codeListing","code":["\/\/ Major bodies","let sun = CelestialBody.sun","let moon = CelestialBody.moon","let mars = CelestialBody.mars","","\/\/ All planets (Mercury through Neptune)","for planet in CelestialBody.planets {","    print(planet.name)","}","","\/\/ Jupiter's Galilean moons","for moon in CelestialBody.galileanMoons {","    print(moon.name)  \/\/ Io, Europa, Ganymede, Callisto","}"],"syntax":"swift"},{"text":"Body Properties","type":"heading","anchor":"Body-Properties","level":3},{"type":"codeListing","code":["let mars = CelestialBody.mars","","print(mars.name)           \/\/ \"Mars\"","print(mars.orbitalPeriod)  \/\/ ~686 days","print(mars.massProduct)    \/\/ Mass × G in AU³\/day²","print(mars.isPlanet)       \/\/ true","print(mars.isNakedEyeVisible)  \/\/ true"],"syntax":"swift"},{"text":"Looking Up Bodies by Name","type":"heading","anchor":"Looking-Up-Bodies-by-Name","level":3},{"type":"codeListing","code":["if let body = CelestialBody(name: \"Jupiter\") {","    print(\"Found: \\(body)\")","}"],"syntax":"swift"},{"text":"Horizon Coordinates","type":"heading","anchor":"Horizon-Coordinates","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where does a body appear in your local sky?"}]},{"type":"codeListing","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Azimuth: \\(mars.azimuth)°\")       \/\/ Compass bearing","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, SE, etc.","","if mars.isAboveHorizon {","    print(\"Mars is visible!\")","}"],"syntax":"swift"},{"text":"Equatorial Coordinates","type":"heading","anchor":"Equatorial-Coordinates","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Right ascension and declination on the celestial sphere:"}]},{"type":"codeListing","code":["let eq = try CelestialBody.saturn.equatorial(at: .now)","","print(\"RA: \\(eq.rightAscension) hours\")","print(\"Dec: \\(eq.declination)°\")","print(\"Distance: \\(eq.distance) AU\")","","\/\/ Formatted output","print(eq.rightAscensionFormatted)   \/\/ \"02h 15m 30.2s\"","print(eq.declinationFormatted)      \/\/ \"+12° 34' 56.7\"\""],"syntax":"swift"},{"text":"Equator Date Options","type":"heading","anchor":"Equator-Date-Options","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the reference equinox:"}]},{"type":"codeListing","code":["\/\/ J2000 coordinates (default) - standard reference epoch","let j2000 = try body.equatorial(at: .now, equatorDate: .j2000)","","\/\/ Coordinates of the observation date - accounts for precession","let ofDate = try body.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"text":"Ecliptic Coordinates","type":"heading","anchor":"Ecliptic-Coordinates","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position relative to the ecliptic plane:"}]},{"type":"codeListing","code":["let longitude = try CelestialBody.venus.eclipticLongitude(at: .now)","print(\"Venus ecliptic longitude: \\(longitude)°\")","","\/\/ Sun's full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"Sun: λ=\\(sunPos.longitude)°, β=\\(sunPos.latitude)°\")"],"syntax":"swift"},{"text":"Position Vectors","type":"heading","anchor":"Position-Vectors","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cartesian coordinates in 3D space:"}]},{"type":"codeListing","code":["\/\/ Geocentric (from Earth's center)","let geo = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"Distance from Earth: \\(geo.magnitude) AU\")","","\/\/ Heliocentric (from Sun's center)","let helio = try CelestialBody.mars.heliocentricPosition(at: .now)","print(\"Distance from Sun: \\(helio.magnitude) AU\")"],"syntax":"swift"},{"text":"Distance Calculations","type":"heading","anchor":"Distance-Calculations","level":2},{"type":"codeListing","code":["\/\/ Distance from Sun","let auFromSun = try CelestialBody.mars.distanceFromSun(at: .now)","print(\"Mars is \\(auFromSun) AU from the Sun\")","","\/\/ Angular separation from Sun","let angle = try CelestialBody.venus.angleFromSun(at: .now)","print(\"Venus is \\(angle)° from the Sun\")"],"syntax":"swift"},{"text":"Constellation Identification","type":"heading","anchor":"Constellation-Identification","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find which constellation contains a body:"}]},{"type":"codeListing","code":["let constellation = try CelestialBody.mars.constellation(at: .now)","print(\"\\(constellation.symbol) - \\(constellation.name)\")","\/\/ Output: \"Tau - Taurus\"","","\/\/ Or from raw coordinates","let orion = try Constellation.find(rightAscension: 5.9195, declination: 7.4071)","print(orion.name)  \/\/ \"Orion\""],"syntax":"swift"},{"text":"Fixed Stars","type":"heading","anchor":"Fixed-Stars","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates using "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ Define Algol (Beta Persei)","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95    \/\/ Light-years",")","","\/\/ Get ecliptic longitude","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Get position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"J2000 coordinates can be found from star catalogs like SIMBAD, Hipparcos, or the Yale Bright Star Catalog."}]},{"text":"Aberration Correction","type":"heading","anchor":"Aberration-Correction","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control light-time and aberration corrections:"}]},{"type":"codeListing","code":["\/\/ With correction (default) - apparent position","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"syntax":"swift"},{"text":"Refraction Correction","type":"heading","anchor":"Refraction-Correction","level":2},{"type":"paragraph","inlineContent":[{"text":"Atmospheric refraction affects horizon coordinates:","type":"text"}]},{"type":"codeListing","code":["\/\/ Normal refraction (default)","let normal = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift"}],"kind":"content"}],"references":{"https://github.com/cosinekitty/astronomy":{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","url":"https:\/\/github.com\/cosinekitty\/astronomy","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"title":"Astronomy Engine","type":"link"},"doc://AstronomyKit/documentation/AstronomyKit":{"url":"\/documentation\/astronomykit","title":"AstronomyKit","type":"topic","abstract":[{"text":"Swift bindings for Don Cross’ ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference"},{"text":" library.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","role":"collection"},"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"kind":"symbol","abstract":[{"text":"A fixed star defined by its J2000 equatorial coordinates.","type":"text"}],"url":"\/documentation\/astronomykit\/fixedstar","navigatorTitle":[{"text":"FixedStar","kind":"identifier"}],"title":"FixedStar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","type":"topic","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"kind":"symbol","abstract":[{"text":"A geographic location for observing celestial objects.","type":"text"}],"url":"\/documentation\/astronomykit\/observer","navigatorTitle":[{"text":"Observer","kind":"identifier"}],"title":"Observer","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observer","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","type":"topic","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Aberration":{"url":"\/documentation\/astronomykit\/aberration","type":"topic","title":"Aberration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Aberration","kind":"identifier"}],"navigatorTitle":[{"text":"Aberration","kind":"identifier"}],"abstract":[{"text":"Light aberration correction mode.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Constellation":{"url":"\/documentation\/astronomykit\/constellation","title":"Constellation","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Constellation"}],"navigatorTitle":[{"kind":"identifier","text":"Constellation"}],"abstract":[{"type":"text","text":"A constellation identified from celestial coordinates."}],"kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"url":"\/documentation\/astronomykit\/celestialbody","title":"CelestialBody","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CelestialBody"}],"navigatorTitle":[{"kind":"identifier","text":"CelestialBody"}],"abstract":[{"text":"A celestial body in the solar system.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/CoordinateSystems":{"url":"\/documentation\/astronomykit\/coordinatesystems","type":"topic","title":"Coordinate Systems","abstract":[{"text":"Transform positions between different astronomical coordinate systems.","type":"text"}],"kind":"article","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems","role":"article"},"doc://AstronomyKit/documentation/AstronomyKit/EquatorDate":{"kind":"symbol","abstract":[{"text":"The equinox reference for equatorial coordinates.","type":"text"}],"url":"\/documentation\/astronomykit\/equatordate","navigatorTitle":[{"text":"EquatorDate","kind":"identifier"}],"title":"EquatorDate","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatorDate","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate","type":"topic","role":"symbol"}}}