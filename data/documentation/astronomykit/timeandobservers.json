{"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted"],"generated":true,"anchor":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/timeandobservers"]}],"kind":"article","identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers","interfaceLanguage":"swift"},"sections":[],"metadata":{"title":"Time and Observers","modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"Work with astronomical time and geographic observer locations."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Accurate time handling is fundamental to astronomy. AstronomyKit provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","type":"reference"},{"text":" for precise time representation and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","type":"reference"},{"text":" for geographic locations.","type":"text"}]},{"level":2,"type":"heading","anchor":"Working-with-Time","text":"Working with Time"},{"level":3,"type":"heading","anchor":"Creating-Times","text":"Creating Times"},{"type":"codeListing","code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From calendar components (in UTC)","let eclipse = AstroTime(year: 2024, month: 4, day: 8, hour: 18, minute: 15)","","\/\/ From Foundation Date","let time = AstroTime(Date())","","\/\/ From Julian days since J2000","let jd = AstroTime(ut: 9132.5)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Time-Arithmetic","text":"Time Arithmetic"},{"type":"codeListing","code":["let now = AstroTime.now","","\/\/ Add days or hours","let tomorrow = now.addingDays(1)","let nextHour = now.addingHours(1)","let lastWeek = now.addingDays(-7)","","\/\/ Compare times","if tomorrow > now {","    print(\"Tomorrow comes after now\")","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Converting-to-Date","text":"Converting to Date"},{"type":"codeListing","code":["let time = AstroTime.now","let date: Date = time.date","","\/\/ Format for display","let formatter = DateFormatter()","formatter.dateStyle = .medium","formatter.timeStyle = .short","print(formatter.string(from: time.date))"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Understanding-UT-vs-TT","text":"Understanding UT vs TT"},{"type":"paragraph","inlineContent":[{"text":"AstroTime stores two time values internally:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Universal Time (UT)","type":"text"}],"type":"strong"},{"text":": Based on Earth’s rotation, used for rise\/set times","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Terrestrial Time (TT)","type":"text"}],"type":"strong"},{"text":": Uniform time scale, used for planetary orbits","type":"text"}]}]}]},{"type":"codeListing","code":["let time = AstroTime.now","print(\"UT: \\(time.universalTime)\")  \/\/ Days since J2000 noon (UTC)","print(\"TT: \\(time.terrestrialTime)\")  \/\/ Days since J2000 noon (TT)","","\/\/ Create from Terrestrial Time directly","let fromTT = AstroTime(tt: 9132.5)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The difference (ΔT) is automatically handled by AstronomyKit.","type":"text"}]},{"level":3,"type":"heading","anchor":"Accepted-Range","text":"Accepted Range"},{"type":"paragraph","inlineContent":[{"text":"Positions, states, distances, and the searches built on them accept a Terrestrial Time within 4,000 Julian years of J2000: ","type":"text"},{"code":"abs(time.terrestrialTime) <= 1_461_000","type":"codeVoice"},{"text":" days, roughly the years −2000 to +6000. That is about the span over which the VSOP87 planetary theory claims validity. Outside it, and for a non-finite time, they throw ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/badTime","type":"reference"},{"text":". Pluto accepts a narrower span, about the years −100 to +4100.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A calculation that samples nearby times can throw within a short distance of either edge: light-travel correction looks back up to a few hours, the Moon’s state vectors sample about a second either side, and searches step by days to years, sometimes backward before stepping forward. Creating an ","type":"text"},{"code":"AstroTime","type":"codeVoice"},{"text":" outside the range is not an error; only the calculations reject it.","type":"text"}]},{"level":3,"type":"heading","anchor":"Delta-T-Configuration","text":"Delta T Configuration"},{"type":"paragraph","inlineContent":[{"text":"The difference between TT and UT (called ΔT) varies over time and is estimated using a model. AstronomyKit defaults to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/observed","type":"reference"},{"text":", a yearly table of IERS Earth-rotation values that is extrapolated beyond its last entry. You can switch to Espenak-Meeus or, for compatibility, JPL Horizons:","type":"text"}]},{"type":"codeListing","code":["\/\/ Switch to JPL Horizons Delta T model","AstronomyConfig.setDeltaTModel(.jplHorizons)","","\/\/ Query Delta T for a specific time","let deltaT = AstronomyConfig.deltaTObserved(universalTime: 0)  \/\/ Seconds at J2000","","\/\/ Restore the default","AstronomyConfig.setDeltaTModel(.observed)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Sidereal-Time","text":"Sidereal Time"},{"type":"paragraph","inlineContent":[{"text":"Get the sidereal time at the prime meridian:","type":"text"}]},{"type":"codeListing","code":["let sidereal = AstroTime.now.siderealTime","print(\"Greenwich Sidereal Time: \\(sidereal) hours\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Calculate local sidereal time for any longitude:","type":"text"}]},{"type":"codeListing","code":["let observer = Observer(latitude: 40.7, longitude: -74.0)  \/\/ NYC","let lst = AstroTime.now.siderealTime(longitude: observer.longitude)","print(\"Local Sidereal Time: \\(lst) hours\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The result is in 0 up to, but not including, 24 hours for any finite longitude. An infinite or NaN longitude returns ","type":"text"},{"code":".nan","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Working-with-Observers","text":"Working with Observers"},{"level":3,"type":"heading","anchor":"Creating-Observers","text":"Creating Observers"},{"type":"codeListing","code":["\/\/ Basic location (sea level)","let seattle = Observer(latitude: 47.6062, longitude: -122.3321)","","\/\/ With height above sea level (meters)","let everest = Observer(","    latitude: 27.9881,","    longitude: 86.9250,","    height: 8848.86",")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Coordinate-Conventions","text":"Coordinate Conventions"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Latitude","type":"text"}],"type":"strong"},{"text":": -90° (south) to +90° (north)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Longitude","type":"text"}],"type":"strong"},{"text":": -180° (west) to +180° (east)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Height","type":"text"}],"type":"strong"},{"text":": Meters above sea level","type":"text"}]}]}]},{"level":3,"type":"heading","anchor":"Built-in-Locations","text":"Built-in Locations"},{"type":"codeListing","code":["let greenwich = Observer.greenwich       \/\/ Royal Observatory","let primeMeridian = Observer.primeMeridian  \/\/ 0°, 0°"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Observer-Properties","text":"Observer Properties"},{"type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -105.0, height: 1600)","","\/\/ Local gravity (accounts for latitude and altitude)","let gravity = observer.gravity  \/\/ m\/s²","","\/\/ Atmospheric conditions at this elevation","let atmosphere = try observer.atmosphere","print(\"Pressure: \\(atmosphere.pressure) mbar\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Observer-Vectors","text":"Observer Vectors"},{"type":"paragraph","inlineContent":[{"text":"Get the observer’s position relative to Earth’s center:","type":"text"}]},{"type":"codeListing","code":["let observer = Observer.greenwich","","\/\/ Position vector in AU","let position = try observer.vector(at: .now)","","\/\/ Full state (position and velocity)","let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Time-Zones","text":"Time Zones"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit works entirely in UTC. Convert to local time using Foundation:","type":"text"}]},{"type":"codeListing","code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise (local): \\(formatter.string(from: sunrise.date))\")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Codable-Support","text":"Codable Support"},{"type":"paragraph","inlineContent":[{"text":"Both types support ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" for persistence:","type":"text"}]},{"type":"codeListing","code":["let observer = Observer(latitude: 40.7, longitude: -74.0)","let data = try JSONEncoder().encode(observer)","","let time = AstroTime.now","let timeData = try JSONEncoder().encode(time)"],"syntax":"swift"}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/GettingStarted":{"url":"\/documentation\/astronomykit\/gettingstarted","kind":"article","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted","title":"Getting Started with AstronomyKit","abstract":[{"type":"text","text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations."}],"role":"article","type":"topic"},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observer"}],"navigatorTitle":[{"text":"Observer","kind":"identifier"}],"role":"symbol","title":"Observer","url":"\/documentation\/astronomykit\/observer","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","kind":"symbol","type":"topic","abstract":[{"text":"A geographic location for observing celestial objects.","type":"text"}]},"doc://AstronomyKit/documentation/AstronomyKit/AstroTime":{"abstract":[{"type":"text","text":"Represents a moment in time for astronomical calculations."}],"url":"\/documentation\/astronomykit\/astrotime","title":"AstroTime","kind":"symbol","type":"topic","navigatorTitle":[{"text":"AstroTime","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstroTime","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime"},"https://github.com/cosinekitty/astronomy":{"type":"link","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"title":"Astronomy Engine","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","url":"https:\/\/github.com\/cosinekitt