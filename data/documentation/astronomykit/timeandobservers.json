{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit uses "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","isActive":true},{"type":"text","text":" for time and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer"},{"text":" for geographic locations.","type":"text"}]},{"anchor":"Working-with-Time","level":2,"text":"Working with Time","type":"heading"},{"anchor":"Creating-Times","level":3,"text":"Creating Times","type":"heading"},{"type":"codeListing","code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From calendar components (in UTC)","let eclipse = AstroTime(year: 2024, month: 4, day: 8, hour: 18, minute: 15)","","\/\/ From Foundation Date","let time = AstroTime(Date())","","\/\/ From UT1 days since J2000 noon","let ut = AstroTime(ut: 9132.5)"],"syntax":"swift"},{"anchor":"Time-Arithmetic","level":3,"text":"Time Arithmetic","type":"heading"},{"type":"codeListing","syntax":"swift","code":["let now = AstroTime.now","","\/\/ Add days or hours","let tomorrow = now.addingDays(1)","let nextHour = now.addingHours(1)","let lastWeek = now.addingDays(-7)","","\/\/ Compare times","if tomorrow > now {","    print(\"Tomorrow comes after now\")","}"]},{"text":"Converting to Date","type":"heading","anchor":"Converting-to-Date","level":3},{"syntax":"swift","type":"codeListing","code":["let time = AstroTime.now","let date: Date = time.date","","\/\/ Format for display","let formatter = DateFormatter()","formatter.dateStyle = .medium","formatter.timeStyle = .short","print(formatter.string(from: time.date))"]},{"type":"heading","text":"Understanding UT vs TT","anchor":"Understanding-UT-vs-TT","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstroTime stores two time values internally. Universal Time (UT1) follows Earth’s rotation and drives rise and set times. Terrestrial Time (TT) is the uniform scale used for planetary orbits."}]},{"code":["let time = AstroTime.now","print(\"UT: \\(time.universalTime)\")  \/\/ Days since J2000 noon (UT1)","print(\"TT: \\(time.terrestrialTime)\")  \/\/ Days since J2000 noon (TT)","","\/\/ Create from Terrestrial Time directly","let fromTT = AstroTime(tt: 9132.5)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit applies the difference (ΔT) for you.","type":"text"}]},{"text":"Delta T Configuration","level":3,"type":"heading","anchor":"Delta-T-Configuration"},{"type":"paragraph","inlineContent":[{"text":"The difference between TT and UT (ΔT) varies over time and comes from a model. AstronomyKit defaults to the Espenak-Meeus model. Set the model once at startup, before any other AstronomyKit call, if you want a different one:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Switch to the JPL Horizons Delta T model","AstronomyConfig.setDeltaTModel(.jplHorizons)","","\/\/ Query Delta T for a specific time","let deltaT = AstronomyConfig.deltaTEspenakMeeus(universalTime: 0)  \/\/ Seconds at J2000","","\/\/ Back to the default model","AstronomyConfig.setDeltaTModel(.espenakMeeus)"]},{"type":"paragraph","inlineContent":[{"code":"AstronomyConfig.reset()","type":"codeVoice"},{"text":" does not touch the Delta T model. It only frees the Pluto orbit cache.","type":"text"}]},{"level":3,"text":"Sidereal Time","anchor":"Sidereal-Time","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get the sidereal time at the prime meridian:"}]},{"code":["let sidereal = AstroTime.now.siderealTime","print(\"Greenwich Sidereal Time: \\(sidereal) hours\")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Calculate local sidereal time for any longitude:","type":"text"}]},{"code":["let observer = Observer(latitude: 40.7, longitude: -74.0)  \/\/ NYC","let lst = AstroTime.now.siderealTime(longitude: observer.longitude)","print(\"Local Sidereal Time: \\(lst) hours\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Working with Observers","anchor":"Working-with-Observers","type":"heading"},{"level":3,"text":"Creating Observers","anchor":"Creating-Observers","type":"heading"},{"code":["\/\/ Basic location (sea level)","let seattle = Observer(latitude: 47.6062, longitude: -122.3321)","","\/\/ With height above sea level (meters)","let everest = Observer(","    latitude: 27.9881,","    longitude: 86.9250,","    height: 8848.86",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Coordinate Conventions","anchor":"Coordinate-Conventions"},{"items":[{"content":[{"inlineContent":[{"text":"Latitude: -90° (south) to +90° (north)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Longitude: -180° (west) to +180° (east)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Height: meters above sea level","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","text":"Built-in Locations","anchor":"Built-in-Locations"},{"type":"codeListing","code":["let greenwich = Observer.greenwich       \/\/ Royal Observatory","let primeMeridian = Observer.primeMeridian  \/\/ 0°, 0°"],"syntax":"swift"},{"level":3,"anchor":"Observer-Properties","type":"heading","text":"Observer Properties"},{"type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -105.0, height: 1600)","","\/\/ Local gravity (accounts for latitude and altitude)","let gravity = observer.gravity  \/\/ m\/s²","","\/\/ Atmospheric conditions at this elevation","let atmosphere = try observer.atmosphere","print(\"Pressure: \\(atmosphere.pressure) mbar\")"],"syntax":"swift"},{"level":3,"anchor":"Observer-Vectors","type":"heading","text":"Observer Vectors"},{"type":"paragraph","inlineContent":[{"text":"Get the observer’s position relative to Earth’s center:","type":"text"}]},{"code":["let observer = Observer.greenwich","","\/\/ Position vector in AU","let position = try observer.vector(at: .now)","","\/\/ Full state (position and velocity)","let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Time Zones","anchor":"Time-Zones","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit works entirely in UTC. Convert to local time using Foundation:","type":"text"}]},{"code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise (local): \\(formatter.string(from: sunrise.date))\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Codable Support","anchor":"Codable-Support","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Both types support ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" for persistence:","type":"text"}]},{"code":["let observer = Observer(latitude: 40.7, longitude: -74.0)","let data = try JSONEncoder().encode(observer)","","let time = AstroTime.now","let timeData = try JSONEncoder().encode(time)"],"syntax":"swift","type":"codeListing"},{"text":"Civil time and numerical compatibility","level":2,"type":"heading","anchor":"Civil-time-and-numerical-compatibility"},{"type":"paragraph","inlineContent":[{"code":"AstroTime(Date)","type":"codeVoice"},{"text":", calendar components and ","type":"text"},{"type":"codeVoice","code":".now"},{"text":" use civil UTC. From 1961 onward, a bundled USNO table converts UTC to TT, including the rate adjustments before 1972. Future dates retain the last announced leap-second offset. Before 1961, civil dates use the engine’s historical UT1 proxy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"universalTime","type":"codeVoice"},{"type":"text","text":" and "},{"code":"init(ut:)","type":"codeVoice"},{"type":"text","text":" are modeled UT1 coordinates, not UTC timestamps. "},{"code":"terrestrialTime","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(tt:)"},{"type":"text","text":" are TT. Native search results already carry both scales; their "},{"type":"codeVoice","code":".date"},{"type":"text","text":" uses the same civil inverse as every other time. "},{"type":"codeVoice","code":"addingDays"},{"type":"text","text":" and "},{"type":"codeVoice","code":"addingHours"},{"type":"text","text":" add UT1 coordinate intervals. For civil calendar arithmetic, use Foundation and construct a new "},{"type":"codeVoice","code":"AstroTime"},{"type":"text","text":" from the resulting date."}]},{"inlineContent":[{"type":"text","text":"Foundation cannot represent leap seconds. TT instants in positive UTC gaps map to the next transition; negative historical steps choose the later civil occurrence. Those instants cannot round-trip through "},{"type":"codeVoice","code":"Date"},{"type":"text","text":". Positive gaps in the selected Delta T model similarly map TT to the first UT1 coordinate after the jump. At negative overlaps, fixed-point iteration returns the first solution reached from its initial "},{"type":"codeVoice","code":"ut = tt"},{"type":"text","text":" estimate. TT remains exact in memory, but numeric Codable remains UT1-based, so decoding a gap-clamped value derives TT again from the selected model. The table’s future convention and the modeled UT1 values do not establish future UTC or Earth-orientation accuracy. Review serialized times and invalidate version-dependent cached calculations when upgrading."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"},"seeAlsoSections":[{"anchor":"Essentials","generated":true,"title":"Essentials","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted"]}],"abstract":[{"type":"text","text":"Work with astronomical time and geographic observer locations."}],"kind":"article","variants":[{"paths":["\/documentation\/astronomykit\/timeandobservers"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","title":"Time and Observers","role":"article"},"references":{"doc://AstronomyKit/documentation/AstronomyKit/GettingStarted":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted","url":"\/documentation\/astronomykit\/gettingstarted","kind":"article","type":"topic","abstract":[{"text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations.","type":"text"}],"title":"Getting Started with AstronomyKit","role":"article"},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","url":"\/documentation\/astronomykit\/observer","kind":"symbol","type":"topic","abstract":[{"text":"A geographic location for observing celestial objects.","type":"text"}],"title":"Observer","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Observer"}],"navigatorTitle":[{"kind":"identifier","text":"Observer"}],"role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","url":"\/documentation\/astronomykit","kind":"symbol","type":"topic","abstract":[{"text":"Swift bindings for Don Cross’ ","type":"text"},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"text":" library.","type":"text"}],"title":"AstronomyKit","role":"collection"},"https://github.com/cosinekitty/astronomy":{"type":"link","titleInlineContent":[{"text":"Astronomy Engine","type":"text"}],"url":"https:\/\/github.com\/cosinekitty\/astronomy","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine"},"doc://AstronomyKit/documentation/AstronomyKit/AstroTime":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AstroTime"}],"url":"\/documentation\/astronomykit\/astrotime","role":"symbol","abstract":[{"type":"text","text":"Represents a moment in time for astronomical calculations."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"AstroTime"}],"title":"AstroTime","kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime"}}}