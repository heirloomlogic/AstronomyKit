{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted"],"title":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit uses "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","isActive":true,"type":"reference"},{"type":"text","text":" for time and "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","isActive":true,"type":"reference"},{"type":"text","text":" for geographic locations."}]},{"level":2,"type":"heading","anchor":"Working-with-Time","text":"Working with Time"},{"level":3,"type":"heading","anchor":"Creating-Times","text":"Creating Times"},{"type":"codeListing","code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From calendar components (in UTC)","let eclipse = AstroTime(year: 2024, month: 4, day: 8, hour: 18, minute: 15)","","\/\/ From Foundation Date","let time = AstroTime(Date())","","\/\/ From UT1 days since J2000 noon","let ut = AstroTime(ut: 9132.5)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Time-Arithmetic","text":"Time Arithmetic"},{"type":"codeListing","code":["let now = AstroTime.now","","\/\/ Add days or hours","let tomorrow = now.addingDays(1)","let nextHour = now.addingHours(1)","let lastWeek = now.addingDays(-7)","","\/\/ Compare times","if tomorrow > now {","    print(\"Tomorrow comes after now\")","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Converting-to-Date","text":"Converting to Date"},{"type":"codeListing","code":["let time = AstroTime.now","let date: Date = time.date","","\/\/ Format for display","let formatter = DateFormatter()","formatter.dateStyle = .medium","formatter.timeStyle = .short","print(formatter.string(from: time.date))"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Understanding-UT-vs-TT","text":"Understanding UT vs TT"},{"inlineContent":[{"type":"text","text":"AstroTime stores two time values internally. Universal Time (UT1) follows Earth’s rotation and drives rise and set times. Terrestrial Time (TT) is the uniform scale used for planetary orbits."}],"type":"paragraph"},{"code":["let time = AstroTime.now","print(\"UT: \\(time.universalTime)\")  \/\/ Days since J2000 noon (UT1)","print(\"TT: \\(time.terrestrialTime)\")  \/\/ Days since J2000 noon (TT)","","\/\/ Create from Terrestrial Time directly","let fromTT = AstroTime(tt: 9132.5)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit applies the difference (ΔT) for you."}]},{"anchor":"Delta-T-Configuration","level":3,"type":"heading","text":"Delta T Configuration"},{"type":"paragraph","inlineContent":[{"text":"The difference between TT and UT1 (ΔT) follows Earth’s rotation, which is observed, not predicted by theory. A civil ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","type":"reference"},{"text":" takes TT exactly from the leap-second table and recovers UT1 by inverting the selected ΔT model, so the model sets Earth’s rotation angle, hour angles, azimuths, house cusps and rise and set times for every civil instant. A ΔT error of 1 s turns Earth by 15″ and moves rise and set by about a second.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit defaults to "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/iersObserved","isActive":true,"type":"reference"},{"type":"text","text":". No call is needed to use it. It draws on four sources, joined so that ΔT is continuous:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Regime"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Span"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Source"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"ΔT"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/extrapolatedPast"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"before −720"}]}],[{"inlineContent":[{"type":"text","text":"HMNAO long-term length-of-day model"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"integral of lod = 1.72 t − 3.5 sin(2π(t + 0.75)\/14) ms, t in centuries from 1825.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/historical","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"−720 to 1962-01-01"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Morrison, Stephenson, Hohenkerk and Zawilski (2021), Table S15 v2020"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"cubic spline fitted to eclipse and occultation timings, continuous in value and rate"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/observed","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"1962-01-01 to the last observation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IERS EOP 20 C04, then IERS Bulletin A rapid values"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"(TAI − UTC) + 32.184 s − (UT1 − UTC), daily at 0h UTC"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/predicted","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"about a year further"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IERS Bulletin A predictions"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"as observed"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/extrapolatedFuture","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"after the last prediction"}],"type":"paragraph"}],[{"inlineContent":[{"text":"HMNAO long-term length-of-day model","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"as before −720"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Between the daily rows ΔT is linear in UT1. Against the IERS C04 series sampled at 12h, linear interpolation is off by at most 0.16 ms (rms 0.019 ms, 1984–2026), far below a millisecond of Earth rotation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The spline is the 2020 addendum to Stephenson, Morrison and Hohenkerk (2016), as published by HM Nautical Almanac Office. HMNAO publishes it as cubic polynomials rounded to 1 ms, so at a knot the two neighbouring segments disagree by up to 1 ms in value and 1.1e-6 s per day in rate. A jump that size is physically negligible but shows up in numerical derivatives taken across the knot. AstronomyKit therefore rebuilds each segment as the cubic Hermite curve through the mean of the two one-sided values and rates at its knots. The rebuilt spline is continuous in value and rate at every knot and stays within 0.65 ms of the published polynomials. The spline departs from the IERS series by up to 0.68 s over 1962–2019. At 1962.0 it is 0.376 s below the first IERS value and 0.9 ms per day slower, so the 1959–1962 segment ends on the first C04 value and the rate of the first C04 day instead, and ΔT stays continuous in value and rate across 1962. Beyond the spline and the predictions, the long-term model is the one HMNAO uses to extrapolate the spline to −2000 and 2500: tidal deceleration of 1.72 ms per century with a 1400-year fluctuation. Its integration constant is fixed by the value at the join, so ΔT is continuous there. Its rate, the excess length of day, is not matched there: after the last prediction the model’s 0.17 ms replaces the last predicted day’s 0.03 ms, and at −720 the model’s −47.3 ms replaces the spline’s −44.2 ms (HMNAO tabulates −44.2 ms there). Matching it would mean inventing a transition that no source describes. Inside the daily table the rate also steps at each row, by the day-to-day change in length of day (median 0.1 ms, largest 1.9 ms at the start of 1984), because the interpolation is linear. Swiss Ephemeris since version 2.06 extrapolates the future with a cubic its source attributes to the same HMNAO data; it gives about 107 s for 2126."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The extrapolations are estimates, not observations. HMNAO gives 80 ± 10 s for 2100 and 160 ± 20 s for 2200, and decade-scale fluctuations in Earth’s rotation can move them. The Espenak–Meeus model, by comparison, gives 203 s for 2100."}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"UT"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/iersObserved"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/espenakMeeus"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/jplHorizons"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"2026.8 (predicted)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"69.22 s"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"75.55 s"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"69.99 s"}]}]],[[{"inlineContent":[{"type":"text","text":"2050.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"71.9 s"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"93.0 s"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"69.99 s"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"2126.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"100.9 s"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"266.0 s"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"69.99 s"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedUncertainty(universalTime:)"},{"type":"text","text":" gives a stated, sourced uncertainty for the default model. It is a figure of about one standard error, not a proved bound, and the sources do not all state a confidence level:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Observed: the row’s published UT1 − UTC error (C04’s formal error, then Bulletin A’s), plus up to 0.16 ms of interpolation at midday. About 2 ms in 1962 and 0.02 ms today.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Predicted: Bulletin A’s stated error for each day, 0.6 ms a day ahead and 24 ms a year ahead.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Historical: HMNAO’s error estimate, 180 s at −720 and 15 s from 1000 to 1600, never less than the spline’s 0.68 s departure from IERS.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Extrapolated: HMNAO’s estimate for its extrapolation, 2 s at 2030, 10 s at 2100, 100 s at 2500, and 0.3 h at −2000. Before −2000 and after 2500 no figure is published, so the estimate grows with the square of the time from 1825.0.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedRegime(universalTime:)"},{"type":"text","text":" reports the regime. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/ephemerisVersion"},{"type":"text","text":" names the table’s last observation and last prediction; a new table is a new version."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two models upstream Astronomy Engine provides remain available for comparison with tools built on them. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/espenakMeeus"},{"type":"text","text":" is upstream’s default; from 2005 it extrapolates a ΔT that runs about 6.3 s above observed UT1 in 2026. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/jplHorizons"},{"type":"text","text":" is Espenak–Meeus held at its 2017.0 value. Set the model once at startup, before any other AstronomyKit call:"}]},{"code":["\/\/ Compare with a tool that uses the Espenak-Meeus polynomials","AstronomyConfig.setDeltaTModel(.espenakMeeus)","","\/\/ Query Delta T and its stated uncertainty for a specific UT1 (days since J2000)","let deltaT = AstronomyConfig.deltaTIersObserved(universalTime: 9_800)","let sigma = AstronomyConfig.deltaTIersObservedUncertainty(universalTime: 9_800)","","\/\/ Back to the default model","AstronomyConfig.setDeltaTModel(.iersObserved)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AstronomyConfig.reset()"},{"type":"text","text":" does not touch the Delta T model. It only frees the Pluto orbit cache."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Polar motion and the celestial pole offsets dX and dY, which the same IERS series carry, are not applied."}]},{"anchor":"Sidereal-Time","level":3,"type":"heading","text":"Sidereal Time"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get the sidereal time at the prime meridian:"}]},{"code":["let sidereal = AstroTime.now.siderealTime","print(\"Greenwich Sidereal Time: \\(sidereal) hours\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate local sidereal time for any longitude:"}]},{"code":["let observer = Observer(latitude: 40.7, longitude: -74.0)  \/\/ NYC","let lst = AstroTime.now.siderealTime(longitude: observer.longitude)","print(\"Local Sidereal Time: \\(lst) hours\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Working-with-Observers","level":2,"type":"heading","text":"Working with Observers"},{"anchor":"Creating-Observers","level":3,"type":"heading","text":"Creating Observers"},{"code":["\/\/ Basic location (sea level)","let seattle = Observer(latitude: 47.6062, longitude: -122.3321)","","\/\/ With height above sea level (meters)","let everest = Observer(","    latitude: 27.9881,","    longitude: 86.9250,","    height: 8848.86",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Coordinate-Conventions","level":3,"type":"heading","text":"Coordinate Conventions"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Latitude: -90° (south) to +90° (north)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Longitude: -180° (west) to +180° (east)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Height: meters above sea level","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Built-in-Locations","level":3,"type":"heading","text":"Built-in Locations"},{"code":["let greenwich = Observer.greenwich       \/\/ Royal Observatory","let primeMeridian = Observer.primeMeridian  \/\/ 0°, 0°"],"type":"codeListing","syntax":"swift"},{"anchor":"Observer-Properties","level":3,"type":"heading","text":"Observer Properties"},{"code":["let observer = Observer(latitude: 40.0, longitude: -105.0, height: 1600)","","\/\/ Local gravity (accounts for latitude and altitude)","let gravity = observer.gravity  \/\/ m\/s²","","\/\/ Atmospheric conditions at this elevation","let atmosphere = try observer.atmosphere","print(\"Pressure: \\(atmosphere.pressure) mbar\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Observer-Vectors","level":3,"type":"heading","text":"Observer Vectors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get the observer’s position relative to Earth’s center:"}]},{"code":["let observer = Observer.greenwich","","\/\/ Position vector in AU","let position = try observer.vector(at: .now)","","\/\/ Full state (position and velocity)","let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Time-Zones","level":2,"type":"heading","text":"Time Zones"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit works entirely in UTC. Convert to local time using Foundation:"}]},{"code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise (local): \\(formatter.string(from: sunrise.date))\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Codable-Support","level":2,"type":"heading","text":"Codable Support"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both types support "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" for persistence:"}]},{"code":["let observer = Observer(latitude: 40.7, longitude: -74.0)","let data = try JSONEncoder().encode(observer)","","let time = AstroTime.now","let timeData = try JSONEncoder().encode(time)"],"type":"codeListing","syntax":"swift"},{"anchor":"Civil-time-and-numerical-compatibility","level":2,"type":"heading","text":"Civil time and numerical compatibility"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AstroTime(Date)"},{"type":"text","text":", calendar components and "},{"type":"codeVoice","code":".now"},{"type":"text","text":" use civil UTC. From 1961 onward, a bundled USNO table converts UTC to TT, including the rate adjustments before 1972. Future dates retain the last announced leap-second offset. Before 1961, civil dates use the engine’s historical UT1 proxy."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"universalTime"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(ut:)"},{"type":"text","text":" are UT1 coordinates from the selected Delta T model, not UTC timestamps. "},{"type":"codeVoice","code":"terrestrialTime"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(tt:)"},{"type":"text","text":" are TT. Native search results already carry both scales; their "},{"type":"codeVoice","code":".date"},{"type":"text","text":" uses the same civil inverse as every other time. "},{"type":"codeVoice","code":"addingDays"},{"type":"text","text":" and "},{"type":"codeVoice","code":"addingHours"},{"type":"text","text":" add UT1 coordinate intervals. For civil calendar arithmetic, use Foundation and construct a new "},{"type":"codeVoice","code":"AstroTime"},{"type":"text","text":" from the resulting date."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation cannot represent leap seconds. TT instants in positive UTC gaps map to the next transition; negative historical steps choose the later civil occurrence. Those instants cannot round-trip through "},{"type":"codeVoice","code":"Date"},{"type":"text","text":". The default Delta T model is continuous. In a model with positive gaps, such as Espenak–Meeus at its 1986 join, TT maps to the first UT1 coordinate after the jump. At negative overlaps, fixed-point iteration returns the first solution reached from its initial "},{"type":"codeVoice","code":"ut = tt"},{"type":"text","text":" estimate. TT remains exact in memory, but numeric Codable remains UT1-based, so decoding a gap-clamped value derives TT again from the selected model. The table’s future convention and the predicted and extrapolated UT1 values do not establish future UTC or Earth-orientation accuracy. Review serialized times and invalidate version-dependent cached calculations when upgrading."}]}]}],"abstract":[{"type":"text","text":"Work with astronomical time and geographic observer locations."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/timeandobservers"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"metadata":{"title":"Time and Observers","modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","role":"article"},"references":{"doc://AstronomyKit/documentation/AstronomyKit/DeltaTRegime/observed":{"url":"\/documentation\/astronomykit\/deltatregime\/observed","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"observed"}],"type":"topic","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/observed","abstract":[{"type":"text","text":"IERS EOP 20 C04, then IERS Bulletin A rapid determinations."}],"title":"DeltaTRegime.observed"},"doc://AstronomyKit/documentation/AstronomyKit/DeltaTRegime/extrapolatedFuture":{"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTRegime\/extrapolatedFuture","kind":"symbol","title":"DeltaTRegime.extrapolatedFuture","abstract":[{"type":"text","text":"After the last prediction: HMNAO’s long-term length-of-day model,"},{"type":"text","text":" "},{"type":"text","text":"continuous with the last prediction."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"extrapolatedFuture"}],"role":"symbol","url":"\/documentation\/astronomykit\/deltatregime\/extrapolatedfuture"},"doc://AstronomyKit/documentation/AstronomyKit/AstronomyConfig/deltaTIersObservedUncertainty(universalTime:)":{"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedUncertainty(universalTime:)","kind":"symbol","title":"deltaTIersObservedUncertainty(universalTime:)","abstract":[{"type":"text","text":"The stated uncertainty of "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObserved(universalTime:)","type":"reference","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deltaTIersObservedUncertainty"},{"kind":"text","text":"("},{"kind":"externalParam","text":"universalTime"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"role":"symbol","url":"\/documentation\/astronomykit\/astronomyconfig\/deltatiersobserveduncertainty(universaltime:)"},"doc://AstronomyKit/documentation/AstronomyKit/AstronomyConfig/deltaTIersObservedRegime(universalTime:)":{"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedRegime(universalTime:)","kind":"symbol","title":"deltaTIersObservedRegime(universalTime:)","abstract":[{"type":"text","text":"The source "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObserved(universalTime:)","type":"reference","isActive":true},{"type":"text","text":" draws on at a time."}],"fragments":[{"kind":"keyw