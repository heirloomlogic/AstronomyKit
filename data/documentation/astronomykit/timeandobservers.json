{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Accurate time handling is fundamental to astronomy. AstronomyKit provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime"},{"type":"text","text":" for precise time representation and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer"},{"type":"text","text":" for geographic locations."}],"type":"paragraph"},{"text":"Working with Time","level":2,"anchor":"Working-with-Time","type":"heading"},{"text":"Creating Times","level":3,"anchor":"Creating-Times","type":"heading"},{"code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From calendar components (in UTC)","let eclipse = AstroTime(year: 2024, month: 4, day: 8, hour: 18, minute: 15)","","\/\/ From Foundation Date","let time = AstroTime(Date())","","\/\/ From Julian days since J2000","let jd = AstroTime(ut: 9132.5)"],"syntax":"swift","type":"codeListing"},{"text":"Time Arithmetic","level":3,"anchor":"Time-Arithmetic","type":"heading"},{"code":["let now = AstroTime.now","","\/\/ Add days or hours","let tomorrow = now.addingDays(1)","let nextHour = now.addingHours(1)","let lastWeek = now.addingDays(-7)","","\/\/ Compare times","if tomorrow > now {","    print(\"Tomorrow comes after now\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Converting to Date","level":3,"anchor":"Converting-to-Date","type":"heading"},{"code":["let time = AstroTime.now","let date: Date = time.date","","\/\/ Format for display","let formatter = DateFormatter()","formatter.dateStyle = .medium","formatter.timeStyle = .short","print(formatter.string(from: time.date))"],"syntax":"swift","type":"codeListing"},{"text":"Understanding UT vs TT","level":3,"anchor":"Understanding-UT-vs-TT","type":"heading"},{"inlineContent":[{"type":"text","text":"AstroTime stores two time values internally:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Universal Time (UT)"}]},{"type":"text","text":": Based on Earth’s rotation, used for rise\/set times"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terrestrial Time (TT)"}]},{"type":"text","text":": Uniform time scale, used for planetary orbits"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["let time = AstroTime.now","print(\"UT: \\(time.universalTime)\")  \/\/ Days since J2000 noon (UTC)","print(\"TT: \\(time.terrestrialTime)\")  \/\/ Days since J2000 noon (TT)","","\/\/ Create from Terrestrial Time directly","let fromTT = AstroTime(tt: 9132.5)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The difference (ΔT) is automatically handled by AstronomyKit."}],"type":"paragraph"},{"text":"Delta T Configuration","level":3,"anchor":"Delta-T-Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"The difference between TT and UT (called ΔT) varies over time and is estimated"},{"type":"text","text":" "},{"type":"text","text":"using a model. AstronomyKit defaults to the Espenak-Meeus model, but you can"},{"type":"text","text":" "},{"type":"text","text":"switch to JPL Horizons for compatibility:"}],"type":"paragraph"},{"code":["\/\/ Switch to JPL Horizons Delta T model","AstronomyConfig.setDeltaTModel(.jplHorizons)","","\/\/ Query Delta T for a specific time","let deltaT = AstronomyConfig.deltaTEspenakMeeus(universalTime: 0)  \/\/ Seconds at J2000","","\/\/ Reset to defaults","AstronomyConfig.reset()"],"syntax":"swift","type":"codeListing"},{"text":"Sidereal Time","level":3,"anchor":"Sidereal-Time","type":"heading"},{"inlineContent":[{"type":"text","text":"Get the sidereal time at the prime meridian:"}],"type":"paragraph"},{"code":["let sidereal = AstroTime.now.siderealTime","print(\"Greenwich Sidereal Time: \\(sidereal) hours\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Calculate local sidereal time for any longitude:"}],"type":"paragraph"},{"code":["let observer = Observer(latitude: 40.7, longitude: -74.0)  \/\/ NYC","let lst = AstroTime.now.siderealTime(longitude: observer.longitude)","print(\"Local Sidereal Time: \\(lst) hours\")"],"syntax":"swift","type":"codeListing"},{"text":"Working with Observers","level":2,"anchor":"Working-with-Observers","type":"heading"},{"text":"Creating Observers","level":3,"anchor":"Creating-Observers","type":"heading"},{"code":["\/\/ Basic location (sea level)","let seattle = Observer(latitude: 47.6062, longitude: -122.3321)","","\/\/ With height above sea level (meters)","let everest = Observer(","    latitude: 27.9881,","    longitude: 86.9250,","    height: 8848.86",")"],"syntax":"swift","type":"codeListing"},{"text":"Coordinate Conventions","level":3,"anchor":"Coordinate-Conventions","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Latitude"}]},{"type":"text","text":": -90° (south) to +90° (north)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Longitude"}]},{"type":"text","text":": -180° (west) to +180° (east)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Height"}]},{"type":"text","text":": Meters above sea level"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Built-in Locations","level":3,"anchor":"Built-in-Locations","type":"heading"},{"code":["let greenwich = Observer.greenwich       \/\/ Royal Observatory","let primeMeridian = Observer.primeMeridian  \/\/ 0°, 0°"],"syntax":"swift","type":"codeListing"},{"text":"Observer Properties","level":3,"anchor":"Observer-Properties","type":"heading"},{"code":["let observer = Observer(latitude: 40.0, longitude: -105.0, height: 1600)","","\/\/ Local gravity (accounts for latitude and altitude)","let gravity = observer.gravity  \/\/ m\/s²","","\/\/ Atmospheric conditions at this elevation","let atmosphere = try observer.atmosphere","print(\"Pressure: \\(atmosphere.pressure) mbar\")"],"syntax":"swift","type":"codeListing"},{"text":"Observer Vectors","level":3,"anchor":"Observer-Vectors","type":"heading"},{"inlineContent":[{"type":"text","text":"Get the observer’s position relative to Earth’s center:"}],"type":"paragraph"},{"code":["let observer = Observer.greenwich","","\/\/ Position vector in AU","let position = try observer.vector(at: .now)","","\/\/ Full state (position and velocity)","let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")"],"syntax":"swift","type":"codeListing"},{"text":"Time Zones","level":2,"anchor":"Time-Zones","type":"heading"},{"inlineContent":[{"type":"text","text":"AstronomyKit works entirely in UTC. Convert to local time using Foundation:"}],"type":"paragraph"},{"code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise (local): \\(formatter.string(from: sunrise.date))\")"],"syntax":"swift","type":"codeListing"},{"text":"Codable Support","level":2,"anchor":"Codable-Support","type":"heading"},{"inlineContent":[{"type":"text","text":"Both types support "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" for persistence:"}],"type":"paragraph"},{"code":["let observer = Observer(latitude: 40.7, longitude: -74.0)","let data = try JSONEncoder().encode(observer)","","let time = AstroTime.now","let timeData = try JSONEncoder().encode(time)"],"syntax":"swift","type":"codeListing"},{"text":"Civil time and numerical compatibility","level":2,"anchor":"Civil-time-and-numerical-compatibility","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AstroTime(Date)"},{"type":"text","text":", calendar components and "},{"type":"codeVoice","code":".now"},{"type":"text","text":" use civil UTC. From 1961 onward,"},{"type":"text","text":" "},{"type":"text","text":"a bundled USNO table converts UTC to TT, including the rate adjustments before"},{"type":"text","text":" "},{"type":"text","text":"1972. Future dates retain the last announced leap-second offset. Before 1961,"},{"type":"text","text":" "},{"type":"text","text":"civil dates use the engine’s historical UT1 proxy."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"universalTime"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(ut:)"},{"type":"text","text":" are modeled UT1 coordinates, not UTC timestamps."},{"type":"text","text":" "},{"type":"codeVoice","code":"terrestrialTime"},{"type":"text","text":" and "},{"type":"codeVoice","code":"init(tt:)"},{"type":"text","text":" are TT. Native search results already carry"},{"type":"text","text":" "},{"type":"text","text":"both scales; their "},{"type":"codeVoice","code":".date"},{"type":"text","text":" uses the same civil inverse as every other time."},{"type":"text","text":" "},{"type":"codeVoice","code":"addingDays"},{"type":"text","text":" and "},{"type":"codeVoice","code":"addingHours"},{"type":"text","text":" add UT1 coordinate intervals. For civil calendar"},{"type":"text","text":" "},{"type":"text","text":"arithmetic, use Foundation and construct a new "},{"type":"codeVoice","code":"AstroTime"},{"type":"text","text":" from the resulting date."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Foundation cannot represent leap seconds. TT instants in positive UTC gaps map"},{"type":"text","text":" "},{"type":"text","text":"to the next transition; negative historical steps choose the later civil"},{"type":"text","text":" "},{"type":"text","text":"occurrence. Those instants cannot round-trip through "},{"type":"codeVoice","code":"Date"},{"type":"text","text":". Positive gaps in"},{"type":"text","text":" "},{"type":"text","text":"the selected Delta T model similarly map TT to the first UT1 coordinate after"},{"type":"text","text":" "},{"type":"text","text":"the jump. At negative overlaps, fixed-point iteration returns the first solution"},{"type":"text","text":" "},{"type":"text","text":"reached from its initial "},{"type":"codeVoice","code":"ut = tt"},{"type":"text","text":" estimate. TT remains exact in memory, but"},{"type":"text","text":" "},{"type":"text","text":"numeric Codable remains UT1-based, so decoding a gap-clamped value derives TT"},{"type":"text","text":" "},{"type":"text","text":"again from the selected model. The table’s future convention and the modeled"},{"type":"text","text":" "},{"type":"text","text":"UT1 values do not establish future UTC or Earth-orientation accuracy. Review"},{"type":"text","text":" "},{"type":"text","text":"serialized times and invalidate version-dependent cached calculations when"},{"type":"text","text":" "},{"type":"text","text":"upgrading."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted"]}],"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","title":"Time and Observers","role":"article"},"abstract":[{"text":"Work with astronomical time and geographic observer locations.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/timeandobservers"]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit":{"title":"AstronomyKit","type":"topic","url":"\/documentation\/astronomykit","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","abstract":[{"type":"text","text":"Swift bindings for Don Cross’ "},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"type":"text","text":" library."}],"kind":"symbol","role":"collection"},"doc://AstronomyKit/documentation/AstronomyKit/AstroTime":{"title":"AstroTime","type":"topic","url":"\/documentation\/astronomykit\/astrotime","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","abstract":[{"type":"text","text":"Represents a moment in time for astronomical calculations."}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"AstroTime","kind":"identifier"}],"navigatorTitle":[{"text":"AstroTime","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Observer":{"url":"\/documentation\/astronomykit\/observer","abstract":[{"type":"text","text":"A geographic location for observing celestial objects."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observer","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","navigatorTitle":[{"text":"Observer","kind":"identifier"}],"title":"Observer"},"doc://AstronomyKit/documentation/AstronomyKit/GettingStarted":{"url":"\/documentation\/astronomykit\/gettingstarted","abstract":[{"text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations.","type":"text"}],"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted","title":"Getting Started with AstronomyKit"},"https://github.com/cosinekitty/astronomy":{"url":"https:\/\/github.com\/cosinekitty\/astronomy","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","type":"link","titleInlineContent":[{"text":"Astronomy Engine","type":"text"}]}}}