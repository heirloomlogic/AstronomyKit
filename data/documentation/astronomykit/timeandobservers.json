":[{"text":"A geographic location for observing celestial objects.","type":"text"}],"navigatorTitle":[{"text":"Observer","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","title":"Observer","kind":"symbol","url":"\/documentation\/astronomykit\/observer","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Observer","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit":{"abstract":[{"text":"Pure Swift 6 astronomical calculations based on Don Cross’ ","type":"text"},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"text":" C library.","type":"text"}],"role":"collection","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","title":"AstronomyKit","kind":"symbol","url":"\/documentation\/astronomykit","type":"topic"},"doc://AstronomyKit/documentation/AstronomyKit/AstroTime":{"type":"topic","title":"AstroTime","abstract":[{"type":"text","text":"Represents a moment in time for astronomical calculations."}],"url":"\/documentation\/astronomykit\/astrotime","kind":"symbol","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","navigatorTitle":[{"text":"AstroTime","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstroTime","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/GettingStarted":{"abstract":[{"text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations.","type":"text"}],"role":"article","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted","title":"Getting Started with AstronomyKit","kind":"article","url":"\/documentation\/astronomykit\/gettingstarted","type":"topic"}}}