{"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"sections":[],"metadata":{"modules":[{"name":"AstronomyKit"}],"title":"Moon Phases","roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Moon","isActive":true},{"text":" type covers phase angles, illumination, quarter searches, position and velocity, libration, and node crossings.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Phase Angle","anchor":"Phase-Angle","type":"heading"},{"inlineContent":[{"text":"The phase angle indicates the Moon’s position in its cycle:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","print(\"Phase angle: \\(angle)°\")","\/\/ 0° = New Moon, 90° = First Quarter, 180° = Full, 270° = Third Quarter"],"type":"codeListing"},{"level":2,"text":"Phase Names and Emoji","anchor":"Phase-Names-and-Emoji","type":"heading"},{"inlineContent":[{"type":"text","text":"Convert angles to human-readable descriptions:"}],"type":"paragraph"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","","print(Moon.phaseName(for: angle))  \/\/ \"Waxing Gibbous\"","print(Moon.emoji(for: angle))      \/\/ \"🌔\""],"type":"codeListing"},{"inlineContent":[{"text":"The eight phase names:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"New Moon (🌑)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waxing Crescent (🌒)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"First Quarter (🌓)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waxing Gibbous (🌔)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Full Moon (🌕)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waning Gibbous (🌖)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Third Quarter (🌗)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Waning Crescent (🌘)"}]}]}]},{"level":2,"anchor":"Illumination","text":"Illumination","type":"heading"},{"inlineContent":[{"type":"text","text":"Calculate the fraction of the Moon that’s lit:"}],"type":"paragraph"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","let illumination = Moon.illumination(for: angle)","print(\"Moon is \\(Int(illumination * 100))% illuminated\")"],"type":"codeListing"},{"level":2,"anchor":"Finding-Quarter-Phases","text":"Finding Quarter Phases","type":"heading"},{"level":3,"anchor":"Search-for-a-Specific-Phase","text":"Search for a Specific Phase","type":"heading"},{"syntax":"swift","code":["\/\/ Next full moon (nil if none occurs within the search window)","if let fullMoon = try Moon.searchPhase(.full, after: .now) {","    print(\"Next full moon: \\(fullMoon)\")","}"],"type":"codeListing"},{"level":3,"anchor":"Get-the-Next-Quarter","text":"Get the Next Quarter","type":"heading"},{"syntax":"swift","code":["let quarter = try Moon.searchQuarter(after: .now)","print(\"\\(quarter.phase.emoji) \\(quarter.phase.name) at \\(quarter.time)\")"],"type":"codeListing"},{"level":3,"anchor":"All-Quarters-in-a-Date-Range","text":"All Quarters in a Date Range","type":"heading"},{"code":["let start = AstroTime(year: 2025, month: 1, day: 1)","let end = AstroTime(year: 2025, month: 2, day: 1)","","let quarters = try Moon.quarters(from: start, to: end)","for quarter in quarters {","    print(\"\\(quarter.phase.emoji) \\(quarter.time)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Lunar-Position","text":"Lunar Position","type":"heading","level":2},{"anchor":"Ecliptic-Coordinates","text":"Ecliptic Coordinates","type":"heading","level":3},{"code":["let position = try Moon.ecliptic(at: .now)","print(\"Longitude: \\(position.longitude)°\")","print(\"Latitude: \\(position.latitude)°\")","print(\"Distance: \\(position.distance) AU\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Ecliptic-Position-and-Velocity","text":"Ecliptic Position and Velocity","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the Moon’s speed along the ecliptic, ask for the state instead of differencing two positions:"}]},{"code":["let state = try Moon.eclipticState(at: .now)","print(\"Longitude: \\(state.longitude)°\")","print(\"Rate: \\(state.longitudeRate)°\/day\")  \/\/ About 12 to 15"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The position fields match "},{"code":"Moon.ecliptic(at:)","type":"codeVoice"},{"type":"text","text":" bit for bit. The rates are a central difference of the lunar series inside the engine, per Terrestrial Time day, accurate to roughly 1e-7 degrees per day. See "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","isActive":true},{"type":"text","text":" for the full rate contract."}]},{"anchor":"Cartesian-State","text":"Cartesian State","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get the Moon’s geocentric state vector in equatorial J2000 coordinates:"}]},{"code":["let state = try Moon.geoState(at: .now)","","\/\/ Position in AU","print(\"Distance: \\(state.position.magnitude) AU\")","","\/\/ Velocity in AU\/day","let speed = sqrt(","    state.velocity.x * state.velocity.x +","    state.velocity.y * state.velocity.y +","    state.velocity.z * state.velocity.z",")","print(\"Speed: \\(speed) AU\/day\")"],"type":"codeListing","syntax":"swift"},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":"eclipticState(at:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"geoState(at:)","type":"codeVoice"},{"text":" for velocities. Differencing two positions a short interval apart is noisier and costs two calls.","type":"text"}],"type":"paragraph"}]},{"anchor":"Using-CelestialBody","text":"Using CelestialBody","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The Moon is also available as a ","type":"text"},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"code":["let horizon = try CelestialBody.moon.horizon(at: .now, from: observer)","let equatorial = try CelestialBody.moon.equatorial(at: .now)"],"type":"codeListing","syntax":"swift"},{"anchor":"Libration","text":"Libration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Libration is the Moon’s apparent wobble that lets us see slightly more than 50% of its surface:","type":"text"}]},{"code":["let lib = Moon.libration(at: .now)","","\/\/ Sub-Earth point (what's at the center of the visible disc)","print(\"Latitude: \\(lib.subEarthLatitude)°\")","print(\"Longitude: \\(lib.subEarthLongitude)°\")","","\/\/ Distance and apparent size","print(\"Distance: \\(Int(lib.distanceKM)) km\")","print(\"Apparent diameter: \\(lib.apparentDiameter)°\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Interpret libration values:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Positive latitude: More of the north polar region is visible"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Positive longitude: More of the Moon’s east limb is visible"}]}]}],"type":"unorderedList"},{"text":"Lunar Nodes","level":2,"anchor":"Lunar-Nodes","type":"heading"},{"inlineContent":[{"type":"text","text":"The nodes are where the Moon’s orbit crosses the ecliptic plane:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Find next node crossing","let node = try Moon.searchNode(after: .now)","print(\"\\(node.kind.symbol) \\(node.kind.name) at \\(node.time)\")","\/\/ Output: \"☊ Ascending Node at 2025-01-15...\""],"type":"codeListing"},{"text":"Node Types","level":3,"anchor":"Node-Types","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ascending (☊): the Moon crosses from south to north of the ecliptic"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Descending (☋): the Moon crosses from north to south"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"All Nodes in a Range","level":3,"anchor":"All-Nodes-in-a-Range","type":"heading"},{"syntax":"swift","code":["let nodes = try Moon.nodeCrossings(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2025, month: 12, day: 31)",")","for node in nodes {","    print(\"\\(node.kind.symbol) \\(node.time)\")","}"],"type":"codeListing"},{"text":"Lunar Apsis","level":2,"anchor":"Lunar-Apsis","type":"heading"},{"inlineContent":[{"type":"text","text":"Find perigee (closest) and apogee (farthest) points:"}],"type":"paragraph"},{"syntax":"swift","code":["let apsis = try Moon.searchApsis(after: .now)","print(\"\\(apsis.kind.lunarName): \\(Int(apsis.distanceKM)) km\")","\/\/ Output: \"Perigee: 356,500 km\""],"type":"codeListing"},{"text":"All Apsides in a Range","level":3,"anchor":"All-Apsides-in-a-Range","type":"heading"},{"syntax":"swift","code":["let apsides = try Moon.apsides(","    from: .now,","    to: .now.addingDays(60)",")","for apsis in apsides {","    print(\"\\(apsis.kind.lunarName) at \\(apsis.time)\")","}"],"type":"codeListing"},{"text":"Moonrise and Moonset","level":2,"anchor":"Moonrise-and-Moonset","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","isActive":true},{"type":"text","text":" interface:"}],"type":"paragraph"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.7, longitude: -74.0)","","if let moonrise = try CelestialBody.moon.riseTime(after: .now, from: observer) {","    print(\"Moonrise: \\(moonrise)\")","}","","if let moonset = try CelestialBody.moon.setTime(after: .now, from: observer) {","    print(\"Moonset: \\(moonset)\")","}"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Calculate moon phases, quarters, libration, and lunar nodes."}],"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Moon","title":"Moon","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Moon","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhase","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonQuarter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Libration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarNode","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/NodeKind"]}],"variants":[{"paths":["\/documentation\/astronomykit\/moonphases"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://AstronomyKit/documentation/AstronomyKit/MoonPhase":{"type":"topic","url":"\/documentation\/astronomykit\/moonphase","kind":"symbol","navigatorTitle":[{"text":"MoonPhase","kind":"identifier"}],"abstract":[{"text":"A phase of the Moon.","type":"text"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhase","title":"MoonPhase","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MoonPhase","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/NodeKind":{"kind":"symbol","abstract":[{"text":"The type of lunar node crossing.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"NodeKind"}],"url":"\/documentation\/astronomykit\/nodekind","fragments":[{"kin