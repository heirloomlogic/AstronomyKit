"text":"ecliptic longitude positions, which gives inaccurate results.","type":"text"}]}],"name":"Tip","type":"aside"},{"level":3,"anchor":"Using-CelestialBody","text":"Using CelestialBody","type":"heading"},{"inlineContent":[{"text":"The Moon is also available as a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let horizon = try CelestialBody.moon.horizon(at: .now, from: observer)","let equatorial = try CelestialBody.moon.equatorial(at: .now)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Libration","text":"Libration","type":"heading"},{"inlineContent":[{"type":"text","text":"Libration is the Moon’s apparent wobble that lets us see slightly more than 50% of its surface:"}],"type":"paragraph"},{"code":["let lib = Moon.libration(at: .now)","","\/\/ Sub-Earth point (what's at the center of the visible disc)","print(\"Latitude: \\(lib.subEarthLatitude)°\")","print(\"Longitude: \\(lib.subEarthLongitude)°\")","","\/\/ Distance and apparent size","print(\"Distance: \\(Int(lib.distanceKM)) km\")","print(\"Apparent diameter: \\(lib.apparentDiameter)°\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Interpret libration values:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Positive latitude: More of the north polar region is visible","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Positive longitude: More of the Moon’s east limb is visible","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Lunar-Nodes","text":"Lunar Nodes","type":"heading"},{"inlineContent":[{"type":"text","text":"The nodes are where the Moon’s orbit crosses the ecliptic plane:"}],"type":"paragraph"},{"code":["\/\/ Find next node crossing","let node = try Moon.searchNode(after: .now)","print(\"\\(node.kind.symbol) \\(node.kind.nam