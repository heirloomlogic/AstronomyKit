{"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Moon","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhase","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonQuarter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Libration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarNode","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/NodeKind"],"title":"Moon","generated":true,"anchor":"Moon"}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"paths":["\/documentation\/astronomykit\/moonphases"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases"},"sections":[],"metadata":{"title":"Moon Phases","roleHeading":"Article","modules":[{"name":"AstronomyKit"}],"role":"article"},"abstract":[{"text":"Calculate moon phases, quarters, libration, and lunar nodes.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Moon"},{"text":" type provides comprehensive lunar calculations including phase angles, illumination, quarter searches, libration data, and node crossings.","type":"text"}],"type":"paragraph"},{"text":"Phase Angle","level":2,"anchor":"Phase-Angle","type":"heading"},{"inlineContent":[{"text":"The phase angle indicates the Moon’s position in its cycle:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","print(\"Phase angle: \\(angle)°\")","\/\/ 0° = New Moon, 90° = First Quarter, 180° = Full, 270° = Third Quarter"],"type":"codeListing"},{"text":"Phase Names and Emoji","level":2,"anchor":"Phase-Names-and-Emoji","type":"heading"},{"inlineContent":[{"text":"Convert angles to human-readable descriptions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","","print(Moon.phaseName(for: angle))  \/\/ \"Waxing Gibbous\"","print(Moon.emoji(for: angle))      \/\/ \"🌔\""],"type":"codeListing"},{"inlineContent":[{"text":"The eight phase names:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"New Moon (🌑)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waxing Crescent (🌒)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"First Quarter (🌓)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waxing Gibbous (🌔)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Full Moon (🌕)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waning Gibbous (🌖)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Third Quarter (🌗)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waning Crescent (🌘)","type":"text"}]}]}],"type":"unorderedList"},{"text":"Illumination","level":2,"anchor":"Illumination","type":"heading"},{"inlineContent":[{"text":"Calculate the fraction of the Moon that’s lit:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","let illumination = Moon.illumination(for: angle)","print(\"Moon is \\(Int(illumination * 100))% illuminated\")"],"type":"codeListing"},{"text":"Finding Quarter Phases","level":2,"anchor":"Finding-Quarter-Phases","type":"heading"},{"text":"Search for a Specific Phase","level":3,"anchor":"Search-for-a-Specific-Phase","type":"heading"},{"syntax":"swift","code":["\/\/ Next full moon (nil if none occurs within the search window)","if let fullMoon = try Moon.searchPhase(.full, after: .now) {","    print(\"Next full moon: \\(fullMoon)\")","}"],"type":"codeListing"},{"text":"Get the Next Quarter","level":3,"anchor":"Get-the-Next-Quarter","type":"heading"},{"syntax":"swift","code":["let quarter = try Moon.searchQuarter(after: .now)","print(\"\\(quarter.phase.emoji) \\(quarter.phase.name) at \\(quarter.time)\")"],"type":"codeListing"},{"text":"All Quarters in a Date Range","level":3,"anchor":"All-Quarters-in-a-Date-Range","type":"heading"},{"syntax":"swift","code":["let start = AstroTime(year: 2025, month: 1, day: 1)","let end = AstroTime(year: 2025, month: 2, day: 1)","","let quarters = try Moon.quarters(from: start, to: end)","for quarter in quarters {","    print(\"\\(quarter.phase.emoji) \\(quarter.time)\")","}"],"type":"codeListing"},{"text":"Lunar Position","level":2,"anchor":"Lunar-Position","type":"heading"},{"text":"Ecliptic Coordinates","level":3,"anchor":"Ecliptic-Coordinates","type":"heading"},{"syntax":"swift","code":["let position = try Moon.ecliptic(at: .now)","print(\"Longitude: \\(position.longitude)°\")","print(\"Latitude: \\(position.latitude)°\")","print(\"Distance: \\(position.distance) AU\")"],"type":"codeListing"},{"text":"Moon State (Position and Velocity)","level":3,"anchor":"Moon-State-Position-and-Velocity","type":"heading"},{"inlineContent":[{"text":"Get the Moon’s complete state vector including velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let state = try Moon.geoState(at: .now)","","\/\/ Position in AU","print(\"Distance: \\(state.position.magnitude) AU\")","","\/\/ Velocity in AU\/day","let speed = sqrt(","    state.velocity.x * state.velocity.x +","    state.velocity.y * state.velocity.y +","    state.velocity.z * state.velocity.z",")","print(\"Speed: \\(speed) AU\/day\")"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"geoState(at:)"},{"text":" for velocity calculations instead of differencing","type":"text"},{"text":" ","type":"text"},{"text":"ecliptic longitude positions, which gives inaccurate results.","type":"text"}]}],"style":"tip","name":"Tip","type":"aside"},{"text":"Using CelestialBody","level":3,"anchor":"Using-CelestialBody","type":"heading"},{"inlineContent":[{"text":"The Moon is also available as a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let horizon = try CelestialBody.moon.horizon(at: .now, from: observer)","let equatorial = try CelestialBody.moon.equatorial(at: .now)"],"type":"codeListing"},{"text":"Libration","level":2,"anchor":"Libration","type":"heading"},{"inlineContent":[{"text":"Libration is the Moon’s apparent wobble that lets us see slightly more than 50% of its surface:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let lib = Moon.libration(at: .now)","","\/\/ Sub-Earth point (what's at the center of the visible disc)","print(\"Latitude: \\(lib.subEarthLatitude)°\")","print(\"Longitude: \\(lib.subEarthLongitude)°\")","","\/\/ Distance and apparent size","print(\"Distance: \\(Int(lib.distanceKM)) km\")","print(\"Apparent diameter: \\(lib.apparentDiameter)°\")"],"type":"codeListing"},{"inlineContent":[{"text":"Interpret libration values:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Positive latitude: More of the north polar region is visible","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Positive longitude: More of the Moon’s east limb is visible","type":"text"}]}]}],"type":"unorderedList"},{"text":"Lunar Nodes","level":2,"anchor":"Lunar-Nodes","type":"heading"},{"inlineContent":[{"text":"The nodes are where the Moon’s orbit crosses the ecliptic plane:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Find next node crossing","let node = try Moon.searchNode(after: .now)","print(\"\\(node.kind.symbol) \\(node.kind.name) at \\(node.time)\")","\/\/ Output: \"☊ Ascending Node at 2025-01-15...\""],"type":"codeListing"},{"text":"Node Types","level":3,"anchor":"Node-Types","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Ascending (☊)","type":"text"}],"type":"strong"},{"text":": Moon crosses from south to north of the ecliptic","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Descending (☋)","type":"text"}],"type":"strong"},{"text":": Moon crosses from north to south","type":"text"}]}]}],"type":"unorderedList"},{"text":"All Nodes in a Range","level":3,"anchor":"All-Nodes-in-a-Range","type":"heading"},{"syntax":"swift","code":["let nodes = try Moon.nodeCrossings(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2025, month: 12, day: 31)",")","for node in nodes {","    print(\"\\(node.kind.symbol) \\(node.time)\")","}"],"type":"codeListing"},{"text":"Lunar Apsis","level":2,"anchor":"Lunar-Apsis","type":"heading"},{"inlineContent":[{"text":"Find perigee (closest) and apogee (farthest) points:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let apsis = try Moon.searchApsis(after: .now)","print(\"\\(apsis.kind.lunarName): \\(Int(apsis.distanceKM)) km\")","\/\/ Output: \"Perigee: 356,500 km\""],"type":"codeListing"},{"text":"All Apsides in a Range","level":3,"anchor":"All-Apsides-in-a-Range","type":"heading"},{"syntax":"swift","code":["let apsides = try Moon.apsides(","    from: .now,","    to: .now.addingDays(60)",")","for apsis in apsides {","    print(\"\\(apsis.kind.lunarName) at \\(apsis.time)\")","}"],"type":"codeListing"},{"text":"Moonrise and Moonset","level":2,"anchor":"Moonrise-and-Moonset","type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody"},{"text":" interface:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.7, longitude: -74.0)","","if let moonrise = try CelestialBody.moon.riseTime(after: .now, from: observer) {","    print(\"Moonrise: \\(moonrise)\")","}","","if let moonset = try CelestialBody.moon.setTime(after: .now, from: observer) {","    print(\"Moonset: \\(moonset)\")","}"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/CelestialBody":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CelestialBody"}],"navigatorTitle":[{"kind":"identifier","text":"CelestialBody"}],"role":"symbol","title":"CelestialBody","url":"\/documentation\/astronomykit\/celestialbody","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A celestial body in the solar system."}]},"doc://AstronomyKit/documentation/AstronomyKit/Moon":{"abstract":[{"type":"text","text":"Moon-specific calculations."}],"url":"\/documentation\/astronomykit\/moon","type":"topic","title":"Moon","kind":"symbol","navigatorTitle":[{"text":"Moon","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Moon","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Moon"},"doc://AstronomyKit/documentation/AstronomyKit":{"abstract":[{"type":"text","text":"Swift bindings for Don Cross’ "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/cosinekitty\/astronomy"},{"type":"text","text":" library."}],"url":"\/documentation\/astronomykit","title":"AstronomyKit","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit"},"doc://AstronomyKit/documentation/AstronomyKit/LunarNode":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LunarNode","kind":"identifier"}],"navigatorTi