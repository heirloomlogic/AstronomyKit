{"abstract":[{"text":"Calculate moon phases, quarters, libration, and lunar nodes.","type":"text"}],"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","title":"Moon Phases","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Moon"},{"text":" type provides lunar phase angles, illumination, quarter searches, positions, libration data, node crossings, and apsides.","type":"text"}]},{"anchor":"Phase-Angle","text":"Phase Angle","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The phase angle indicates the Moon’s position in its cycle:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","print(\"Phase angle: \\(angle)°\")","\/\/ 0° = New Moon, 90° = First Quarter, 180° = Full, 270° = Third Quarter"]},{"anchor":"Phase-Names-and-Emoji","text":"Phase Names and Emoji","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Convert angles to human-readable descriptions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","","print(Moon.phaseName(for: angle))  \/\/ \"Waxing Gibbous\"","print(Moon.emoji(for: angle))      \/\/ \"🌔\""]},{"type":"paragraph","inlineContent":[{"text":"The eight phase names:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"New Moon (🌑)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Waxing Crescent (🌒)","type":"text"}]}