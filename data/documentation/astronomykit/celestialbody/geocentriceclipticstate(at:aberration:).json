{"abstract":[{"type":"text","text":"Calculates the apparent geocentric ecliptic position and velocity of this body."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"geocentricEclipticState","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"time","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"AstroTime","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","preciseIdentifier":"s:12AstronomyKit9AstroTimeV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"aberration"},{"text":": ","kind":"text"},{"text":"Aberration","kind":"typeIdentifier","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","preciseIdentifier":"s:12AstronomyKit10AberrationO"},{"text":" = .corrected) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EclipticState","kind":"typeIdentifier","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipticState","preciseIdentifier":"s:12AstronomyKit13EclipticStateV"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"time","content":[{"inlineContent":[{"text":"The observation time.","type":"text"}],"type":"paragraph"}]},{"name":"aberration","content":[{"type":"paragraph","inlineContent":[{"text":"Whether to correct for aberration. Defaults to ","type":"text"},{"code":".corrected","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Ignored for the Moon, as in ","type":"text"},{"code":"geocentricPosition(at:aberration:)","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The ecliptic position and velocity.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The position fields are bit-identical to"},{"type":"text","text":" "},{"type":"codeVoice","code":"geocentricPosition(at: time, aberration: aberration).toEcliptic()"},{"type":"text","text":". The rates"},{"type":"text","text":" "},{"type":"text","text":"are the analytic time derivative of that position in degrees (or AU) per"},{"type":"text","text":" "},{"type":"text","text":"Terrestrial Time day with Delta T held fixed, including the light-time"},{"type":"text","text":" "},{"type":"text","text":"derivative, the observer’s motion under the aberration approximation, and the"},{"type":"text","text":" "},{"type":"text","text":"rotation of the true ecliptic and equinox of date. The Moon’s rates are a"},{"type":"text","text":" "},{"type":"text","text":"central difference of the lunar series over about 43 seconds; every other"},{"type":"text","text":" "},{"type":"text","text":"supported body’s rates are analytic. Pluto’s velocity is the exact derivative"},{"text":" ","type":"text"},{"text":"of its interpolated position, which has small kinks at the interpolation","type":"text"},{"text":" ","type":"text"},{"text":"table’s 146-day steps.","type":"text"}]},{"inlineContent":[{"text":"Supported bodies are the Sun, the Moon, Mercury through Neptune except","type":"text"},{"text":" ","type":"text"},{"text":"Earth, and Pluto. Other bodies throw ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/invalidBody"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"AstronomyError"},{"type":"text","text":" if the calculation fails."}]}]}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift