{"kind":"article","abstract":[{"text":"Transform positions between different astronomical coordinate systems.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit supports multiple coordinate systems and provides rotation matrices for transforming between them. Understanding these systems is essential for precise astronomical work.","type":"text"}]},{"text":"Coordinate Systems","type":"heading","anchor":"Coordinate-Systems","level":2},{"text":"Equatorial J2000 (EQJ)","type":"heading","anchor":"Equatorial-J2000-EQJ","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard reference frame used by most star catalogs:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Origin: Earth’s center","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Fundamental plane: Earth’s equator at J2000.0 epoch","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Primary direction: Vernal equinox at J2000.0","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"],"syntax":"swift"},{"text":"Equatorial of Date (EQD)","type":"heading","anchor":"Equatorial-of-Date-EQD","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Accounts for precession of Earth’s axis:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Same as EQJ but referenced to the current date","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"text":"Ecliptic (ECL)","type":"heading","anchor":"Ecliptic-ECL","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the plane of Earth’s orbit:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Fundamental plane: Ecliptic (Earth’s orbital plane)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Primary direction: Vernal equinox","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"],"syntax":"swift"},{"text":"Horizontal (HOR)","type":"heading","anchor":"Horizontal-HOR","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Local sky coordinates for an observer:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Altitude: Height above the horizon","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Azimuth: Compass direction from north","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"],"syntax":"swift"},{"text":"Galactic (GAL)","type":"heading","anchor":"Galactic-GAL","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the Milky Way:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Fundamental plane: Galactic plane","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Primary direction: Galactic center","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available via rotation matrices (see below)."}]},{"text":"Rotation Matrices","type":"heading","anchor":"Rotation-Matrices","level":2},{"text":"Creating Rotation Matrices","type":"heading","anchor":"Creating-Rotation-Matrices","level":3},{"type":"codeListing","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"],"syntax":"swift"},{"text":"Time-Dependent Rotations","type":"heading","anchor":"Time-Dependent-Rotations","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some transformations require a time for precession\/nutation:"}]},{"type":"codeListing","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"],"syntax":"swift"},{"text":"Applying Rotations","type":"heading","anchor":"Applying-Rotations","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transform a vector using a rotation matrix:"}]},{"type":"codeListing","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"],"syntax":"swift"},{"text":"Matrix Operations","type":"heading","anchor":"Matrix-Operations","level":3},{"type":"codeListing","code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"],"syntax":"swift"},{"text":"Vector Types","type":"heading","anchor":"Vector-Types","level":2},{"text":"Vector3D","type":"heading","anchor":"Vector3D","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A 3D Cartesian position vector:"}]},{"type":"codeListing","code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"syntax":"swift"},{"text":"StateVector","type":"heading","anchor":"StateVector","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position and velocity together:"}]},{"type":"codeListing","code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"syntax":"swift"},{"text":"Spherical Coordinates","type":"heading","anchor":"Spherical-Coordinates","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Spherical"},{"type":"text","text":" type (latitude, longitude, distance) is produced by converting"},{"type":"text","text":" "},{"type":"text","text":"a position vector:"}]},{"type":"codeListing","code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"],"syntax":"swift"},{"text":"Atmospheric Effects","type":"heading","anchor":"Atmospheric-Effects","level":2},{"text":"Refraction","type":"heading","anchor":"Refraction","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Atmospheric refraction bends light, affecting apparent altitude:"}]},{"type":"codeListing","code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift"},{"text":"Computing Refraction Directly","type":"heading","anchor":"Computing-Refraction-Directly","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate refraction angles independently of a coordinate conversion:"}]},{"type":"codeListing","code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"],"syntax":"swift"},{"text":"Aberration","type":"heading","anchor":"Aberration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Light-time and stellar aberration affect apparent positions:"}]},{"type":"codeListing","code":["\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"syntax":"swift"},{"text":"Available Rotations","type":"heading","anchor":"Available-Rotations","level":2},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"From","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"To","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"EQJ","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"ECL","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"equatorialJ2000ToEcliptic()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"te