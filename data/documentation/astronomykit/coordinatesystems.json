{"abstract":[{"text":"Transform positions between different astronomical coordinate systems.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/coordinatesystems"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"AstronomyKit supports several coordinate systems and provides rotation matrices for transforming between them.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Coordinate Systems","anchor":"Coordinate-Systems","type":"heading"},{"level":3,"text":"Equatorial J2000 (EQJ)","anchor":"Equatorial-J2000-EQJ","type":"heading"},{"inlineContent":[{"text":"The standard reference frame used by most star catalogs:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Origin: Earth’s center"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Earth’s equator at J2000.0 epoch"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox at J2000.0"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"]},{"level":3,"text":"Equatorial of Date (EQD)","anchor":"Equatorial-of-Date-EQD","type":"heading"},{"inlineContent":[{"type":"text","text":"Accounts for precession of Earth’s axis:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Same as EQJ but referenced to the current date"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"]},{"type":"heading","level":3,"anchor":"Ecliptic-ECL","text":"Ecliptic (ECL)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the plane of Earth’s orbit:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Fundamental plane: Ecliptic (Earth’s orbital plane)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Primary direction: Vernal equinox","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position and velocity together, in the true ecliptic and equinox of date:"}]},{"syntax":"swift","type":"codeListing","code":["let state = try CelestialBody.mars.geocentricEclipticState(at: .now)","print(\"λ: \\(state.longitude)°, λ̇: \\(state.longitudeRate)°\/day\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","isActive":true,"type":"reference"},{"type":"text","text":" for what the rates include."}]},{"type":"heading","level":3,"anchor":"Horizontal-HOR","text":"Horizontal (HOR)"},{"type":"paragraph","inlineContent":[{"text":"Local sky coordinates for an observer:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Altitude: Height above the horizon","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Azimuth: Compass direction from north","type":"text"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"]},{"type":"heading","level":3,"anchor":"Galactic-GAL","text":"Galactic (GAL)"},{"type":"paragraph","inlineContent":[{"text":"Referenced to the Milky Way:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fundamental plane: Galactic plane","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Galactic center"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Available via rotation matrices (see below).","type":"text"}]},{"anchor":"Rotation-Matrices","level":2,"text":"Rotation Matrices","type":"heading"},{"anchor":"Creating-Rotation-Matrices","level":3,"text":"Creating Rotation Matrices","type":"heading"},{"code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"],"syntax":"swift","type":"codeListing"},{"anchor":"Time-Dependent-Rotations","level":3,"text":"Time-Dependent Rotations","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Some transformations require a time for precession\/nutation:","type":"text"}]},{"code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"],"syntax":"swift","type":"codeListing"},{"anchor":"Applying-Rotations","level":3,"text":"Applying Rotations","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transform a vector using a rotation matrix:"}]},{"code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"],"syntax":"swift","type":"codeListing"},{"anchor":"Matrix-Operations","level":3,"text":"Matrix Operations","type":"heading"},{"code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"],"syntax":"swift","type":"codeListing"},{"anchor":"Vector-Types","level":2,"text":"Vector Types","type":"heading"},{"anchor":"Vector3D","level":3,"text":"Vector3D","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A 3D Cartesian position vector:","type":"text"}]},{"code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"syntax":"swift","type":"codeListing"},{"anchor":"StateVector","level":3,"text":"StateVector","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position and velocity together:"}]},{"code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"syntax":"swift","type":"codeListing"},{"anchor":"Spherical-Coordinates","level":2,"text":"Spherical Coordinates","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Spherical"},{"type":"text","text":" type (latitude, longitude, distance) comes from converting a position vector:"}]},{"code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","le