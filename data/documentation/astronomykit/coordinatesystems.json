"text","text":"Primary direction: Vernal equinox at J2000.0"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Equatorial-of-Date-EQD","text":"Equatorial of Date (EQD)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Accounts for precession of Earth’s axis:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Same as EQJ but referenced to the current date"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Ecliptic-ECL","text":"Ecliptic (ECL)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the plane of Earth’s orbit:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Fundamental plane: Ecliptic (Earth’s orbital plane)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position and velocity together, in the true ecliptic and equinox of date:"}]},{"type":"codeListing","code":["let state = try CelestialBody.mars.geocentricEclipticState(at: .now)","print(\"λ: \\(state.longitude)°, λ̇: \\(state.longitudeRate)°\/day\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","isActive":true,"type":"reference"},{"type":"text","text":" for what the rates include."}]},{"level":3,"type":"heading","anchor":"Horizontal-HOR","text":"Horizontal (HOR)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Local sky coordinates for an observer:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Altitude: Height above the horizon"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Azimuth: Compass direction from north"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Galactic-GAL","text":"Galactic (GAL)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the Milky Way:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Fundamental plane: Galactic plane"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Primary direction: Galactic center"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available via rotation matrices (see below)."}]},{"level":2,"type":"heading","anchor":"Rotation-Matrices","text":"Rotation Matrices"},{"level":3,"type":"heading","anchor":"Creating-Rotation-Matrices","text":"Creating Rotation Matrices"},{"type":"codeListing","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Time-Dependent-Rotations","text":"Time-Dependent Rotations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some transformations require a time for precession\/nutation:"}]},{"type":"codeListing","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Applying-Rotations","text":"Applying Rotations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transform a vector using a rotation matrix:"}]},{"type":"codeListing","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Matrix-Operations","text":"Matrix Operations"},{"type":"codeListing","code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Vector-Types","text":"Vector Types"},{"level":3,"type":"heading","anchor":"Vector3D","text":"Vector3D"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A 3D Cartesian position vector:"}]},{"type":"codeListing","code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"StateVector","text":"StateVector"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position and velocity together:"}]},{"type":"codeListing","code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Spherical-Coordinates","text":"Spherical Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Spherical","type":"codeVoice"},{"type":"text","text":" type (latitude, longitude, distance) comes from converting a position vector:"}]},{"type":"codeListing","code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Atmospheric-Effects","text":"Atmospheric Effects"},{"level":3,"type":"heading","anchor":"Refraction","text":"Refraction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Atmospheric refraction bends light, affecting apparent altitude:"}]},{"type":"codeListing","code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Computing-Refraction-Directly","text":"Computing Refraction Directly"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate refraction angles independently of a coordinate conversion:"}]},{"type":"codeListing","code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Aberration","text":"Aberration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Light-time and stellar aberration affect apparent positions:"}]},{"type":"codeListing","code":["\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Available-Rotations","text":"Available Rotations"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"From","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"To","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"EQJ","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"ECL","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"equatorialJ2000ToEcliptic()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"ECL","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"EQJ","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"eclipticToEquatorialJ2000()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"EQJ","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"EQD","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"equatorialJ2000ToEquatorialOfDate(at:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":