ontent":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox at J2000.0"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"]},{"anchor":"Equatorial-of-Date-EQD","type":"heading","text":"Equatorial of Date (EQD)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Accounts for precession of Earth’s axis:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Same as EQJ but referenced to the current date"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"]},{"anchor":"Ecliptic-ECL","type":"heading","text":"Ecliptic (ECL)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the plane of Earth’s orbit:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Ecliptic (Earth’s orbital plane)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"]},{"anchor":"Horizontal-HOR","type":"heading","text":"Horizontal (HOR)","level":3},{"type":"paragraph","inlineContent":[{"text":"Local sky coordinates for an observer:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Altitude: Height above the horizon","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Azimuth: Compass direction from north","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"]},{"anchor":"Galactic-GAL","type":"heading","text":"Galactic (GAL)","level":3},{"type":"paragraph","inlineContent":[{"text":"Referenced to the Milky Way:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fundamental plane: Galactic plane","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Primary direction: Galactic center","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Available via rotation matrices (see below).","type":"text"}]},{"anchor":"Rotation-Matrices","type":"heading","text":"Rotation Matrices","level":2},{"anchor":"Creating-Rotation-Matrices","type":"heading","text":"Creating Rotation Matrices","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"]},{"anchor":"Time-Dependent-Rotations","type":"heading","text":"Time-Dependent Rotations","level":3},{"type":"paragraph","inlineContent":[{"text":"Some transformations require a time for precession\/nutation:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"]},{"anchor":"Applying-Rotations","type":"heading","text":"Applying Rotations","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transform a vector using a rotation matrix:"}]},{"syntax":"swift","type":"codeListing","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"]},{"anchor":"Matrix-Operations","type":"heading","text":"Matrix Operations","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"]},{"type":"heading","level":2,"text":"Vector Types","anchor":"Vector-Types"},{"type":"heading","level":3,"text":"Vector3D","anchor":"Vector3D"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A 3D Cartesian position vector:"}]},{"code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"StateVector","anchor":"StateVector"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Position and velocity together:"}]},{"code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"syntax":"swift","type":"codeListing"},{"anchor":"Spherical-Coordinates","type":"heading","text":"Spherical Coordinates","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Spherical","type":"codeVoice"},{"type":"text","text":" type (latitude, longitude, distance) is produced by converting"},{"type":"text","text":" "},{"type":"text","text":"a position vector:"}]},{"syntax":"swift","type":"codeListing","code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"]},{"anchor":"Atmospheric-Effects","type":"heading","text":"Atmospheric Effects","level":2},{"anchor":"Refraction","type":"heading","text":"Refraction","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Atmospheric refraction bends light, affecting apparent altitude:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"]},{"anchor":"Computing-Refraction-Directly","type":"heading","text":"Computing Refraction Directly","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate refraction angles independently of a coordinate conversion:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"]},{"anchor":"Aberration","type":"heading","text":"Aberration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Light-time and stellar aberrati