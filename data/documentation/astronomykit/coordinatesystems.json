{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit supports several coordinate systems and provides rotation matrices for transforming between them.","type":"text"}]},{"type":"heading","anchor":"Coordinate-Systems","level":2,"text":"Coordinate Systems"},{"type":"heading","anchor":"Equatorial-J2000-EQJ","level":3,"text":"Equatorial J2000 (EQJ)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard reference frame used by most star catalogs:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origin: Earth’s center"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Fundamental plane: Earth’s equator at J2000.0 epoch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Primary direction: Vernal equinox at J2000.0","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"],"type":"codeListing"},{"text":"Equatorial of Date (EQD)","level":3,"anchor":"Equatorial-of-Date-EQD","type":"heading"},{"inlineContent":[{"text":"Accounts for precession of Earth’s axis:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Same as EQJ but referenced to the current date"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"type":"codeListing"},{"text":"Ecliptic (ECL)","level":3,"anchor":"Ecliptic-ECL","type":"heading"},{"inlineContent":[{"text":"Referenced to the plane of Earth’s orbit:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Fundamental plane: Ecliptic (Earth’s orbital plane)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"],"type":"codeListing"},{"inlineContent":[{"text":"Position and velocity together, in the true ecliptic and equinox of date:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let state = try CelestialBody.mars.geocentricEclipticState(at: .now)","print(\"λ: \\(state.longitude)°, λ̇: \\(state.longitudeRate)°\/day\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"},{"type":"text","text":" for what the rates include."}],"type":"paragraph"},{"type":"heading","anchor":"Horizontal-HOR","text":"Horizontal (HOR)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Local sky coordinates for an observer:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Altitude: Height above the horizon"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Azimuth: Compass direction from north"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"]},{"type":"heading","anchor":"Galactic-GAL","text":"Galactic (GAL)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Referenced to the Milky Way:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fundamental plane: Galactic plane","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Primary direction: Galactic center","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Available via rotation matrices (see below)."}]},{"type":"heading","anchor":"Rotation-Matrices","text":"Rotation Matrices","level":2},{"type":"heading","anchor":"Creating-Rotation-Matrices","text":"Creating Rotation Matrices","level":3},{"type":"codeListing","syntax":"swift","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"]},{"type":"heading","anchor":"Time-Dependent-Rotations","text":"Time-Dependent Rotations","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some transformations require a time for precession\/nutation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"]},{"type":"heading","anchor":"Applying-Rotations","text":"Applying Rotations","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transform a vector using a rotation matrix:"}]},{"type":"codeListing","syntax":"swift","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"]},{"type":"heading","anchor":"Matrix-Operations","text":"Matrix Operations","level":3},{"type":"codeListing","syntax":"swift","code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"]},{"type":"heading","level":2,"text":"Vector Types","anchor":"Vector-Types"},{"type":"heading","level":3,"text":"Vector3D","anchor":"Vector3D"},{"type":"paragraph","inlineContent":[{"text":"A 3D Cartesian position vector:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"]},{"type":"heading","level":3,"text":"StateVector","anchor":"StateVector"},{"type":"paragraph","inlineContent":[{"text":"Position and velocity together:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"]},{"type":"heading","level":2,"text":"Spherical Coordinates","anchor":"Spherical-Coordinates"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Spherical"},{"text":" type (latitude, longitude, distance) comes from converting a position vector:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"]},{"type":"heading","level":2,"text":"Atmospheric Effects","anchor":"Atmospheric-Effects"},{"type":"heading","level":3,"text":"Refraction","anchor":"Refraction"},{"type":"paragraph","inlineContent":[{"text":"Atmospheric refraction bends light, affecting apparent altitude:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"]},{"type":"heading","level":3,"text":"Computing Refraction Directly","anchor":"Computing-Refraction-Directly"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate refraction angles independently of a coordinate conversion:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"]},{"type":"heading","level":3,"text":"Aberration","anchor":"Aberration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Light-time and stellar aberration affect apparent positions:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"]},{"type":"heading","level":2,"text":"Available Rotations","anchor":"Available-Rotations"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"From","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"To","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"EQJ"}]}],[{"type":"paragraph","inlineContent":[{"text":"ECL","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"equatorialJ2000ToEcliptic()"}]}]],[[{"inlineContent":[{"text":"ECL","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"EQJ","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"eclipticToEquatorialJ2000()"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"EQJ"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"EQD"}]}],[{"inlineContent":[{"code":"equatorialJ2000ToEquatorialOfDate(at:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"EQD","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"EQJ","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"equatorialOfDateToEquatorialJ2000(at:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"EQJ"}]}],[{"type":"paragraph","inlineContent":[{"text":"HOR","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"equatorialJ2000ToHorizon(at:from:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"HOR","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"EQJ"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"horizonToEquatorialJ2000(at:from:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"EQJ"}]}],[{"type":"paragraph","inlineContent":[{"text":"GAL","type":"text"}]}],[{"inlineContent":[{"code":"equatorialJ2000ToGalactic()","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"GAL","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"