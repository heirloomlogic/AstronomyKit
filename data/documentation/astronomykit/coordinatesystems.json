{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/astronomykit\/coordinatesystems"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"AstronomyKit supports multiple coordinate systems and provides rotation matrices for transforming between them. Understanding these systems is essential for precise astronomical work."}],"type":"paragraph"},{"text":"Coordinate Systems","level":2,"anchor":"Coordinate-Systems","type":"heading"},{"text":"Equatorial J2000 (EQJ)","level":3,"anchor":"Equatorial-J2000-EQJ","type":"heading"},{"inlineContent":[{"text":"The standard reference frame used by most star catalogs:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Origin: Earth’s center","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Fundamental plane: Earth’s equator at J2000.0 epoch"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Primary direction: Vernal equinox at J2000.0","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"],"type":"codeListing"},{"text":"Equatorial of Date (EQD)","level":3,"anchor":"Equatorial-of-Date-EQD","type":"heading"},{"inlineContent":[{"text":"Accounts for precession of Earth’s axis:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Same as EQJ but referenced to the current date","type":"text"}]}]}]},{"code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift","type":"codeListing"},{"text":"Ecliptic (ECL)","level":3,"anchor":"Ecliptic-ECL","type":"heading"},{"inlineContent":[{"text":"Referenced to the plane of Earth’s orbit:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Fundamental plane: Ecliptic (Earth’s orbital plane)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Primary direction: Vernal equinox","type":"text"}],"type":"paragraph"}]}]},{"code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"],"syntax":"swift","type":"codeListing"},{"text":"Horizontal (HOR)","level":3,"anchor":"Horizontal-HOR","type":"heading"},{"inlineContent":[{"type":"text","text":"Local sky coordinates for an observer:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Altitude: Height above the horizon"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Azimuth: Compass direction from north","type":"text"}]}]}]},{"code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"],"syntax":"swift","type":"codeListing"},{"text":"Galactic (GAL)","level":3,"anchor":"Galactic-GAL","type":"heading"},{"inlineContent":[{"type":"text","text":"Referenced to the Milky Way:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fundamental plane: Galactic plane","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Primary direction: Galactic center","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Available via rotation matrices (see below).","type":"text"}],"type":"paragraph"},{"text":"Rotation Matrices","level":2,"type":"heading","anchor":"Rotation-Matrices"},{"text":"Creating Rotation Matrices","level":3,"type":"heading","anchor":"Creating-Rotation-Matrices"},{"type":"codeListing","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"],"syntax":"swift"},{"text":"Time-Dependent Rotations","level":3,"type":"heading","anchor":"Time-Dependent-Rotations"},{"inlineContent":[{"text":"Some transformations require a time for precession\/nutation:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"],"syntax":"swift"},{"text":"Applying Rotations","level":3,"type":"heading","anchor":"Applying-Rotations"},{"inlineContent":[{"text":"Transform a vector using a rotation matrix:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"],"syntax":"swift"},{"text":"Matrix Operations","level":3,"type":"heading","anchor":"Matrix-Operations"},{"code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Vector Types","level":2,"anchor":"Vector-Types"},{"type":"heading","text":"Vector3D","level":3,"anchor":"Vector3D"},{"inlineContent":[{"text":"A 3D Cartesian position vector:","type":"text"}],"type":"paragraph"},{"code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"StateVector","level":3,"anchor":"StateVector"},{"inlineContent":[{"type":"text","text":"Position and velocity together:"}],"type":"paragraph"},{"code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Spherical Coordinates","level":2,"anchor":"Spherical-Coordinates"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Spherical","type":"codeVoice"},{"type":"text","text":" type (latitude, longitude, distance) is produced by converting"},{"type":"text","text":" "},{"type":"text","text":"a position vector:"}],"type":"paragraph"},{"code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Atmospheric-Effects","text":"Atmospheric Effects","level":2,"type":"heading"},{"anchor":"Refraction","text":"Refraction","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Atmospheric refraction bends light, affecting apparent altitude:"}],"type":"paragraph"},{"code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift","type":"codeListing"},{"anchor":"Computing-Refraction-Directly","text":"Computing Refraction Directly","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Calculate refraction angles independently of a coordinate conversion:"}],"type":"paragraph"},{"code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"],"syntax":"swift","type":"codeListing"},{"anchor":"Aberration","text":"Aberration","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Light-time and stellar aberration affect apparent positions:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"type":"codeListing"},{"level":2,"type":"heading","text":"Available Rotations","anchor":"Available-Rotations"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"From","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"To"}]}],[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"EQJ","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"ECL","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice"