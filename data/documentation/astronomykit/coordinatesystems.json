{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"title":"Position Calculations","anchor":"Position-Calculations","generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CoordinateSystems"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit supports multiple coordinate systems and provides rotation matrices for transforming between them. Understanding these systems is essential for precise astronomical work."}]},{"type":"heading","text":"Coordinate Systems","level":2,"anchor":"Coordinate-Systems"},{"type":"heading","text":"Equatorial J2000 (EQJ)","level":3,"anchor":"Equatorial-J2000-EQJ"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The standard reference frame used by most star catalogs:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Origin: Earth’s center","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Earth’s equator at J2000.0 epoch"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox at J2000.0"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"],"syntax":"swift","type":"codeListing"},{"anchor":"Equatorial-of-Date-EQD","text":"Equatorial of Date (EQD)","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Accounts for precession of Earth’s axis:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Same as EQJ but referenced to the current date","type":"text"}]}]}],"type":"unorderedList"},{"code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift","type":"codeListing"},{"anchor":"Ecliptic-ECL","text":"Ecliptic (ECL)","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Referenced to the plane of Earth’s orbit:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Ecliptic (Earth’s orbital plane)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"],"type":"codeListing"},{"text":"Horizontal (HOR)","anchor":"Horizontal-HOR","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Local sky coordinates for an observer:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Altitude: Height above the horizon","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Azimuth: Compass direction from north"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"],"type":"codeListing"},{"text":"Galactic (GAL)","anchor":"Galactic-GAL","type":"heading","level":3},{"inlineContent":[{"text":"Referenced to the Milky Way:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Galactic plane"}]}]},{"content":[{"inlineContent":[{"text":"Primary direction: Galactic center","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Available via rotation matrices (see below).","type":"text"}],"type":"paragraph"},{"text":"Rotation Matrices","anchor":"Rotation-Matrices","type":"heading","level":2},{"text":"Creating Rotation Matrices","anchor":"Creating-Rotation-Matrices","type":"heading","level":3},{"syntax":"swift","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"],"type":"codeListing"},{"text":"Time-Dependent Rotations","anchor":"Time-Dependent-Rotations","type":"heading","level":3},{"inlineContent":[{"text":"Some transformations require a time for precession\/nutation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"],"type":"codeListing"},{"text":"Applying Rotations","anchor":"Applying-Rotations","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Transform a vector using a rotation matrix:","type":"text"}]},{"type":"codeListing","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"],"syntax":"swift"},{"anchor":"Matrix-Operations","type":"heading","level":3,"text":"Matrix Operations"},{"type":"codeListing","code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"],"syntax":"swift"},{"anchor":"Vector-Types","type":"heading","level":2,"text":"Vector Types"},{"anchor":"Vector3D","type":"heading","level":3,"text":"Vector3D"},{"type":"paragraph","inlineContent":[{"text":"A 3D Cartesian position vector:","type":"text"}]},{"type":"codeListing","code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"syntax":"swift"},{"anchor":"StateVector","type":"heading","level":3,"text":"StateVector"},{"type":"paragraph","inlineContent":[{"text":"Position and velocity together:","type":"text"}]},{"type":"codeListing","code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"syntax":"swift"},{"anchor":"Spherical-Coordinates","type":"heading","level":2,"text":"Spherical Coordinates"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Spherical"},{"type":"text","text":" type (latitude, longitude, distance) is produced by converting"},{"type":"text","text":" "},{"type":"text","text":"a position vector:"}]},{"type":"codeListing","code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"],"syntax":"swift"},{"anchor":"Atmospheric-Effects","level":2,"type":"heading","text":"Atmospheric Effects"},{"anchor":"Refraction","level":3,"type":"heading","text":"Refraction"},{"inlineContent":[{"type":"text","text":"Atmospheric refraction bends light, affecting apparent altitude:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"type":"codeListing"},{"anchor":"Computing-Refraction-Directly","level":3,"type":"heading","text":"Computing Refraction Directly"},{"inlineContent":[{"type":"text","text":"Calculate refraction angles independently of a coordinate conversion:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"],"type":"codeListing"},{"level":3,"text":"Aberration","type":"heading","anchor":"Aberration"},{"type":"paragraph","inlineContent":[{"text":"Light-time and stellar aberration affect apparent positions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"]},{"text"