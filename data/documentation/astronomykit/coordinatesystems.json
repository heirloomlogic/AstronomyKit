{"metadata":{"role":"article","title":"Coordinate Systems","roleHeading":"Article","modules":[{"name":"AstronomyKit"}]},"sections":[],"abstract":[{"type":"text","text":"Transform positions between different astronomical coordinate systems."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"anchor":"Position-Calculations","title":"Position Calculations","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"AstronomyKit supports multiple coordinate systems and provides rotation matrices for transforming between them. Understanding these systems is essential for precise astronomical work.","type":"text"}],"type":"paragraph"},{"anchor":"Coordinate-Systems","level":2,"text":"Coordinate Systems","type":"heading"},{"type":"heading","text":"Equatorial J2000 (EQJ)","level":3,"anchor":"Equatorial-J2000-EQJ"},{"type":"paragraph","inlineContent":[{"text":"The standard reference frame used by most star catalogs:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origin: Earth’s center"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Earth’s equator at J2000.0 epoch"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox at J2000.0"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"]},{"anchor":"Equatorial-of-Date-EQD","level":3,"text":"Equatorial of Date (EQD)","type":"heading"},{"inlineContent":[{"text":"Accounts for precession of Earth’s axis:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Same as EQJ but referenced to the current date"}]}]}],"type":"unorderedList"},{"code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"type":"codeListing","syntax":"swift"},{"text":"Ecliptic (ECL)","anchor":"Ecliptic-ECL","type":"heading","level":3},{"inlineContent":[{"text":"Referenced to the plane of Earth’s orbit:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Ecliptic (Earth’s orbital plane)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox"}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"]},{"text":"Horizontal (HOR)","anchor":"Horizontal-HOR","type":"heading","level":3},{"inlineContent":[{"text":"Local sky coordinates for an observer:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Altitude: Height above the horizon"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Azimuth: Compass direction from north","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"]},{"text":"Galactic (GAL)","anchor":"Galactic-GAL","type":"heading","level":3},{"inlineContent":[{"text":"Referenced to the Milky Way:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fundamental plane: Galactic plane"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary direction: Galactic center"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Available via rotation matrices (see below).","type":"text"}],"type":"paragraph"},{"text":"Rotation Matrices","anchor":"Rotation-Matrices","type":"heading","level":2},{"text":"Creating Rotation Matrices","anchor":"Creating-Rotation-Matrices","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"]},{"text":"Time-Dependent Rotations","anchor":"Time-Dependent-Rotations","type":"heading","level":3},{"inlineContent":[{"text":"Some transformations require a time for precession\/nutation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"]},{"text":"Applying Rotations","anchor":"Applying-Rotations","type":"heading","level":3},{"inlineContent":[{"text":"Transform a vector using a rotation matrix:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = try position.rotated(by: rotation)"]},{"text":"Matrix Operations","anchor":"Matrix-Operations","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = try forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: .z, angle: 45.0)  \/\/ 45° around Z"]},{"text":"Vector Types","anchor":"Vector-Types","type":"heading","level":2},{"text":"Vector3D","anchor":"Vector3D","type":"heading","level":3},{"inlineContent":[{"text":"A 3D Cartesian position vector:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"]},{"text":"StateVector","anchor":"StateVector","type":"heading","level":3},{"inlineContent":[{"text":"Position and velocity together:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"]},{"text":"Spherical Coordinates","anchor":"Spherical-Coordinates","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Spherical","type":"reference"},{"text":" type (latitude, longitude, distance) is produced by converting a position vector:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"]},{"text":"Atmospheric Effects","anchor":"Atmospheric-Effects","type":"heading","level":2},{"text":"Refraction","anchor":"Refraction","type":"heading","level":3},{"inlineContent":[{"text":"Atmospheric refraction bends light, affecting apparent altitude:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let body = CelestialBody.mars","","\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"]},{"text":"Computing Refraction Directly","anchor":"Computing-Refraction-Directly","type":"heading","level":3},{"inlineContent":[{"text":"Calculate refraction angles independently of a coordinate conversion:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"]},{"text":"Aberration","anchor":"Aberration","type":"heading","level":3},{"inlineContent":[{"text":"Light-time and stellar aberration affect apparent positions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let body = CelestialBody.mars","","\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"]},{"text":"Available Rotations","anchor":"Available-Rotations","type":"heading","level":2},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"From"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"To"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"EQJ"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"ECL"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"equatorialJ2000ToEcliptic()"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"ECL"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"EQJ"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"eclipticToEquatorialJ2000()"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"EQJ"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"EQD"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"equatorialJ2000ToEquatorialOfDate(at:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"EQD"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"EQJ"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"equatorialOfDateToEquatorialJ2000(at:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"EQJ"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"HOR"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"equatorialJ2000ToHorizon(at:from:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"HOR"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"EQJ"}],"type":"paragraph"}],[{"inlineContent":