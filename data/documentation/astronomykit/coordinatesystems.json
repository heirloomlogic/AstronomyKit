{"seeAlsoSections":[{"generated":true,"title":"Position Calculations","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialBody","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Observer","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Constellation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Aberration","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EquatorDate"],"anchor":"Position-Calculations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/coordinatesystems"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"AstronomyKit supports multiple coordinate systems and provides rotation matrices for transforming between them. Understanding these systems is essential for precise astronomical work."}],"type":"paragraph"},{"level":2,"anchor":"Coordinate-Systems","type":"heading","text":"Coordinate Systems"},{"level":3,"anchor":"Equatorial-J2000-EQJ","type":"heading","text":"Equatorial J2000 (EQJ)"},{"inlineContent":[{"type":"text","text":"The standard reference frame used by most star catalogs:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Origin: Earth’s center","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Fundamental plane: Earth’s equator at J2000.0 epoch","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Primary direction: Vernal equinox at J2000.0"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .j2000)","print(\"RA: \\(eq.rightAscension)h, Dec: \\(eq.declination)°\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Equatorial-of-Date-EQD","type":"heading","text":"Equatorial of Date (EQD)"},{"inlineContent":[{"text":"Accounts for precession of Earth’s axis:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Same as EQJ but referenced to the current date","type":"text"}]}]}],"type":"unorderedList"},{"code":["let eq = try CelestialBody.mars.equatorial(at: .now, equatorDate: .ofDate)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Ecliptic-ECL","type":"heading","text":"Ecliptic (ECL)"},{"inlineContent":[{"text":"Referenced to the plane of Earth’s orbit:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fundamental plane: Ecliptic (Earth’s orbital plane)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Primary direction: Vernal equinox","type":"text"}]}]}],"type":"unorderedList"},{"code":["let lon = try CelestialBody.jupiter.eclipticLongitude(at: .now)","print(\"Ecliptic longitude: \\(lon)°\")","","\/\/ Full ecliptic position","let sunPos = try Sun.position(at: .now)","print(\"λ: \\(sunPos.longitude)°, β: \\(sunPos.latitude)°\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Horizontal-HOR","type":"heading","text":"Horizontal (HOR)"},{"inlineContent":[{"text":"Local sky coordinates for an observer:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Altitude: Height above the horizon","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Azimuth: Compass direction from north","type":"text"}]}]}],"type":"unorderedList"},{"code":["let observer = Observer(latitude: 40.0, longitude: -74.0)","let hor = try CelestialBody.venus.horizon(at: .now, from: observer)","print(\"Alt: \\(hor.altitude)°, Az: \\(hor.azimuth)°\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Galactic-GAL","type":"heading","text":"Galactic (GAL)"},{"inlineContent":[{"text":"Referenced to the Milky Way:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fundamental plane: Galactic plane","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Primary direction: Galactic center","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Available via rotation matrices (see below).","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Rotation-Matrices","type":"heading","text":"Rotation Matrices"},{"level":3,"anchor":"Creating-Rotation-Matrices","type":"heading","text":"Creating Rotation Matrices"},{"code":["\/\/ Equatorial J2000 to Ecliptic","let eqjToEcl = try RotationMatrix.equatorialJ2000ToEcliptic()","","\/\/ Ecliptic to Equatorial J2000","let eclToEqj = try RotationMatrix.eclipticToEquatorialJ2000()","","\/\/ Equatorial J2000 to Galactic","let eqjToGal = try RotationMatrix.equatorialJ2000ToGalactic()"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Time-Dependent-Rotations","type":"heading","text":"Time-Dependent Rotations"},{"inlineContent":[{"text":"Some transformations require a time for precession\/nutation:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Equatorial J2000 to Equatorial of Date","let time = AstroTime.now","let eqjToEqd = try RotationMatrix.equatorialJ2000ToEquatorialOfDate(at: time)","","\/\/ Equatorial to Horizontal (requires time and observer)","let observer = Observer.greenwich","let eqjToHor = try RotationMatrix.equatorialJ2000ToHorizon(at: time, from: observer)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Applying-Rotations","type":"heading","text":"Applying Rotations"},{"inlineContent":[{"text":"Transform a vector using a rotation matrix:","type":"text"}],"type":"paragraph"},{"code":["let position = try CelestialBody.mars.geocentricPosition(at: .now)","let rotation = try RotationMatrix.equatorialJ2000ToEcliptic()","let eclipticPosition = position.rotated(by: rotation)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Matrix-Operations","type":"heading","text":"Matrix Operations"},{"code":["\/\/ Identity (no rotation)","let identity = RotationMatrix.identity","","\/\/ Inverse (reverse rotation)","let forward = try RotationMatrix.equatorialJ2000ToEcliptic()","let reverse = forward.inverse","","\/\/ Combine rotations","let combined = try forward.combined(with: anotherRotation)","","\/\/ Pivot around an axis","let rotated = try RotationMatrix.pivot(axis: 2, angle: 45.0)  \/\/ 45° around Z"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Vector-Types","type":"heading","text":"Vector Types"},{"level":3,"anchor":"Vector3D","type":"heading","text":"Vector3D"},{"inlineContent":[{"text":"A 3D Cartesian position vector:","type":"text"}],"type":"paragraph"},{"code":["let pos = try CelestialBody.jupiter.geocentricPosition(at: .now)","print(\"X: \\(pos.x) AU\")","print(\"Y: \\(pos.y) AU\")","print(\"Z: \\(pos.z) AU\")","print(\"Magnitude: \\(pos.magnitude) AU\")","","\/\/ Normalize to unit vector","let direction = pos.normalized"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"StateVector","type":"heading","text":"StateVector"},{"inlineContent":[{"text":"Position and velocity together:","type":"text"}],"type":"paragraph"},{"code":["let state = try observer.state(at: .now)","print(\"Position: \\(state.position)\")","print(\"Velocity: \\(state.velocity)\")  \/\/ AU\/day"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Spherical-Coordinates","type":"heading","text":"Spherical Coordinates"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Spherical"},{"text":" type (latitude, longitude, distance) is produced by converting","type":"text"},{"text":" ","type":"text"},{"text":"a position vector:","type":"text"}],"type":"paragraph"},{"code":["let vector = try CelestialBody.mars.geocentricPosition(at: .now)","let spherical = vector.toSpherical()","print(\"Longitude: \\(spherical.longitude)°\")","print(\"Latitude: \\(spherical.latitude)°\")","print(\"Distance: \\(spherical.distance) AU\")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Atmospheric-Effects","type":"heading","text":"Atmospheric Effects"},{"level":3,"anchor":"Refraction","type":"heading","text":"Refraction"},{"inlineContent":[{"text":"Atmospheric refraction bends light, affecting apparent altitude:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Normal refraction correction (default)","let apparent = try body.horizon(at: .now, from: observer, refraction: .normal)","","\/\/ No refraction (geometric position)","let geometric = try body.horizon(at: .now, from: observer, refraction: .none)","","\/\/ JPL Horizons refraction model","let jpl = try body.horizon(at: .now, from: observer, refraction: .jplHorizons)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Computing-Refraction-Directly","type":"heading","text":"Computing Refraction Directly"},{"inlineContent":[{"text":"Calculate refraction angles independently of a coordinate conversion:","type":"text"}],"type":"paragraph"},{"code":["\/\/ How much does refraction raise an object at 5° geometric altitude?","let offset = Refraction.normal.refractionAngle(at: 5.0)","print(\"Refraction at 5°: +\\(offset)°\")","","\/\/ Given an apparent altitude of 5°, what was the geometric altitude?","let inverse = Refraction.normal.inverseRefractionAngle(at: 5.0)","let geometric = 5.0 - inverse"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Aberration","type":"heading","text":"Aberration"},{"inlineContent":[{"text":"Light-time and stellar aberration affect apparent positions:","type":"text"}],"type":"paragraph"},{"code":["\/\/ With aberration correction (default) - what you actually see","let apparent = try body.geocentricPosition(at: .now, aberration: .corrected)","","\/\/ Without correction - geometric position","let geometric = try body.geocentricPosition(at: .now, aberration: .none)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Available-Rotations","type":"heading","text":"Avail