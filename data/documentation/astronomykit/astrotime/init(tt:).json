ial "},{"type":"codeVoice","code":"ut = tt"},{"text":" ","type":"text"},{"type":"text","text":"estimate. Because "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" stores UT, encoding a gap-clamped value and"},{"text":" ","type":"text"},{"text":"decoding it derives TT again from the selected model.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Nonfinite or nonconvergent input produces an invalid time with NaN fields."}],"type":"paragraph"}]}],"metadata":{"role":"symbol","externalID":"s:12AstronomyKit9AstroTimeV2ttACSd_tcfc","symbolKind":"init","modules":[{"name":"AstronomyKit"}],"roleHeading":"Initializer","title":"init(tt:)","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"tt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":")","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime"]]},"kind":"symbol","sections":[],"references":{"doc://AstronomyKit/documentation/AstronomyKit/AstroTime/init(tt:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"tt"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":")"}],"url":"\/documentation\/astronomykit\/astrotime\/init(tt:)","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime\/init(tt:)","abstract":[{"text":"Creates a time from Terrestrial Time days since J2000.","type":"text"}],"type":"topic","role":"symbol","title":"init(tt:)","kind":"symbol"},"https://github.com/cosinekitty/astronomy":{"type":"link","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","url":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","titleInlineContent":[{"text":"Astronomy Engine","type":"text"}]},"doc://AstronomyKit/documentation/As