{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chiron"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Chiron is a minor planet (centaur) orbiting between Saturn and Uranus.","type":"text"},{"text":" ","type":"text"},{"text":"Since Astronomy Engine doesn’t include Chiron as a built-in body,","type":"text"},{"text":" ","type":"text"},{"text":"positions are calculated using gravity simulation with pre-computed","type":"text"},{"text":" ","type":"text"},{"text":"state vectors from JPL Horizons.","type":"text"}]},{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Chiron’s position is computed by:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Selecting the nearest reference epoch to the requested time"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Initializing a gravity simulation at that epoch"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Propagating to the requested time","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Converting to the desired coordinate system"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Accuracy","text":"Accuracy"},{"type":"paragraph","inlineContent":[{"text":"Accuracy is highest near the reference epochs (2000, 2010, 2020, 2030, 2040)","type":"text"},{"text":" ","type":"text"},{"text":"and degrades slightly as distance from these epochs increases due to","type":"text"},{"text":" ","type":"text"},{"text":"numerical integration er