"text","text":"numerical integration error. For typical usage within ±5 years of an epoch,"},{"type":"text","text":" "},{"type":"text","text":"error is expected to be less than 1 arcminute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculations are supported for years 1900 through 2150. Integration error"},{"type":"text","text":" "},{"type":"text","text":"grows with distance from the reference epochs, so times outside this range"},{"type":"text","text":" "},{"type":"text","text":"throw "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/badTime","isActive":true},{"type":"text","text":"."}]},{"level":2,"anchor":"Example","text":"Example","type":"heading"},{"code":["\/\/ Get Chiron's ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","print(\"Chiron is at \\(longitude)°\")","","\/\/ Get Chiron's geocentric position","let position = try Chiron.geocentricPosition(at: .now)","print(\"Chiron position: \\(position)\")"],"syntax":"swift","type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"references":{"doc://AstronomyKit/documentation/AstronomyKit/RotationAxis":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RotationAxis","kind":"identifier"}],"type":"topic","title":"RotationAxis","abstract":[{"text":"Information about a body’s rotation axis orientation.","type":"text"}],"role":"symbol","url":"\/documentation\/astronomykit\/rotationaxis","kind":"symbol","navigatorTitle":[{"text":"RotationAxis","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/GravitySimulation":{"title":"GravitySimulation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"GravitySimulation"}],"type":"topic","role":"symbol","url":"\/documentation\/astronomykit\/gravitysimul