ochs increases due to"},{"type":"text","text":" "},{"type":"text","text":"numerical integration error. For typical usage within ±5 years of an epoch,"},{"type":"text","text":" "},{"type":"text","text":"error is expected to be less than 1 arcminute."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calculations are supported for years 1900 through 2150. Integration error"},{"type":"text","text":" "},{"type":"text","text":"grows with distance from the reference epochs, so times outside this range"},{"type":"text","text":" "},{"type":"text","text":"throw "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/badTime","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Example","anchor":"Example","type":"heading","level":2},{"type":"codeListing","code":["\/\/ Get Chiron's ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","print(\"Chiron is at \\(longitude)°\")","","\/\/ Get Chiron's geocentric position","let position = try Chiron.geocentricPosition(at: .now)","print(\"Chiron position: \\(position)\")"],"syntax":"swift"}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/LagrangePointID":{"url":"\/documentation\/astronomykit\/lagrangepointid","title":"LagrangePointID","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LagrangePointID"}],"navigatorTitle":[{"kind":"identifier","text":"LagrangePointID"}],"abstract":[{"type":"text","text":"Identifies one of the five Lagrange points."}],"kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Jupiter":{"url":"\/documentation\/astronomykit\/jupiter","title":"Jupiter","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Jupiter"}],"navigatorTitle":[{"kind":"identifier","text