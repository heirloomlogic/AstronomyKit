{"abstract":[{"type":"text","text":"Predict lunar and solar eclipses with detailed timing information."}],"metadata":{"modules":[{"name":"AstronomyKit"}],"role":"article","title":"Eclipses","roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit can search for and predict lunar eclipses, global solar eclipses, and local solar eclipse visibility for specific observer locations.","type":"text"}]},{"type":"heading","text":"Lunar Eclipses","anchor":"Lunar-Eclipses","level":2},{"type":"heading","text":"Finding the Next Lunar Eclipse","anchor":"Finding-the-Next-Lunar-Eclipse","level":3},{"type":"codeListing","syntax":"swift","code":["let eclipse = try Eclipse.searchLunar(after: .now)","print(\"\\(eclipse.kind.name) lunar eclipse at \\(eclipse.peak)\")"]},{"type":"heading","text":"Eclipse Types","anchor":"Eclipse-Types","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Penumbral","type":"text"}],"type":"strong"},{"text":": Moon passes through Earth’s outer shadow","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Partial","type":"text"}],"type":"strong"},{"text":": Part of Moon enters Earth’s umbra","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Total","type":"text"}],"type":"strong"},{"text":": Entire Moon enters Earth’s umbra","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["switch eclipse.kind {","case .total:","    print(\"Total lunar eclipse!\")","case .partial:","    print(\"Partial lunar eclipse\")","case .penumbral:","    