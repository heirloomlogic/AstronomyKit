{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit can search for and predict lunar eclipses, global solar eclipses, and local solar eclipse visibility for specific observer locations.","type":"text"}]},{"type":"heading","level":2,"text":"Lunar Eclipses","anchor":"Lunar-Eclipses"},{"type":"heading","level":3,"text":"Finding the Next Lunar Eclipse","anchor":"Finding-the-Next-Lunar-Eclipse"},{"syntax":"swift","type":"codeListing","code":["let eclipse = try Eclipse.searchLunar(after: .now)","print(\"\\(eclipse.kind.name) lunar eclipse at \\(eclipse.peak)\")"]},{"level":3,"anchor":"Eclipse-Types","type":"heading","text":"Eclipse Types"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Penumbral: the Moon passes through Earth’s outer shadow","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Partial: part of the Moon enters Earth’s umbra","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Total: the entire Moon enters Earth’s umbra","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["switch eclipse.kind {","case .total:","    print(\"Total lunar eclipse!\")","case .partial:","    print(\"Partial lunar eclipse\")","case .penumbral:","    print(\"Penumbral lunar eclipse\")","default:","    break","}"],"type":"codeListing"},{"type":"heading","text":"Eclipse Timing","anchor":"Eclipse-Timing","level":3},{"syntax":"swift","code":["let eclipse = try Eclipse.searchLunar(after: .now)","","print(\"Peak: \\(eclipse.peak)\")","print(\"Partial duration: \\(eclipse.partialDuration) minutes\")","print(\"Total duration: \\(eclipse.totalDuration) minutes\")  \/\/ 0 if not total","print(\"Penumbral duration: \\(eclipse.penumbralDuration) minutes\")"],"type":"codeListing"},{"type":"heading","text":"All Eclipses in a Date Range","anchor":"All-Eclipses-in-a-Date-Range","level":3},{"syntax":"swift","code":["let eclipses = try Eclipse.lunarEclipses(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2026, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name) on \\(eclipse.peak)\")","}"],"type":"codeListing"},{"type":"heading","text":"Global Solar Eclipses","anchor":"Global-Solar-Eclipses","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Global solar eclipses describe an eclipse as seen from anywhere on Earth."}]},{"type":"heading","text":"Finding the Next Solar Eclipse","anchor":"Finding-the-Next-Solar-Eclipse","level":3},{"syntax":"swift","code":["let eclipse = try Eclipse.searchGlobalSolar(after: .now)","print(\"\\(eclipse.kind.name) solar eclipse at \\(eclipse.peak)\")","","\/\/ For total or annular eclipses, get the center line","if eclipse.kind == .total || eclipse.kind == .annular {","    if let lat = eclipse.latitude, let lon = eclipse.longitude {","        print(\"Path center: \\(lat)°, \\(lon)°\")","    }","}"],"type":"codeListing"},{"type":"heading","text":"Eclipse Types","anchor":"Eclipse-Types","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Partial: only part of the Sun is covered"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Annular: the Moon is too far away to cover the Sun, leaving a ring","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Total: the Moon covers the Sun completely"}]}]}],"type":"unorderedList"},{"type":"heading","text":"All Solar Eclipses in a Range","anchor":"All-Solar-Eclipses-in-a-Range","level":3},{"syntax":"swift","code":["let eclipses = try Eclipse.globalSolarEclipses(","    from: AstroTime(year: 2024, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name): \\(eclipse.peak)\")","}"],"type":"codeListing"},{"type":"heading","text":"Local Solar Eclipses","anchor":"Local-Solar-Eclipses","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Local solar eclipses describe what an observer at a specific location will see."}]},{"text":"Eclipse for Your Location","level":3,"anchor":"Eclipse-for-Your-Location","type":"heading"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Type: \\(eclipse.kind.name)\")","print(\"Obscuration: \\(Int(eclipse.obscuration * 100))%\")"],"type":"codeListing"},{"text":"Detailed Timing","level":3,"anchor":"Detailed-Timing","type":"heading"},{"syntax":"swift","code":["let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Partial begins: \\(eclipse.partialBegin.time)\")","print(\"Peak: \\(eclipse.peak.time)\")","print(\"Partial ends: \\(eclipse.partialEnd.time)\")","","\/\/ For total\/annular eclipses","if let totalBegin = eclipse.totalBegin,","   let totalEnd = eclipse.totalEnd {","    print(\"Totality: \\(totalBegin.time) to \\(totalEnd.time)\")","}"],"type":"codeListing"},{"text":"Eclipse Visibility","level":3,"anchor":"Eclipse-Visibility","type":"heading"},{"inlineContent":[{"type":"text","text":"Each event includes altitude information:"}],"type":"paragraph"},{"syntax":"swift","code":["let event = eclipse.peak","print(\"Time: \\(event.time)\")","print(\"Sun altitude: \\(event.altitude)°\")","","if event.isVisible {","    print(\"Sun is above the horizon\")","}","","if eclipse.isVisible {","    print(\"At least part of the eclipse is visible\")","}"],"type":"codeListing"},{"text":"All Local Eclipses in a Range","level":3,"anchor":"All-Local-Eclipses-in-a-Range","type":"heading"},{"syntax":"swift","code":["let observer = Observer(latitude: 35.0, longitude: -120.0)","let eclipses = try Eclipse.localSolarEclipses(","    from: .now,","    to: .now.addingDays(365 * 10),","    observer: observer",")","","for eclipse in eclipses {","    if eclipse.obscuration > 0.5 {","        print(\"Notable eclipse: \\(Int(eclipse.obscuration * 100))% on \\(eclipse.peak.time)\")","    }","}"],"type":"codeListing"},{"text":"Eclipse Search Tips","level":2,"anchor":"Eclipse-Search-Tips","type":"heading"},{"inlineContent":[{"type":"text","text":"Eclipses are rare, so search years ahead. A local eclipse can occur while the Sun is below the horizon, so check "},{"type":"codeVoice","code":"isVisible"},{"type":"text","text":" before announcing one. Partial eclipses with high obscuration are often worth reporting."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses"},"seeAlsoSections":[{"generated":true,"anchor":"Events","title":"Events","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseEvent","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Apsis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/ApsisKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Elongation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Visibility"]}],"abstract":[{"type":"text","text":"Predict lunar and solar eclipses with detailed timing information."}],"kind":"article","variants":[{"traits"