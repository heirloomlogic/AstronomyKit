":"Lunar Eclipses","anchor":"Lunar-Eclipses","type":"heading"},{"level":3,"text":"Finding the Next Lunar Eclipse","anchor":"Finding-the-Next-Lunar-Eclipse","type":"heading"},{"syntax":"swift","code":["let eclipse = try Eclipse.searchLunar(after: .now)","print(\"\\(eclipse.kind.name) lunar eclipse at \\(eclipse.peak)\")"],"type":"codeListing"},{"level":3,"text":"Eclipse Types","anchor":"Eclipse-Types","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Penumbral","type":"text"}],"type":"strong"},{"text":": Moon passes through Earth’s outer shadow","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Partial","type":"text"}],"type":"strong"},{"text":": Part of Moon enters Earth’s umbra","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Total","type":"text"}],"type":"strong"},{"text":": Entire Moon enters Earth’s umbra","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["switch eclipse.kind {","case .total:","    print(\"Total lunar eclipse!\")","case .partial:","    print(\"Partial lunar eclipse\")","case .penumbral:","    print(\"Penumbral lunar eclipse\")","default:","    break","}"],"type":"codeListing"},{"level":3,"text":"Eclipse Timing","anchor":"Eclipse-Timing","type":"heading"},{"syntax":"swift","code":["let eclipse = try Eclipse.searchLunar(after: .now)","","print(\"Peak: \\(eclipse.peak)\")","print(\"Partial duration: \\(eclipse.partialDuration) minutes\")","print(\"Total duration: \\(eclipse.totalDuration) minutes\")  \/\/ 0 if not total","print(\"Penumbral duration: \\(eclipse.penumbralDuration) minutes\")"],"type":"codeListing"},{"level":3,"text":"All Eclipses in a Date Range","anchor":"All-Eclipses-in-a-Date-Range","type":"heading"},{"syntax":"swift","code":["let eclipses = try Eclipse.lunarEclipses(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2026, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name) on \\(eclipse.peak)\")","}"],"type":"codeListing"},{"level":2,"text":"Global Solar Eclipses","anchor":"Global-Solar-Eclipses","type":"heading"},{"inlineContent":[{"type":"text","text":"Global solar eclipses describe an eclipse as seen from anywhere on Earth."}],"type":"paragraph"},{"level":3,"text":"Finding the Next Solar Eclipse","anchor":"Finding-the-Next-Solar-Eclipse","type":"heading"},{"syntax":"swift","code":["let eclipse = try Eclipse.searchGlobalSolar(after: .now)","print(\"\\(eclipse.kind.name) solar eclipse at \\(eclipse.peak)\")","","\/\/ For total or annular eclipses, get the center line","if eclipse.kind == .total || eclipse.kind == .annular {","    if let lat = eclipse.latitude, let lon = eclipse.longitude {","        print(\"Path center: \\(lat)°, \\(lon)°\")","    }","}"],"type":"codeListing"},{"level":3,"text":"Eclipse Types","anchor":"Eclipse-Types","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Partial","type":"text"}],"type":"strong"},{"text":": Only part of the Sun is covered","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Annular","type":"text"}],"type":"strong"},{"text":": Moon is too far to fully cover the Sun (ring of fire)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Total","type":"text"}],"type":"strong"},{"text":": Moon completely covers the Sun","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"All Solar Eclipses in a Range","anchor":"All-Solar-Eclipses-in-a-Range","type":"heading"},{"syntax":"swift","code":["let eclipses = try Eclipse.globalSolarEclipses(","    from: AstroTime(year: 2024, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name): \\(eclipse.peak)\")","}"],"type":"codeListing"},{"level":2,"text":"Local Solar Eclipses","anchor":"Local-Solar-Eclipses","type":"heading"},{"inlineContent":[{"type":"text","text":"Local solar eclipses describe what an observer at a specific location will see."}],"type":"paragraph"},{"level":3,"text":"Eclipse for Your Location","anchor":"Eclipse-for-Your-Location","type":"heading"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Type: \\(eclipse.kind.name)\")","print(\"Obscuration: \\(Int(eclipse.obscuration * 100))%\")"],"type":"codeListing"},{"level":3,"text":"Detailed Timing","anchor":"Detailed-Timing","type":"heading"},{"syntax":"swift","code":["let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Partial begins: \\(eclipse.partialBegin.time)\")","print(\"Peak: \\(eclipse.peak.time)\")","print(\"Partial ends: \\(eclipse.partialEnd.time)\")","","\/\/ For total\/annular eclipses","if let totalBegin = eclipse.totalBegin,","   let totalEnd = eclipse.totalEnd {","    print(\"Totality: \\(totalBegin.time) to \\(totalEnd.time)\")","}"],"type":"codeListing"},{"level":3,"text":"Eclipse Visibility","anchor":"Eclipse-Visibility","type":"heading"},{"inlineContent":[{"type":"text","text":"Each event includes altitude information:"}],"type":"paragraph"},{"syntax":"swift","code":["let event = eclipse.peak","print(\"Time: \\(event.time)\")","print(\"Sun altitude: \\(event.altitude)°\")","","if event.isVisible {","    print(\"Sun is above the horizon\")","}","","if eclipse.isVisible {","    print(\"At least part of the eclipse is visible\")","}"],"type":"codeListing"},{"level":3,"text":"All Local Eclipses in a Range","anchor":"All-Local-Eclipses-in-a-Range","type":"heading"},{"syntax":"swift","code":["let observer = Observer(latitude: 35.0, longitude: -120.0)","let eclipses = try Eclipse.localSolarEclipses(","    from: .now,","    to: .now.addingDays(365 * 10),","    observer: observer",")","","for eclipse in eclipses {","    if eclipse.obscuration > 0.5 {","        print(\"Notable eclipse: \\(Int(eclipse.obscuration * 100))% on \\(eclipse.peak.time)\")","    }","}"],"type":"codeListing"},{"level":2,"text":"Eclipse Search Tips","anchor":"Eclipse-Search-Tips","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Search far ahead","type":"text"}],"type":"strong"},{"text":": Eclipses are rare—search years in advance","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Check visibility","type":"text"}],"type":"strong"},{"text":": Local eclipses may occur when the Sun is below the horizon","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Consider obscuration","type":"text"}],"type":"strong"},{"text":": Even partial eclipses can be interesting when obscuration is high","type":"text"}]}]}],"type":"orderedList"}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/EclipseKind":{"kind":"symbol","abstract":[{"text":"The type of eclipse.","type":"text"}],"url":"\/documentation\/astronomykit\/eclipsekind","navigatorTitle":[{"text":"EclipseKind","kind":"identifier"}],"title":"EclipseKind","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EclipseKind","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseKind","type":"topic","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/EclipseEvent":{"kind":"symbol","abstract":[{"text":"A specific moment during an eclipse with the Sun’s altitude.","type":"text"}],"url":"\/documentation\/astronomykit\/eclipseevent","navigatorTitle":[{"text":"EclipseEvent","kind":"identifier"}],"title":"EclipseEvent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EclipseEvent","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseEvent","ty