"anchor":"Eclipse-Types","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Partial","type":"text"}],"type":"strong"},{"text":": Only part of the Sun is covered","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Annular","type":"text"}],"type":"strong"},{"text":": Moon is too far to fully cover the Sun (ring of fire)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Total","type":"text"}],"type":"strong"},{"text":": Moon completely covers the Sun","type":"text"}]}]}]},{"type":"heading","text":"All Solar Eclipses in a Range","anchor":"All-Solar-Eclipses-in-a-Range","level":3},{"type":"codeListing","syntax":"swift","code":["let eclipses = try Eclipse.globalSolarEclipses(","    from: AstroTime(year: 2024, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name): \\(eclipse.peak)\")","}"]},{"type":"heading","text":"Local Solar Eclipses","anchor":"Local-Solar-Eclipses","level":2},{"type":"paragraph","inlineContent":[{"text":"Local solar eclipses describe what an observer at a specific location will see.","type":"text"}]},{"type":"heading","text":"Eclipse for Your Location","anchor":"Eclipse-for-Your-Location","level":3},{"type":"codeListing","syntax":"swift","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Type: \\(eclipse.kind.name)\")","print(\"Obscuration: \\(Int(eclipse.obscuration * 100))%\")"]},{"type":"heading","text":"Detailed Timing","anchor":"Detailed-Timing","level":3},{"type":"codeListing","syntax":"swift","code":["let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Partial begins: \\(eclipse.partialBegin.time)\")","print(\"Peak: \\(eclipse.peak.time)\")","print(\"Partial ends: \\(eclipse.partialEnd.time)\")","","\/\/ For total\/annular eclipses","if let totalBegin = eclipse.totalBegin,","   let totalEnd = eclipse.totalEnd {","    print(\"Totality: \\(totalBegin.time) to \\(totalEnd.time)\")","}"]},{"type":"heading","text":"Eclipse Visibility","anchor":"Eclipse-Visibility","level":3},{"type":"paragraph","inlineContent":[{"text":"Each event includes altitude information:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let event = eclipse.peak","print(\"Time: \\(event.time)\")","print(\"Sun altitude: \\(event.altitude)°\")","","if event.isVisible {","    print(\"Sun is above the horizon\")","}","","if eclipse.isVisible {","    print(\"At least part of the eclipse is visible\")","}"]},{"type":"heading","text":"All Local Eclipses in a Range","anchor":"All-Local-Eclipses-in-a-Range","level":3},{"type":"codeListing","syntax":"swift","code":["let observer = Observer(latitude: 35.0, longitude: -120.0)","let eclipses = try Eclipse.localSolarEclipses(","    from: .now,","    to: .now.addingDays(365 * 10),","    observer: observer",")","","for eclipse in eclipses {","    if eclipse.obscuration > 0.5 {","        print(\"Notable eclipse: \\(Int(eclipse.obscuration * 100))% on \\(eclipse.peak.time)\")","    }","}"]},{"type":"heading","text":"Eclipse Search Tips","level":2,"anchor":"Eclipse-Search-Tips"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Search years in advance, since eclipses are rare at any single location."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check "},{"code":"isVisible","type":"codeVoice"},{"type":"text","text":" on local solar eclipses because an eclipse can occur while the Sun is below the horizon."}]}]},{"content":[{"inlineContent":[{"text":"Check ","type":"text"},{"type":"codeVoice","code":"obscuration"},{"type":"text","text":" to filter for partial eclipses with meaningful coverage."}],"type":"paragraph"}]}]}]}],"schem