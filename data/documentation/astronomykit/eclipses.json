{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"AstronomyKit can search for and predict lunar eclipses, global solar eclipses, and local solar eclipse visibility for specific observer locations."}],"type":"paragraph"},{"text":"Lunar Eclipses","level":2,"anchor":"Lunar-Eclipses","type":"heading"},{"text":"Finding the Next Lunar Eclipse","level":3,"anchor":"Finding-the-Next-Lunar-Eclipse","type":"heading"},{"code":["let eclipse = try Eclipse.searchLunar(after: .now)","print(\"\\(eclipse.kind.name) lunar eclipse at \\(eclipse.peak)\")"],"syntax":"swift","type":"codeListing"},{"text":"Eclipse Types","level":3,"anchor":"Eclipse-Types","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Penumbral"}],"type":"strong"},{"text":": Moon passes through Earth’s outer shadow","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Partial"}],"type":"strong"},{"text":": Part of Moon enters Earth’s umbra","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Total"}],"type":"strong"},{"text":": Entire Moon enters Earth’s umbra","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["switch eclipse.kind {","case .total:","    print(\"Total lunar eclipse!\")","case .partial:","    print(\"Partial lunar eclipse\")","case .penumbral:","    print(\"Penumbral lunar eclipse\")","default:","    break","}"],"syntax":"swift","type":"codeListing"},{"text":"Eclipse Timing","level":3,"anchor":"Eclipse-Timing","type":"heading"},{"code":["let eclipse = try Eclipse.searchLunar(after: .now)","","print(\"Peak: \\(eclipse.peak)\")","print(\"Partial duration: \\(eclipse.partialDuration) minutes\")","print(\"Total duration: \\(eclipse.totalDuration) minutes\")  \/\/ 0 if not total","print(\"Penumbral duration: \\(eclipse.penumbralDuration) minutes\")"],"syntax":"swift","type":"codeListing"},{"text":"All Eclipses in a Date Range","level":3,"anchor":"All-Eclipses-in-a-Date-Range","type":"heading"},{"code":["let eclipses = try Eclipse.lunarEclipses(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2026, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name) on \\(eclipse.peak)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Global Solar Eclipses","level":2,"anchor":"Global-Solar-Eclipses","type":"heading"},{"inlineContent":[{"type":"text","text":"Global solar eclipses describe an eclipse as seen from anywhere on Earth."}],"type":"paragraph"},{"text":"Finding the Next Solar Eclipse","level":3,"anchor":"Finding-the-Next-Solar-Eclipse","type":"heading"},{"code":["let eclipse = try Eclipse.searchGlobalSolar(after: .now)","print(\"\\(eclipse.kind.name) solar eclipse at \\(eclipse.peak)\")","","\/\/ For total or annular eclipses, get the center line","if eclipse.kind == .total || eclipse.kind == .annular {","    if let lat = eclipse.latitude, let lon = eclipse.longitude {","        print(\"Path center: \\(lat)°, \\(lon)°\")","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Eclipse Types","level":3,"anchor":"Eclipse-Types","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Partial"}],"type":"strong"},{"text":": Only part of the Sun is covered","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Annular"}],"type":"strong"},{"text":": Moon is too far to fully cover the Sun (ring of fire)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Total"}],"type":"strong"},{"text":": Moon completely covers the Sun","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"All Solar Eclipses in a Range","level":3,"anchor":"All-Solar-Eclipses-in-a-Range","type":"heading"},{"code":["let eclipses = try Eclipse.globalSolarEclipses(","    from: AstroTime(year: 2024, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name): \\(eclipse.peak)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Local Solar Eclipses","level":2,"anchor":"Local-Solar-Eclipses","type":"heading"},{"inlineContent":[{"type":"text","text":"Local solar eclipses describe what an observer at a specific location will see."}],"type":"paragraph"},{"text":"Eclipse for Your Location","level":3,"anchor":"Eclipse-for-Your-Location","type":"heading"},{"code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Type: \\(eclipse.kind.name)\")","print(\"Obscuration: \\(Int(eclipse.obscuration * 100))%\")"],"syntax":"swift","type":"codeListing"},{"text":"Detailed Timing","level":3,"anchor":"Detailed-Timing","type":"heading"},{"code":["let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Partial begins: \\(eclipse.partialBegin.time)\")","print(\"Peak: \\(eclipse.peak.time)\")","print(\"Partial ends: \\(eclipse.partialEnd.time)\")","","\/\/ For total\/annular eclipses","if let totalBegin = eclipse.totalBegin,","   let totalEnd = eclipse.totalEnd {","    print(\"Totality: \\(totalBegin.time) to \\(totalEnd.time)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Eclipse Visibility","level":3,"anchor":"Eclipse-Visibility","type":"heading"},{"inlineContent":[{"type":"text","text":"Each event includes altitude information:"}],"type":"paragraph"},{"code":["let event = eclipse.peak","print(\"Time: \\(event.time)\")","print(\"Sun altitude: \\(event.altitude)°\")","","if event.isVisible {","    print(\"Sun is above the horizon\")","}","","if eclipse.isVisible {","    print(\"At least part of the eclipse is visible\")","}"],"syntax":"swift","type":"codeListing"},{"text":"All Local Eclipses in a Range","level":3,"anchor":"All-Local-Eclipses-in-a-Range","type":"heading"},{"code":["let observer = Observer(latitude: 35.0, longitude: -120.0)","let eclipses = try Eclipse.localSolarEclipses(","    from: .now,","    to: .now.addingDays(365 * 10),","    observer: observer",")","","for eclipse in eclipses {","    if eclipse.obscuration > 0.5 {","        print(\"Notable eclipse: \\(Int(eclipse.obscuration * 100))% on \\(eclipse.peak.time)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Eclipse Search Tips","level":2,"anchor":"Eclipse-Search-Tips","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Search far ahead"}]},{"type":"text","text":": Eclipses are rare—search years in advance"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Check visibility"}],"type":"strong"},{"type":"text","text":": Local eclipses may occur when the Sun is below the horizon"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Consider obscuration"}]},{"type":"text","text":": Even partial eclipses can be interesting when obscuration is high"}]}]}],"type":"orderedList"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"seeAlsoSections":[{"generated":true,"anchor":"Events","title":"Events","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclip