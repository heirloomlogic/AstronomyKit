 {","    print(\"\\(eclipse.kind.name) on \\(eclipse.peak)\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Global-Solar-Eclipses","text":"Global Solar Eclipses","type":"heading"},{"inlineContent":[{"text":"Global solar eclipses describe an eclipse as seen from anywhere on Earth.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Finding-the-Next-Solar-Eclipse","text":"Finding the Next Solar Eclipse","type":"heading"},{"code":["let eclipse = try Eclipse.searchGlobalSolar(after: .now)","print(\"\\(eclipse.kind.name) solar eclipse at \\(eclipse.peak)\")","","\/\/ For total or annular eclipses, get the center line","if eclipse.kind == .total || eclipse.kind == .annular {","    if let lat = eclipse.latitude, let lon = eclipse.longitude {","        print(\"Path center: \\(lat)°, \\(lon)°\")","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Eclipse-Types","text":"Eclipse Types","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Partial"}]},{"type":"text","text":": Only part of the Sun is covered"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Annular","type":"text"}]},{"type":"text","text":": Moon is too far to fully cover the Sun (ring of fire)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Total","type":"text"}]},{"text":": Moon completely covers the Sun","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"anchor":"All-Solar-Eclipses-in-a-Range","text":"All Solar Eclipses in a Range","type":"heading"},{"code":["let eclipses = try Eclipse.globalSolarEclipses(","    from: AstroTime(year: 2024, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for eclipse in eclipses {","    print(\"\\(eclipse.kind.name): \\(eclipse.peak)\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Local-Solar-Eclipses","text":"Local Solar Eclipses","type":"heading"},{"inlineContent":[{"text":"Local solar eclipses describe what an observer at a specific location will see.","type":"text"}],"type":"paragraph"},{"anchor":"Eclipse-for-Your-Location","level":3,"type":"heading","text":"Eclipse for Your Location"},{"code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Type: \\(eclipse.kind.name)\")","print(\"Obscuration: \\(Int(eclipse.obscuration * 100))%\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Detailed-Timing","level":3,"type":"heading","text":"Detailed Timing"},{"code":["let eclipse = try Eclipse.searchLocalSolar(after: .now, from: observer)","","print(\"Partial begins: \\(eclipse.partialBegin.time)\")","print(\"Peak: \\(eclipse.peak.time)\")","print(\"Partial ends: \\(eclipse.partialEnd.time)\")","","\/\/ For total\/annular eclipses","if let totalBegin = eclipse.totalBegin,","   let totalEnd = eclipse.totalEnd {","    print(\"Totality: \\(totalBegin.time) to \\(totalEnd.time)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Eclipse-Visibility","level":3,"type":"heading","text":"Eclipse Visibility"},{"inlineContent":[{"type":"text","text":"Each event includes altitude information:"}],"type":"paragraph"},{"code":["let event = eclipse.peak","print(\"Time: \\(event.time)\")","print(\"Sun altitude: \\(event.altitude)°\")","","if event.isVisible {","    print(\"Sun is above the horizon\")","}","","if eclipse.isVisible {","    print(\"At least part of the eclipse is visible\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"All-Local-Eclipses-in-a-Range","level":3,"type":"heading","text":"All Local Eclipses in a Range"},{"code":["let observer = Observer(latitude: 35.0, longitude: -120.0)","let eclipses = try Eclipse.localSolarEclipses(","    from: .now,","    to: .now.addingDays(365 * 10),","    observer: observer",")","","for eclipse in eclipses {","   