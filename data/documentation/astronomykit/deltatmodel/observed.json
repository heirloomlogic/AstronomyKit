{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"observed","kind":"identifier"}],"roleHeading":"Case","role":"symbol","modules":[{"name":"AstronomyKit"}],"title":"DeltaTModel.observed","symbolKind":"case","externalID":"s:12AstronomyKit11DeltaTModelO8observedyA2CmF"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"observed","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"],"kind":"mentions"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"From 1962 through 2027, a yearly table of International Earth Rotation","type":"text"},{"text":" ","type":"text"},{"text":"and Reference Systems Service (IERS) values, within 0.09 seconds of","type":"text"},{"text":" ","type":"text"},{"text":"the daily series. Before 1962, the Espenak-Meeus model, joined to the","type":"text"},{"text":" ","type":"text"},{"text":"table without a jump. After 2027, the last yearly rate continues and","type":"text"},{"text":" ","type":"text"},{"text":"blends into the long-term parabola, which applies alone from 2150. The","type":"text"},{"text":" ","type":"text"},{"text":"Earth’s rotation cannot be predicted for more than a year or so, so","type":"text"},{"text":" ","type":"text"},{"text":"expect errors of about half a second three years past the table and","type":"text"},{"text":" ","type":"text"},{"text":"more after that.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/astronomykit\/deltatmodel\/observed"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel"]]},"sections":[],"