{"metadata":{"roleHeading":"Case","modules":[{"name":"AstronomyKit"}],"role":"symbol","symbolKind":"case","externalID":"s:12AstronomyKit11DeltaTModelO12iersObservedyA2CmF","title":"DeltaTModel.iersObserved","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"iersObserved"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel\/iersObserved"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/DeltaTModel"]]},"variants":[{"paths":["\/documentation\/astronomykit\/deltatmodel\/iersobserved"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The default: observed Earth rotation."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"iersObserved"}]}]},{"mentions":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"From 1962-01-01 through the table’s last observation: daily UT1 − UTC","type":"text"},{"text":" ","type":"text"},{"text":"from IERS EOP 20 C04, then IERS Bulletin A rapid values, with","type":"text"},{"text":" ","type":"text"},{"text":"Delta T = (TAI − UTC) + 32.184 s − (UT1 − UTC), linear in UT1 between","type":"text"},{"text":" ","type":"text"},{"text":"the 0h UTC rows. Linear interpolation departs from the 12h C04 samples","type":"text"},{"text":" ","type":"text"},{"text":"by at most 0.16 ms (rms 0.019 ms, 1984–2026).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"About a year after that: IERS Bulletin A predictions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"From −720 to 1962: the Table S15 v2020 spline of Morrison, Stephenson,","type":"text"},{"text":" ","type":"text"},{"text":"Hohenkerk and Zawilski (2021), the 2020 addendum to Stephenson,","type":"text"},{"text":" ","type":"text"},{"text":"Morrison and Hohenkerk (2016), as published by HM Nautical Almanac","type":"text"},{"text":" ","type":"text"},{"text":"Office. Each segment is rebuilt as the cubic Hermite curve through","type":"text"},{"text":" ","type":"text"},{"text":"the mean one-sided value and rate at its knots, which removes the","type":"text"},{"text":" ","type":"text"},{"text":"table’s 1 ms rounding jumps and stays within 0.65 ms of it. The","type":"text"},{"text":" ","type":"text"},{"text":"1959–1962 segment ends on the first C04 value and rate, absorbing","type":"text"},{"text":" ","type":"text"},{"text":"the spline’s 0.376 s departure there.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Before −720 and after the last prediction: the integral of HMNAO’s","type":"text"},{"text":" ","type":"text"},{"text":"long-term length-of-day model, lod = 1.72 t − 3.5 sin(2π(t + 0.75)\/14)","type":"text"},{"text":" ","type":"text"},{"text":"ms with t in centuries from 1825.0, continuous with the value at the","type":"text"},{"text":" ","type":"text"},{"text":"join.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedRegime(universalTime:)","isActive":true,"type":"reference"},{"type":"text","text":" reports"},{"type":"text","text":" "},{"type":"text","text":"which source applies at a time, and"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedUncertainty(universalTime:)","type":"reference"},{"text":" the",