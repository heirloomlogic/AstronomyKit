/eclipse","kind":"symbol","navigatorTitle":[{"text":"Eclipse","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","type":"topic","abstract":[{"text":"Swift bindings for Don Cross’ ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/cosinekitty\/astronomy"},{"type":"text","text":" library."}],"kind":"symbol","url":"\/documentation\/astronomykit","title":"AstronomyKit","role":"collection"},"https://github.com/cosinekitty/astronomy":{"type":"link","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","titleInlineContent":[{"text":"Astronomy Engine","type":"text"}],"title":"Astronomy Engine","url":"https:\/\/github.com\/cosinekitty\/astronomy"},"doc://AstronomyKit/documentation/AstronomyKit/Sun":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sun","kind":"identifier"}],"type":"topic","title":"Sun","abstract":[{"text":"Contains functions for calculating Sun position and related values.","type":"text"}],"role":"symbol","url":"\/documentation\/astronomykit\/sun","kind":"symbol","navigatorTitle":[{"text":"Sun","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/Apsis":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Apsis","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Apsis","kind":"identifier"}],"type":"topic","title":"Apsis","abstract":[{"text":"An apsis event: the closest or farthest point in an orbit.","type":"text"}],"role":"symbol","url":"\/documentation\/astronomykit\/apsis","kind":"symbol","navigatorTitle":[{"text":"Apsis","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/GlobalSolarEclipse":{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"tex