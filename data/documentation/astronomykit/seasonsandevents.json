{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit provides calculations for seasonal events (equinoxes and solstices), planetary orbital events (apsides), elongation and visibility, and rare transits of Mercury and Venus.","type":"text"}]},{"anchor":"Equinoxes-and-Solstices","type":"heading","level":2,"text":"Equinoxes and Solstices"},{"anchor":"Get-All-Seasons-for-a-Year","type":"heading","level":3,"text":"Get All Seasons for a Year"},{"code":["let seasons = try Seasons.forYear(2025)","","print(\"🌸 Spring: \\(seasons.marchEquinox)\")","print(\"☀️ Summer: \\(seasons.juneSolstice)\")","print(\"🍂 Autumn: \\(seasons.septemberEquinox)\")","print(\"❄️ Winter: \\(seasons.decemberSolstice)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Iterate-Over-Events","type":"heading","text":"Iterate Over Events"},{"code":["let seasons = try Seasons.forYear(2025)","","for (name, time) in seasons.allEvents {","    print(\"\\(name): \\(time)\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Planetary-Apsides","type":"heading","text":"Planetary Apsides"},{"inlineContent":[{"type":"text","text":"Apsides are the closest (perihelion) and farthest (aphelion) points in a planet’s orbit around the Sun."}],"type":"paragraph"},{"anchor":"Find-Next-Planetary-Apsis","type":"heading","level":3,"text":"Find Next Planetary Apsis"},{"code":["let apsis = try CelestialBody.mars.searchApsis(after: .now)","print(\"\\(apsis.kind.solarName) at \\(apsis.time)\")","print(\"Distance: \\(apsis.distanceAU) AU\")"],"type":"codeListing","syntax":"swift"},{"anchor":"All-Apsides-in-a-Range","type":"heading","level":3,"text":"All Apsides in a Range"},{"code":["let apsides = try CelestialBody.earth.apsides(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for apsis in apsides {","    print(\"\\(apsis.kind.solarName): \\(apsis.time)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Elongation-and-Visibility","type":"heading","level":2,"text":"Elongation and Visibility"},{"type":"paragraph","inlineContent":[{"text":"Elongation is the angular separation between a planet and the Sun. This determines when planets are best visible.","type":"text"}]},{"anchor":"Current-Elongation","type":"heading","level":3,"text":"Current Elongation"},{"code":["let elong = try CelestialBody.venus.elongation(at: .now)","print(\"Venus is \\(elong.angle)° from the Sun\")","print(\"Visibility: \\(elong.visibility.name) star\")","","if elong.visibility == .evening {","    print(\"Look for Venus after sunset\")","} else {","    print(\"Look for Venus before sunrise\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Maximum-Elongation","type":"heading","level":3,"text":"Maximum Elongation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find when a planet reaches greatest separation from the Sun:"}]},{"code":["let maxElong = try CelestialBody.mercury.searchMaxElongation(after: .now)","print(\"Mercury max elongation: \\(maxElong.angle)°\")","print(\"Date: \\(maxElong.time)\")","print(\"\\(maxElong.visibility.name) star\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This is especially useful for Mercury and Venus, which are never far from the Sun."}],"type":"paragraph"},{"anchor":"Illumination-and-Magnitude","type":"heading","level":2,"text":"Illumination and Magnitude"},{"inlineContent":[{"type":"text","text":"Calculate the visual brightness and illumination of planets."}],"type":"paragraph"},{"level":3,"text":"Current Illumination","anchor":"Current-Illumination","type":"heading"},{"code":["let illum = try CelestialBody.venus.illumination(at: .now)","print(\"Magnitude: \\(illum.magnitude)\")","print(\"Phase: \\(Int(illum.phaseFraction * 100))% illuminated\")","print(\"Distance from Sun: \\(illum.helioDistance) AU\")"],"syntax":"swift","type":"codeListing"},{"anchor":"Saturns-Rings","type":"heading","level":3,"text":"Saturn’s Rings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For Saturn, illumination includes ring tilt:"}]},{"code":["let saturn = try CelestialBody.saturn.illumination(at: .now)","print(\"Ring tilt: \\(saturn.ringTilt)°\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Peak-Magnitude","type":"heading","level":3,"text":"Peak Magnitude"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find when a planet reaches maximum brightness:"}]},{"code":["let peak = try CelestialBody.venus.searchPeakMagnitude(after: .now)","print(\"Venus brightest at \\(peak.time)\")","print(\"Magnitude: \\(peak.magnitude)\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Planetary-Transits","type":"heading","level":2,"text":"Planetary Transits"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transits occur when Mercury or Venus passes between Earth and the Sun."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transits are rare events. Mercury transits occur about 13 times per century, while Venus transits occur in pairs separated by over a century."}]}],"type":"aside","style":"note","name":"Note"},{"anchor":"Find-Next-Transit","type":"heading","level":3,"text":"Find Next Transit"},{"code":["let transit = try Transit.search(body: .mercury, after: .now)","print(\"Transit date: \\(transit.peak)\")","print(\"Duration: \\(transit.duration \/ 60) minutes\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Transit-Timing","type":"heading","level":3,"text":"Transit Timing"},{"code":["print(\"Start (first contact): \\(transit.start)\")","print(\"Peak (mid-transit): \\(transit.peak)\")","print(\"End (last contact): \\(transit.finish)\")","print(\"Minimum separation: \\(transit.separation) arcmin\")"],"type":"codeListing","syntax":"swift"},{"anchor":"All-Transits-in-a-Range","type":"heading","level":3,"text":"All Transits in a Range"},{"code":["\/\/ Find all Mercury transits in the next 50 years","let transits = try Transit.transits(","    body: .mercury,","    from: .now,","    to: .now.addingDays(365 * 50)",")","","for transit in transits {","    print(\"\\(transit.body.name) transit: \\(transit.peak)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Angular-Separation","type":"heading","level":2,"text":"Angular Separation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate the angle between a body and the Sun:"}]},{"code":["let angle = try CelestialBody.jupiter.angleFromSun(at: .now)","print(\"Jupiter is \\(angle)° from the Sun\")","","\/\/ Opposition occurs when angle ≈ 180°","if angle > 170 {","    print(\"Jupiter is near opposition!\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Conjunctions-and-Oppositions","type":"heading","level":2,"text":"Conjunctions and Oppositions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for when a planet reaches a specific angular relationship with the Sun:"}]},{"code":["\/\/ Find the next Mars opposition (closest to Earth)","let opposition = try CelestialBody.mars.searchOpposition(after: .now)","print(\"Mars opposition: \\(opposition.date)\")","","\/\/ Find the next Jupiter superior conjunction (behind the Sun)","let conjunction = try CelestialBody.jupiter.searchSuperiorConjunction(after: .now)","print(\"Jupiter conjunction: \\(conjunction.date)\")","","\/\/ Measure the relative ecliptic longitude between two bodies","let angle = try CelestialBody.venus.pairLongitude(with: .mars, at: .now)","print(\"Venus-Mars separation: \\(angle)°\")","","\/\/ Search for an arbitrary relative longitude from the Sun","let result = try CelestialBody.saturn.searchRelativeLongitude(90, after: .now)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The relative longitude convention measures the heliocentric angle between the planet"},{"type":"text","text":" "},{"type":"text","text":"and Earth. At 0° the planet and Earth are on the same side of the Sun (opposition for"},{"type":"text","text":" "},{"type":"text","text":"outer planets). At 180° the planet is on the far side of the Sun (superior conjunction)."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Calculate equinoxes, solstices, planetary apsides, elongations, and transits."}],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseEvent","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Apsis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/ApsisKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Elongation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Visibility"],"generated":true,"anchor":"Events","title":"Events"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/seasonsandevents"]}],"kind":"article","metadata":{"roleHeading":"Article","title":"Seasons and Events","role":"article","modules":[{"name":"AstronomyKit"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"references":{"doc://AstronomyKit/documentation/Astron