on\/AstronomyKit\/RiseSetTimes","abstract":[{"type":"text","text":"Calculate when celestial bodies rise, set, and reach their highest point."}],"kind":"article","role":"article"},"doc://AstronomyKit/documentation/AstronomyKit/Apsis":{"title":"Apsis","type":"topic","url":"\/documentation\/astronomykit\/apsis","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Apsis","abstract":[{"type":"text","text":"An apsis event: the closest or farthest point in an orbit."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Apsis","kind":"identifier"}],"navigatorTitle":[{"text":"Apsis","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/AstroSearch":{"url":"\/documentation\/astronomykit\/astrosearch","abstract":[{"text":"Generic root-finding search for custom astronomical events.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstroSearch","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","navigatorTitle":[{"text":"AstroSearch","kind":"identifier"}],"title":"AstroSearch"},"doc://AstronomyKit/documentation/AstronomyKit/LunarEclipse":{"title":"LunarEclipse","type":"topic","url":"\/documentation\/astronomykit\/lunareclipse","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","abstract":[{"type":"text","text":"Information about a lunar eclipse."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LunarEclipse","kind":"identifier"}],"navigatorTitle":[{"text":"LunarEclipse","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/ApsisKind":{"title":"ApsisKind","type":"topic","url":"\/documentation\/astronomykit\/apsiskind","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/ApsisKind","abstract":[{"type":"text","text":"The type