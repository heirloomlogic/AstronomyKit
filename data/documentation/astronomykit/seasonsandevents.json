{"abstract":[{"text":"Calculate equinoxes, solstices, planetary apsides, elongations, and transits.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/seasonsandevents"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"AstronomyKit provides calculations for seasonal events (equinoxes and solstices), planetary orbital events (apsides), elongation and visibility, and rare transits of Mercury and Venus."}],"type":"paragraph"},{"level":2,"anchor":"Equinoxes-and-Solstices","type":"heading","text":"Equinoxes and Solstices"},{"level":3,"anchor":"Get-All-Seasons-for-a-Year","type":"heading","text":"Get All Seasons for a Year"},{"code":["let seasons = try Seasons.forYear(2025)","","print(\"🌸 Spring: \\(seasons.marchEquinox)\")","print(\"☀️ Summer: \\(seasons.juneSolstice)\")","print(\"🍂 Autumn: \\(seasons.septemberEquinox)\")","print(\"❄️ Winter: \\(seasons.decemberSolstice)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Iterate-Over-Events","type":"heading","text":"Iterate Over Events"},{"code":["let seasons = try Seasons.forYear(2025)","","for (name, time) in seasons.allEvents {","    print(\"\\(name): \\(time)\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Planetary-Apsides","type":"heading","text":"Planetary Apsides"},{"inlineContent":[{"type":"text","text":"Apsides are the closest (perihelion) and farthest (aphelion) points in a planet’s orbit around the Sun."}],"type":"paragraph"},{"level":3,"anchor":"Find-Next-Planetary-Apsis","type":"heading","text":"Find Next Planetary Apsis"},{"code":["let apsis = try CelestialBody.mars.searchApsis(after: .now)","print(\"\\(apsis.kind.solarName) at \\(apsis.time)\")","print(\"Distance: \\(apsis.distanceAU) AU\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"All-Apsides-in-a-Range","type":"heading","text":"All Apsides in a Range"},{"code":["let apsides = try CelestialBody.earth.apsides(","    from: AstroTime(year: 2025, month: 1, day: 1),","    to: AstroTime(year: 2030, month: 1, day: 1)",")","","for apsis in apsides {","    print(\"\\(apsis.kind.solarName): \\(apsis.time)\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Elongation-and-Visibility","type":"heading","text":"Elongation and Visibility"},{"inlineContent":[{"text":"Elongation is the angular separation between a planet and the Sun. This determines when planets are best visible.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Current-Elongation","type":"heading","text":"Current Elongation"},{"code":["let elong = try CelestialBody.venus.elongation(at: .now)","print(\"Venus is \\(elong.angle)° from the Sun\")","print(\"Visibility: \\(elong.visibility.name) star\")","","if elong.visibility == .evening {","    print(\"Look for Venus after sunset\")","} else {","    print(\"Look for Venus before sunrise\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Maximum-Elongation","type":"heading","text":"Maximum Elongation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find when a planet reaches greatest separation from the Sun:"}]},{"type":"codeListing","syntax":"swift","code":["let maxElong = try CelestialBody.mercury.searchMaxElongation(after: .now)","print(\"Mercury max elongation: \\(maxElong.angle)°\")","print(\"Date: \\(maxElong.time)\")","print(\"\\(maxElong.visibility.name) star\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is especially useful for Mercury and Venus, which are never far from the Sun."}]},{"type":"heading","text":"Illumination and Magnitude","level":2,"anchor":"Illumination-and-Magnitude"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate the visual brightness and illumination of planets."}]},{"type":"heading","text":"Current Illumination","level":3,"anchor":"Current-Illumination"},{"type":"codeListing","syntax":"swift","code":["let illum = try CelestialBody.venus.illumination(at: .now)","print(\"Magnitude: \\(illum.magnitude)\")","print(\"Phase: \\(Int(illum.phaseFraction * 100))% illuminated\")","print(\"Distance from Sun: \\(illum.helioDistance) AU\")"]},{"type":"heading","text":"Saturn’s Rings","level":3,"anchor":"Saturns-Rings"},{"type":"paragraph","inlineContent":[{"text":"For Saturn, illumination includes ring tilt:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let saturn = try CelestialBody.saturn.illumination(at: .now)","print(\"Ring tilt: \\(saturn.ringTilt)°\")"]},{"type":"heading","text":"Peak Magnitude","level":3,"anchor":"Peak-Magnitude"},{"type":"paragraph","inlineContent":[{"text":"Find when a planet reaches maximum brightness:","type":"text"}]},{"type":"codeListing","code":["let peak = try CelestialBody.venus.searchPeakMagnitude(after: .now)","print(\"Venus brightest at \\(peak.time)\")","print(\"Magnitude: \\(peak.magnitude)\")"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Planetary-Transits","text":"Planetary Transits"},{"inlineContent":[{"type":"text","text":"Transits occur when Mercury or Venus passes between Earth and the Sun."}],"type":"paragraph"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Transits are rare events. Mercury transits occur about 13 times per century, while Venus transits occur in pairs separated by over a century.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"heading","text":"Find Next Transit","level":3,"anchor":"Find-Next-Transit"},{"type":"codeListing","syntax":"swift","code":["let transit = try Transit.search(body: .mercury, after: .now)","print(\"Transit date: \\(transit.peak)\")","print(\"Duration: \\(transit.duration \/ 60) minutes\")"]},{"type":"heading","text":"Transit Timing","level":3,"anchor":"Transit-Timing"},{"type":"codeListing","syntax":"swift","code":["print(\"Start (first contact): \\(transit.start)\")","print(\"Peak (mid-transit): \\(transit.peak)\")","print(\"End (last contact): \\(transit.finish)\")","print(\"Minimum separation: \\(transit.separation) arcmin\")"]},{"type":"heading","text":"All Transits in a Range","level":3,"anchor":"All-Transits-in-a-Range"},{"type":"codeListing","syntax":"swift","code":["\/\/ Find all Mercury transits in the next 50 years","let transits = try Transit.transits(","    body: .mercury,","    from: .now,","    to: .now.addingDays(365 * 50)",")","","for transit in transits {","    print(\"\\(transit.body.name) transit: \\(transit.peak)\")","}"]},{"type":"heading","text":"Angular Separation","level":2,"anchor":"Angular-Separation"},{"type":"paragraph","inlineContent":[{"text":"Calculate the angle between a body and the Sun:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let angle = try CelestialBody.jupiter.angleFromSun(at: .now)","print(\"Jupiter is \\(angle)° from the Sun\")","","\/\/ Opposition occurs when angle ≈ 180°","if angle > 170 {","    print(\"Jupiter is near opposition!\")","}"]},{"type":"heading","text":"Conjunctions and Oppositions","level":2,"anchor":"Conjunctions-and-Oppositions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for when a planet reaches a specific angular relationship with the Sun:"}]},{"code":["\/\/ Find the next Mars opposition (closest to Earth)","let opposition = try CelestialBody.mars.searchOpposition(after: .now)","print(\"Mars opposition: \\(opposition.date)\")","","\/\/ Find the next Jupiter superior conjunction (behind the Sun)","let conjunction = try CelestialBody.jupiter.searchSuperiorConjunction(after: .now)","print(\"Jupiter conjunction: \\(conjunction.date)\")","","\/\/ Measure the relative ecliptic longitude between two bodies","let angle = try CelestialBody.venus.pairLongitude(with: .mars, at: .now)","print(\"Venus-Mars separation: \\(angle)°\")","","\/\/ Search for an arbitrary relative longitude from the Sun","let result = try CelestialBody.saturn.searchRelativeLongitude(90, after: .now)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The relative longitude convention measures the heliocentric angle between the planet and Earth. At 0° the planet and Earth are on the same side of the Sun (opposition for outer planets). At 180° the planet is on the far side of the Sun (superior conjunction)."}]}]}],"metadata":{"modules":[{"name":"AstronomyKit"}],"role":"article","title":"Seasons and Events","roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseEvent","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Apsis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/ApsisKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Elongation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Visibility"],"generated":true,"anchor":"Events","title":"Events"}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/LocalSolarEclipse":{"type":"topic","kind":"symbol","url":"\/documentation\/astronomykit\/localsolareclipse","navigatorTitle":[{"kind":"identifier","text":"LocalSolarEclipse"}],"title":"LocalSolarEclipse","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","abstract":[{"type":"text","text":"Information about a solar eclipse as seen from a specific location."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalSolarEclipse"}]},"doc://AstronomyKit/documentation/AstronomyKit/AstroSearch":{"url":"\/documentation\/astronomykit\/astrosearch","title":"AstroSearch","kind":"symbol","type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","abstract":[{"type":"text","text":"Generic root-finding search for custom astronomical events."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AstroSearch"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AstroSearch"}]},"https://github.com/cosinekitty/astronomy":{"type":"link","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","url":"https:\/\/github.com\/cosinekitty\/astronomy","titleInlineContent":[{"text":"Astronomy Engine","type":"text"}]},"doc://AstronomyKit/documentation/AstronomyKit/GlobalSolarEclipse":{"title":"GlobalSolarEclipse","abstract":[{"type":"text","text":"Information about a solar eclipse as seen globally."}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GlobalSolarEclipse"}],"kind":"symbol","navigatorTitle":[{"text":"GlobalSolarEclipse","kind":"identifier"}],"type":"topic","url":"\/documentation\/astronomykit\/globalsolareclipse"},"doc://AstronomyKit/documentation/AstronomyKit/Apsis":{"kind":"symbol","abstract":[{"type":"text","text":"An apsis event: the closest or farthest point in an orbit."}],"type":"topic","nav