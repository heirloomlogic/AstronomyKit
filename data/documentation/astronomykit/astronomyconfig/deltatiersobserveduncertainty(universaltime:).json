ind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"universalTime","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"UT1 days since J2000 noon."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The uncertainty in seconds. NaN for NaN input."}],"type":"paragraph"}]},{"kind":"mentions","mentions":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This is a stated, sourced uncertainty of about one standard error, not"},{"type":"text","text":" "},{"type":"text","text":"a proved bound, chosen by regime:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Observed: the row’s published UT1 − UTC error (the C04 formal error,","type":"text"},{"text":" ","type":"text"},{"text":"then Bulletin A’s), linear between rows, plus up to 0.16 ms at midday","type":"text"},{"text":" ","type":"text"},{"text":"for linear interpolation, the largest departure measured against the","type":"text"},{"text":" ","type":"text"},{"text":"12h C04 samples. About 0.02 ms today, 2 ms in 1962.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Predicted: Bulletin A’s stated error for each prediction, from","type":"text"},{"text":" ","type":"text"},{"text":"0.6 ms on the first day to 24 ms a year ahead.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Historical: HMNAO’s error estimate ε (180 s at −720, 15 s from 1000","type":"text"},{"text":" ","type":"text"},{"text":"to 1600, 0.05 s after 1870), but never less than 0.68 s, the spline’s","type":"text"},{"text":" ","type":"text"},{"text":"largest departure from C04 over 1962–2019. HMNAO does not state a","type":"text"},{"text":" ","type":"text"},{"text":"confidence level for ε.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Extrapolated: HMNAO’s error estimate for its extrapolation (2 s at","type":"text"},{"text":" ","type":"text"},{"text":"2030, 10 s at 2100, 100 s at 2500, 360 s at −800, 0.3 h at −2000),","type":"text"},{"text":" ","type":"text"},{"text":"linear between its years and never less than the last prediction’s","type":"text"},{"text":" ","type":"text"},{"text":"error. Beyond −2000 and 2500 no figure is published; the estimate","type":"text"},{"text":" ","type":"text"},{"text":"grows with the square of the time from 1825.0, as the long-term","type":"text"},{"text":" ","type":"text"},{"text":"model’s tidal term does.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"The value is the same whichever model is selected."}],"type":"paragraph"}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/TimeAndObservers":{"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers","kind":"article","title":"Time and Observers","abstract":[{"type":"text","text":"Work with astronomical time and geographic observer locations."}],"role":"article","url":"\/documentation\/astronomykit\/timeandobservers"},"doc://AstronomyKit/documentation/AstronomyKit/AstronomyConfig/deltaTIersObservedUncertainty(universalTime:)":{"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObservedUncertainty(universalTime:)","kind":"symbol","title":"deltaTIersObservedUncertainty(universalTime:)","abstract":[{"type":"text","text":"The stated uncertainty of "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyConfig\/deltaTIersObserved(universalTime:)","type":"reference","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","