{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit provides a type-safe Swift interface for astronomical calculations. This article walks you through installation and your first calculations.","type":"text"}]},{"type":"heading","anchor":"Installation","level":2,"text":"Installation"},{"type":"paragraph","inlineContent":[{"text":"Add AstronomyKit to your Swift package:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/AstronomyKit\", from: \"1.0.0\")","]"]},{"type":"paragraph","inlineContent":[{"text":"Or in Xcode: ","type":"text"},{"inlineContent":[{"type":"text","text":"File → Add Package Dependencies"}],"type":"strong"},{"text":" and enter the repository URL.","type":"text"}]},{"type":"heading","anchor":"Your-First-Calculations","level":2,"text":"Your First Calculations"},{"type":"heading","anchor":"Import-the-Package","level":3,"text":"Import the Package"},{"type":"codeListing","syntax":"swift","code":["import AstronomyKit"]},{"type":"heading","anchor":"Set-Up-Your-Observer-Location","level":3,"text":"Set Up Your Observer Location"},{"type":"paragraph","inlineContent":[{"text":"Most astronomical calculations require an observer location on Earth:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ New York City","let observer = Observer(latitude: 40.7128, longitude: -74.0060)","","\/\/ With elevation (in meters)","let denver = Observer(latitude: 39.7392, longitude: -104.9903, height: 1609)"]},{"type":"heading","anchor":"Get-the-Current-Time","level":3,"text":"Get the Current Time"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit uses ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","type":"reference"},{"text":" for all time-based calculations:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From a specific date","let newYear = AstroTime(year: 2025, month: 1, day: 1, hour: 12)","","\/\/ From Foundation Date","let fromDate = AstroTime(Date())"]},{"type":"heading","anchor":"Calculate-a-Position","level":3,"text":"Calculate a Position"},{"type":"paragraph","inlineContent":[{"text":"Find where a celestial body appears in your sky:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Mars in the local sky","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, etc."]},{"type":"heading","anchor":"Find-the-Moon-Phase","level":3,"text":"Find the Moon Phase"},{"type":"codeListing","syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","print(\"\\(Moon.emoji(for: angle)) \\(Moon.phaseName(for: angle))\")","\/\/ Output: 🌔 Waxing Gibbous"]},{"type":"heading","anchor":"Get-Rise-and-Set-Times","level":3,"text":"Get Rise and Set Times"},{"type":"codeListing","syntax":"swift","code":["if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","if let sunset = try CelestialBody.sun.setTime(after: .now, from: observer) {","    print(\"Sunset: \\(sunset.date)\")","}"]},{"type":"heading","anchor":"Error-Handling","level":2,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"text":"All potentially failing calculations throw ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let position = try CelestialBody.earth.horizon(at: .now, from: observer)","} catch AstronomyError.earthNotAllowed {","    print(\"Cannot observe Earth from Earth!\")","} catch {","    print(\"Calculation failed: \\(error)\")","}"]},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers","isActive":true,"type":"reference"},{"text":" — Deep dive into time and location handling","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions","isActive":true,"type":"reference"},{"text":" — Calculate positions for any celestial body","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases","isActive":true,"type":"reference"},{"text":" — Explore moon phase calculations","type":"text"}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"]}],"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","title":"Getting Started with AstronomyKit","role":"article"},"abstract":[{"type":"text","text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations."}],"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/gettingstarted"]}],"references":{"https://github.com/cosinekitty/astronomy":{"url":"https:\/\/github.com\/cosinekitty\/astronomy","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"title":"Astronomy Engine","type":"link"},"doc://AstronomyKit/documentation/AstronomyKit/AstroTime":{"title":"AstroTime","type":"topic","url":"\/documentation\/astronomykit\/astrotime","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","abstract":[{"type":"text","text":"Represents a moment in time for astronomical calculations."}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"AstroTime","kind":"identifier"}],"navigatorTitle":[{"text":"AstroTime","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/AstronomyError":{"url":"\/documentation\/astronomykit\/astronomyerror","abstract":[{"text":"Errors that can occur during astronomy calculations.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstronomyError","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError","navigatorTitle":[{"text":"AstronomyError","kind":"identifier"}],"title":"AstronomyError"},"doc://AstronomyKit/documentation/AstronomyKit":{"title":"AstronomyKit","type":"topic","url":"\/documentation\/astronomykit","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","abstract":[{"type":"text","text":"Swift bindings for Don Cross’ "},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"type":"text","text":" library."}],"kind":"symbol","role":"collection"},"doc://AstronomyKit/documentation/AstronomyKit/MoonPhases":{"title":"Moon Phases","type":"topic","url":"\/documentation\/astronomykit\/moonphases","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases","abstract":[{"text":"Calculate moon phases, quarters, libration, and lunar nodes.","type":"text"}],"kind":"article","role":"article"},"doc://AstronomyKit/documentation/AstronomyKit/TimeAndObservers":{"title":"Time and Observers","type":"topic","url":"\/documentation\/astronomykit\/time