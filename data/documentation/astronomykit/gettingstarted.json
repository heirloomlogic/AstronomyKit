{"abstract":[{"type":"text","text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations."}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit provides a type-safe Swift interface for astronomical calculations. This article walks you through installation and your first calculations.","type":"text"}]},{"text":"Installation","type":"heading","anchor":"Installation","level":2},{"type":"paragraph","inlineContent":[{"text":"Add AstronomyKit to your Swift package:","type":"text"}]},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/AstronomyKit\", from: \"3.0.0\")","]"],"type":"codeListing"},{"inlineContent":[{"text":"Or in Xcode: ","type":"text"},{"inlineContent":[{"text":"File → Add Package Dependencies","type":"text"}],"type":"strong"},{"text":" and enter the repository URL.","type":"text"}],"type":"paragraph"},{"text":"Your First Calculations","anchor":"Your-First-Calculations","level":2,"type":"heading"},{"text":"Import the Package","anchor":"Import-the-Package","level":3,"type":"heading"},{"syntax":"swift","code":["import AstronomyKit"],"type":"codeListing"},{"text":"Set Up Your Observer Location","anchor":"Set-Up-Your-Observer-Location","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Most astronomical calculations require an observer location on Earth:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ New York City","let observer = Observer(latitude: 40.7128, longitude: -74.0060)","","\/\/ With elevation (in meters)","let denver = Observer(latitude: 39.7392, longitude: -104.9903, height: 1609)"],"type":"codeListing"},{"text":"Get the Current Time","anchor":"Get-the-Current-Time","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"AstronomyKit uses "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","type":"reference","isActive":true},{"type":"text","text":" for all time-based calculations:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From a specific date","let newYear = AstroTime(year: 2025, month: 1, day: 1, hour: 12)","","\/\/ From Foundation Date","let fromDate = AstroTime(Date())"],"type":"codeListing"},{"text":"Calculate a Position","anchor":"Calculate-a-Position","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Find where a celestial body appears in your sky:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Mars in the local sky","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, etc."],"type":"codeListing"},{"text":"Find the Moon Phase","anchor":"Find-the-Moon-Phase","level":3,"type":"heading"},{"syntax":"swift","code":["let angle = try Moon.phaseAngle(at: .now)","print(\"\\(Moon.emoji(for: angle)) \\(Moon.phaseName(for: angle))\")","\/\/ Output: 🌔 Waxing Gibbous"],"type":"codeListing"},{"text":"Get Rise and Set Times","anchor":"Get-Rise-and-Set-Times","level":3,"type":"heading"},{"syntax":"swift","code":["if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","if let sunset = try CelestialBody.sun.setTime(after: .now, from: observer) {","    print(\"Sunset: \\(sunset.date)\")","}"],"type":"codeListing"},{"text":"Error Handling","anchor":"Error-Handling","level":2,"type":"heading"},{"inlineContent":[{"text":"All potentially failing calculations throw ","type":"text"},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let position = try CelestialBody.earth.horizon(at: .now, from: observer)","} catch AstronomyError.earthNotAllowed {","    print(\"Cannot observe Earth from Earth!\")","} catch {","    print(\"Calculation failed: \\(error)\")","}"],"type":"codeListing"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers","isActive":true},{"type":"text","text":" for time scales and observer locations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"},{"type":"text","text":" for positions and velocities of any body"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases"},{"type":"text","text":" for phases, quarters, libration, and nodes"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","sections":[],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"title":"Getting Started with AstronomyKit","roleHeading":"Article","modules":[{"name":"AstronomyKit"}],"role":"article"},"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"],"title":"Essentials","generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/gettingstarted"]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/CelestialPositions":{"abstract":[{"text":"Calculate the positions of celestial bodies in various coordinate systems.","type":"text"}],"role":"article","kind":"article","title":"Celestial Positions","identifier":"doc:\/\/Astronomy