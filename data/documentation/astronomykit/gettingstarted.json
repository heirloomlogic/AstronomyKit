{"metadata":{"modules":[{"name":"AstronomyKit"}],"role":"article","title":"Getting Started with AstronomyKit","roleHeading":"Article"},"sections":[],"abstract":[{"text":"Learn how to add AstronomyKit to your project and perform basic astronomical calculations.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"AstronomyKit is a pure Swift 6 library for on-device astronomical calculations, based on Don Cross’ ","type":"text"},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"text":" C library with zero C dependencies. This article covers installation and your first calculations.","type":"text"}],"type":"paragraph"},{"anchor":"Installation","level":2,"text":"Installation","type":"heading"},{"inlineContent":[{"text":"Add AstronomyKit to your Swift package:","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/AstronomyKit\", from: \"5.0.0\")","]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Or in Xcode: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File → Add Package Dependencies"}]},{"text":" and enter the repository URL.","type":"text"}],"type":"paragraph"},{"anchor":"Your-First-Calculations","level":2,"text":"Your First Calculations","type":"heading"},{"anchor":"Import-the-Package","level":3,"text":"Import the Package","type":"heading"},{"code":["import AstronomyKit"],"type":"codeListing","syntax":"swift"},{"anchor":"Set-Up-Your-Observer-Location","level":3,"text":"Set Up Your Observer Location","type":"heading"},{"inlineContent":[{"text":"Most astronomical calculations require an observer location on Earth:","type":"text"}],"type":"paragraph"},{"code":["\/\/ New York City","let observer = Observer(latitude: 40.7128, longitude: -74.0060)","","\/\/ With elevation (in meters)","let denver = Observer(latitude: 39.7392, longitude: -104.9903, height: 1609)"],"type":"codeListing","syntax":"swift"},{"anchor":"Get-the-Current-Time","level":3,"text":"Get the Current Time","type":"heading"},{"inlineContent":[{"text":"AstronomyKit uses ","type":"text"},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","type":"reference","isActive":true},{"text":" for all time-based calculations:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Current time","let now = AstroTime.now","","\/\/ From a specific date","let newYear = AstroTime(year: 2025, month: 1, day: 1, hour: 12)","","\/\/ From Foundation Date","let fromDate = AstroTime(Date())"],"type":"codeListing","syntax":"swift"},{"anchor":"Calculate-a-Position","level":3,"text":"Calculate a Position","type":"heading"},{"inlineContent":[{"text":"Find where a celestial body appears in your sky:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Mars in the local sky","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","print(\"Altitude: \\(mars.altitude)°\")     \/\/ Height above horizon","print(\"Direction: \\(mars.compassDirection)\")  \/\/ N, NE, E, etc."],"type":"codeListing","syntax":"swift"},{"anchor":"Find-the-Moon-Phase","level":3,"text":"Find the Moon Phase","type":"heading"},{"code":["let angle = try Moon.phaseAngle(at: .now)","print(\"\\(Moon.emoji(for: angle)) \\(Moon.phaseName(for: angle))\")","\/\/ Output: 🌔 Waxing Gibbous"],"type":"codeListing","syntax":"swift"},{"anchor":"Get-Rise-and-Set-Times","level":3,"text":"Get Rise and Set Times","type":"heading"},{"code":["if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","if let sunset = try CelestialBody.sun.setTime(after: .now, from: observer) {","    print(\"Sunset: \\(sunset.date)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Error-Handling","level":2,"text":"Error Handling","type":"heading"},{"inlineContent":[{"text":"Calculations that can fail throw ","type":"text"},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["do {","    _ = try CelestialBody.earth.riseTime(after: .now, from: observer)","} catch AstronomyError.earthNotAllowed {","    print(\"Cannot observe Earth from Earth!\")","} catch {","    print(\"Calculation failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Next-Steps","level":2,"text":"Next Steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/TimeAndObservers"},{"text":" — Time scales, Delta T, and observer locations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/CelestialPositions"},{"text":" — Positions for solar system bodies and fixed stars","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases"},{"text":" — Moon phases, libration, nodes, and apsides","type":"text"}]}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/astronomykit\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GettingStarted","interfaceLanguage":"swift"},"kind":"article","references":{"doc://AstronomyKit/documentation/AstronomyKit":{"abstract":[{"text":"Pure Swift 6 astronomical calculations based on Don Cross’ ","type":"text"},{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","type":"reference","isActive":true},{"text":" C library.","type":"text"}],"role":"collection","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit","title":"AstronomyKit","kind":"symbol","url":"\/documentation\/astronomykit","type":"topic"},"doc://AstronomyKit/documentation/AstronomyKit/MoonPhases":{"abstract":[{"type":"text","text":"Calculate moon phases, quarters, libration, and lunar nodes."}],"role":"article","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/MoonPhases","title":"Moon Phases","kind":"article","url":"\/documentation\/astronomykit\/moonphases","type":"topic"},"doc://AstronomyKit/documentation/AstronomyKit/AstronomyError":{"type":"topic","title":"AstronomyError","abstract":[{"type":"text","text":"Errors that can occur during astronomy calculations."}],"url":"\/documentation\/astronomykit\/astronomyerror","kind":"symbol","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError","navigatorTitle":[{"text":"AstronomyError","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstronomyError","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/AstroTime":{"type":"topic","title":"AstroTime","abstract":[{"type":"text","text":"Represents a moment in time for astronomical calculations."}],"url":"\/documentation\/astronomykit\/astrotime","kind":"symbol","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroTime","navigatorTitle":[{"text":"AstroTime","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstroTime","kind":"identifier"}]},"https://github.com/cosinekitty/astronomy":{"url":"https:\/\/github.com\/cosinekitty\/astronomy","type":"link","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","titleInlineCon