{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit includes specialized pure-Swift calculation tools for gravity simulations, custom root-finding searches, Lagrange point positions, Jupiter’s Galilean moons, planetary rotation axes, atmospheric modeling, fixed stars, and 2060 Chiron.","type":"text"}]},{"level":2,"type":"heading","text":"Custom Event Search","anchor":"Custom-Event-Search"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","type":"reference"},{"text":" to find ascending roots of arbitrary functions over a time window, or to correct custom position functions for light-travel time. Both ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch\/find(from:to:toleranceSeconds:_:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch\/correctLightTravel(at:_:)","type":"reference"},{"text":" take synchronous, non-escaping closures, so they can capture local mutable state directly under Swift 6 strict concurrency.","type":"text"}]},{"type":"codeListing","code":["let start = AstroTime(year: 2025, month: 1, day: 1)","let end = start.addingDays(30)","var evaluations = 0","","let crossing = try AstroSearch.find(from: start, to: end) { time in","    evaluations += 1","    let lon = try Moon.ecliptic(at: time).longitude","    var diff = lon - 90.0","    while diff < -180 { diff += 360 }","    while diff > 180 { diff -= 360 }","    return diff","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"N-Body Gravity Simulation","anchor":"N-Body-Gravity-Simulation"},{"type":"paragraph","inlineContent":[{"text":"Simulate the gravitational motion of objects in the solar system.","type":"text"}]},{"level":3,"type":"heading","text":"Creating a Simulation","anchor":"Creating-a-Simulation"},{"type":"codeListing","code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"syntax":"swift"},{"level":3,"type":"heading","text":"Running the Simulation","anchor":"Running-the-Simulation"},{"type":"codeListing","code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"],"syntax":"swift"},{"level":3,"type":"heading","text":"Reversing Time","anchor":"Reversing-Time"},{"type":"codeListing","code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"],"syntax":"swift"},{"level":2,"type":"heading","text":"Lagrange Points","anchor":"Lagrange-Points"},{"type":"paragraph","inlineContent":[{"text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system.","type":"text"}]},{"level":3,"type":"heading","text":"Calculate Lagrange Point Position","anchor":"Calculate-Lagrange-Point-Position"},{"type":"codeListing","code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"],"syntax":"swift"},{"level":3,"type":"heading","text":"The Five Lagrange Points","anchor":"The-Five-Lagrange-Points"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Point","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Location","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stability","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Between bodies","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond smaller body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond larger body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° ahead","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° behind","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]]]},{"anchor":"Jupiters-Galilean-Moons","type":"heading","level":2,"text":"Jupiter’s Galilean Moons"},{"type":"paragraph","inlineContent":[{"text":"Get positions of Io, Europa, Ganymede, and Callisto.","type":"text"}]},{"anchor":"Moon-States","type":"heading","level":3,"text":"Moon States"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"],"type":"codeListing"},{"anchor":"Checking-Moon-Position","type":"heading","level":3,"text":"Checking Moon Position"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"],"type":"codeListing"},{"anchor":"Using-as-CelestialBodies","type":"heading","level":3,"text":"Using as CelestialBodies"},{"type":"paragraph","inlineContent":[{"text":"The moons are also available as celestial bodies:","type":"text"}]},{"syntax":"swift","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"],"type":"codeListing"},{"anchor":"Planetary-Rotation-Axes","type":"heading","level":2,"text":"Planetary Rotation Axes"},{"type":"paragraph","inlineContent":[{"text":"Get the orientation of a body’s rotation axis and prime meridian.","type":"text"}]},{"syntax":"swift","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This is useful for:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Calculating solar angles on planetary surfaces","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Rendering accurate planetary graphics","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Atmospheric-Modeling","type":"heading","level":2,"text":"Atmospheric Modeling"},{"type":"paragraph","inlineContent":[{"text":"Model Earth’s atmosphere based on elevation.","type":"text"}]},{"anchor":"Atmosphere-at-Elevation","type":"heading","level":3,"text":"Atmosphere at Elevation"},{"syntax":"swift","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"],"type":"codeListing"},{"anchor":"Observers-Atmosphere","type":"heading","level":3,"text":"Observer’s Atmosphere"},{"syntax":"swift","code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"],"type":"codeListing"},{"anchor":"Extreme-Altitudes","type":"heading","level":3,"text":"Extreme Altitudes"},{"syntax":"swift","code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"type":"codeListing"},{"anchor":"Fixed-Stars","type":"heading","level":2,"text":"Fixed Stars"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"FixedStar","type":"codeVoice"},{"text":" is an AstronomyKit addition representing a fixed catalog object by J2000 right ascension, declination, and distance.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"Define and track fixed stars by their J2000 catalog coordinates.","type":"text"}]},{"anchor":"Defining-a-Star","type":"heading","level":3,"text":"Defining a Star"},{"syntax":"swift","code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"],"type":"codeListing"},{"anchor":"Getting-Positions","type":"heading","level":3,"text":"Getting Positions"},{"syntax":"swift","code":["\/\/ Ecliptic longitude, true ecliptic and equinox of date (same frame as the planets)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"],"type":"codeListing"},{"anchor":"Finding-Catalog-Data","type":"heading","level":3,"text":"Finding Catalog Data"},{"type":"paragraph","inlineContent":[{"text":"J2000 coordinates can be found from:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Hipparcos Catalog","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Chiron","type":"heading","level":2,"text":"Chiron"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"Chiron","type":"codeVoice"},{"text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation.","type":"text"}]},{"anchor":"Getting-Chirons-Position","type":"heading","level":3,"text":"Getting Chiron’s Position"},{"syntax":"swift","code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Accuracy is highest near the reference epochs and degrades as distance increases. Within ±5 years of an epoch, error is expected to be less than 1 arcminute.","type":"text"}]},{"anchor":"Observer-Gravity","type":"heading","level":2,"text":"Observer Gravity"},{"type":"paragraph","inlineContent":[{"text":"Calculate local gravitational acceleration:","type":"text"}]},{"syntax":"swift","code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This accounts for:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Latitude (Earth’s oblateness)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Altitude (distance from Earth’s center)","type":"text"}],"type":"paragraph"}]}]}]}],"sections":[],"abstract":[{"text":"N-body simulations, Lagrange points, Jupiter’s moons, and more.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"],"anchor":"Advanced","title":"Advanced","generated":true}],"metadata":{"roleHeading":"Article