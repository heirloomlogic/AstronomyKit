{"kind":"article","abstract":[{"text":"N-body simulations, Lagrange points, Jupiter’s moons, and more.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"AstronomyKit includes advanced features for specialized astronomical calculations, including gravity simulations, Lagrange point positions, Jupiter’s Galilean moons, planetary rotation axes, and atmospheric modeling."}],"type":"paragraph"},{"level":2,"text":"N-Body Gravity Simulation","anchor":"N-Body-Gravity-Simulation","type":"heading"},{"inlineContent":[{"type":"text","text":"Simulate the gravitational motion of objects in the solar system."}],"type":"paragraph"},{"level":3,"text":"Creating a Simulation","anchor":"Creating-a-Simulation","type":"heading"},{"syntax":"swift","code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"type":"codeListing"},{"level":3,"text":"Running the Simulation","anchor":"Running-the-Simulation","type":"heading"},{"syntax":"swift","code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"],"type":"codeListing"},{"level":3,"text":"Reversing Time","anchor":"Reversing-Time","type":"heading"},{"syntax":"swift","code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"],"type":"codeListing"},{"level":2,"text":"Lagrange Points","anchor":"Lagrange-Points","type":"heading"},{"inlineContent":[{"type":"text","text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system."}],"type":"paragraph"},{"level":3,"text":"Calculate Lagrange Point Position","anchor":"Calculate-Lagrange-Point-Position","type":"heading"},{"syntax":"swift","code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"],"type":"codeListing"},{"level":3,"text":"The Five Lagrange Points","anchor":"The-Five-Lagrange-Points","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Point","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Location","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stability","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Between bodies","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond smaller body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond larger body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° ahead","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° behind","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]]],"header":"row","type":"table"},{"level":2,"text":"Jupiter’s Galilean Moons","anchor":"Jupiters-Galilean-Moons","type":"heading"},{"inlineContent":[{"type":"text","text":"Get positions of Io, Europa, Ganymede, and Callisto."}],"type":"paragraph"},{"level":3,"text":"Moon States","anchor":"Moon-States","type":"heading"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"],"type":"codeListing"},{"level":3,"text":"Checking Moon Position","anchor":"Checking-Moon-Position","type":"heading"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"],"type":"codeListing"},{"level":3,"text":"Using as CelestialBodies","anchor":"Using-as-CelestialBodies","type":"heading"},{"inlineContent":[{"type":"text","text":"The moons are also available as celestial bodies:"}],"type":"paragraph"},{"syntax":"swift","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"],"type":"codeListing"},{"level":2,"text":"Planetary Rotation Axes","anchor":"Planetary-Rotation-Axes","type":"heading"},{"inlineContent":[{"type":"text","text":"Get the orientation of a body’s rotation axis and prime meridian."}],"type":"paragraph"},{"syntax":"swift","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is useful for:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Calculating solar angles on planetary surfaces","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Rendering accurate planetary graphics","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Atmospheric Modeling","anchor":"Atmospheric-Modeling","type":"heading"},{"inlineContent":[{"type":"text","text":"Model Earth’s atmosphere based on elevation."}],"type":"paragraph"},{"level":3,"text":"Atmosphere at Elevation","anchor":"Atmosphere-at-Elevation","type":"heading"},{"syntax":"swift","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"],"type":"codeListing"},{"level":3,"text":"Observer’s Atmosphere","anchor":"Observers-Atmosphere","type":"heading"},{"syntax":"swift","code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"],"type":"codeListing"},{"level":3,"text":"Extreme Altitudes","anchor":"Extreme-Altitudes","type":"heading"},{"syntax":"swift","code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"type":"codeListing"},{"level":2,"text":"Fixed Stars","anchor":"Fixed-Stars","type":"heading"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"FixedStar"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"type":"codeVoice","code":"Astronomy_DefineStar()"},{"text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates."}],"type":"paragraph"},{"level":3,"text":"Defining a Star","anchor":"Defining-a-Star","type":"heading"},{"syntax":"swift","code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"],"type":"codeListing"},{"level":3,"text":"Getting Positions","anchor":"Getting-Positions","type":"heading"},{"syntax":"swift","code":["\/\/ Ecliptic longitude (for astrological calculations)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"],"type":"codeListing"},{"level":3,"text":"Finding Catalog Data","anchor":"Finding-Catalog-Data","type":"heading"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hipparcos Catalog","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Chiron","anchor":"Chiron","type":"heading"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"Chiron"},{"text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation."}],"type":"paragraph"},{"level":3,"text":"Getting Chiron’s Position","anchor":"Getting-Chirons-Position","type":"heading"},{"syntax":"swift","code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Accuracy is highest near the reference epochs and degrades as distance increases. Within ±5 years of an epoch, error is expected to be less than 1 arcminute."}],"type":"paragraph"},{"level":2,"text":"Observer Gravity","anchor":"Observer-Gravity","type":"heading"},{"inlineContent":[{"type":"text","text":"Calculate local gravitational acceleration:"}],"type":"paragraph"},{"syntax":"swift","code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This accounts for:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Latitude (Earth’s oblateness)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Altitude (distance from Earth’s center)","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/astronomykit\/advancedfeatures"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Advanced Features","modules":[{"name":"AstronomyKit"}]},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"],"title":"Advanced","anchor":"Advanced"}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/LagrangePointID":{"url":"\/documentation\/astronomykit\/lagrangepointid","title":"LagrangePointID","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LagrangePointID"}],"navigatorTitle":[{"kind":"identifier","text":"LagrangePointID"}],"abstract":[{"type":"text","text":"Identifies one of the five Lagrange points."}],"kind":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/GravitySimulation":{"url":"\/documentation\/astronomykit\/gravitysimulation","type":"topic","title":"GravitySimulation","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GravitySimulation","kind":"id