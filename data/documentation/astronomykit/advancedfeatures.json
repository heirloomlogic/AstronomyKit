{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Advanced","anchor":"Advanced","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit includes advanced features for specialized astronomical calculations, including gravity simulations, Lagrange point positions, Jupiter’s Galilean moons, planetary rotation axes, and atmospheric modeling."}]},{"text":"N-Body Gravity Simulation","type":"heading","level":2,"anchor":"N-Body-Gravity-Simulation"},{"type":"paragraph","inlineContent":[{"text":"Simulate the gravitational motion of objects in the solar system.","type":"text"}]},{"text":"Creating a Simulation","type":"heading","level":3,"anchor":"Creating-a-Simulation"},{"syntax":"swift","type":"codeListing","code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"]},{"text":"Running the Simulation","type":"heading","level":3,"anchor":"Running-the-Simulation"},{"syntax":"swift","type":"codeListing","code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"]},{"text":"Reversing Time","type":"heading","level":3,"anchor":"Reversing-Time"},{"syntax":"swift","type":"codeListing","code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"]},{"text":"Lagrange Points","type":"heading","level":2,"anchor":"Lagrange-Points"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system."}]},{"text":"Calculate Lagrange Point Position","type":"heading","level":3,"anchor":"Calculate-Lagrange-Point-Position"},{"syntax":"swift","type":"codeListing","code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"]},{"text":"The Five Lagrange Points","type":"heading","level":3,"anchor":"The-Five-Lagrange-Points"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Point"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Location"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stability"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Between bodies","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unstable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L2"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond smaller body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L3"}]}],[{"inlineContent":[{"text":"Beyond larger body","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Unstable","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"60° ahead"}]}],[{"inlineContent":[{"text":"Stable","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L5"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"60° behind"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]]],"header":"row"},{"type":"heading","text":"Jupiter’s Galilean Moons","anchor":"Jupiters-Galilean-Moons","level":2},{"inlineContent":[{"type":"text","text":"Get positions of Io, Europa, Ganymede, and Callisto."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Moon States","anchor":"Moon-States"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"],"type":"codeListing"},{"level":3,"type":"heading","text":"Checking Moon Position","anchor":"Checking-Moon-Position"},{"type":"codeListing","syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"]},{"level":3,"type":"heading","text":"Using as CelestialBodies","anchor":"Using-as-CelestialBodies"},{"inlineContent":[{"type":"text","text":"The moons are also available as celestial bodies:"}],"type":"paragraph"},{"code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Planetary-Rotation-Axes","text":"Planetary Rotation Axes","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Get the orientation of a body’s rotation axis and prime meridian."}],"type":"paragraph"},{"code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This is useful for:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Calculating solar angles on planetary surfaces","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Rendering accurate planetary graphics","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"Atmospheric-Modeling","level":2,"text":"Atmospheric Modeling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Model Earth’s atmosphere based on elevation."}]},{"type":"heading","anchor":"Atmosphere-at-Elevation","level":3,"text":"Atmosphere at Elevation"},{"type":"codeListing","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"],"syntax":"swift"},{"type":"heading","anchor":"Observers-Atmosphere","level":3,"text":"Observer’s Atmosphere"},{"type":"codeListing","code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"],"syntax":"swift"},{"type":"heading","anchor":"Extreme-Altitudes","level":3,"text":"Extreme Altitudes"},{"type":"codeListing","code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"syntax":"swift"},{"type":"heading","anchor":"Fixed-Stars","level":2,"text":"Fixed Stars"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"FixedStar"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"type":"codeVoice","code":"Astronomy_DefineStar()"},{"type":"text","text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots."}],"type":"paragraph"}],"style":"note"},{"inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates."}],"type":"paragraph"},{"text":"Defining a Star","level":3,"anchor":"Defining-a-Star","type":"heading"},{"syntax":"swift","code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"],"type":"codeListing"},{"text":"Getting Positions","level":3,"anchor":"Getting-Positions","type":"heading"},{"syntax":"swift","code":["\/\/ Ecliptic longitude (for astrological calculations)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"],"type":"codeListing"},{"text":"Finding Catalog Data","level":3,"anchor":"Finding-Catalog-Data","type":"heading"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hipparcos Catalog","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Chiron","anchor":"Chiron","type":"heading"},{"name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"Chiron","type":"codeVoice"},{"text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"inlineContent":[{"text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Getting Chiron’s Position","anchor":"Getting-Chirons-Position","type":"heading"},{"code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Accuracy is highest near the reference epochs and degrades as distance increases. Within ±5 years of an epoch, error is expected to be less than 1 arcminute.","type":"text"}]},{"text":"Observer Gravity","type":"heading","anchor":"Observer-Gravity","level":2},{"type":"paragraph","inlineContent":[{"text":"Calculate local gravitational acceleration:","type":"text"}]},{"code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This accounts for:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Latitude (Earth’s oblateness)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Altitude (distance from Earth’s center)"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"abstract":[{"type":"text","text":"N-body simulations, Lagrange points, Jupiter’s moons, and more."}],"variants":[{"paths":["\/documentation\/astronomykit\/advancedfeatures"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","modules":[{"name":"AstronomyKit"}],"title":"Advanced Features","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"references":{"doc://AstronomyKit/documentation/AstronomyKit/JupiterMoons":{"role":"symbol","title":"JupiterMoons","url":"\/documentation\/astronomykit\/jupitermoons","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","abstract":[{"text":"State vectors for Jupiter’s four Galilean moons.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JupiterMoons"}],"navigatorTitle":[{"kind":"identifier","text":"JupiterMoons"}],"kind":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/Jupiter":{"role":"symbol","title":"Jupiter","url":"\/documentation\/astronomykit\/jupiter","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","abstract":[{"type":"text","text":"Jupiter-specific calculations."}],"type":"t