:[{"text":"A fixed star defined by its J2000 equatorial coordinates.","type":"text"}],"title":"FixedStar","url":"\/documentation\/astronomykit\/fixedstar","kind":"symbol","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","navigatorTitle":[{"kind":"identifier","text":"FixedStar"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"FixedStar","kind":"identifier"}]},"doc://AstronomyKit/documentation/AstronomyKit/RotationAxis":{"abstract":[{"text":"Information about a body’s rotation axis orientation.","type":"text"}],"navigatorTitle":[{"text":"RotationAxis","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","title":"RotationAxis","kind":"symbol","url":"\/documentation\/astronomykit\/rotationaxis","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"RotationAxis","kind":"identifier"}]},"https://github.com/cosinekitty/astronomy":{"identifier":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","type":"link","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"url":"https:\/\/github.com\/cosinekitty\/astronomy"},"doc://AstronomyKit/documentation/AstronomyKit/AstroSearch":{"type":"topic","abstract":[{"type":"text","text":"Generic root-finding search for custom astronomical events."}],"title":"AstroSearch","url":"\/documentation\/astronomykit\/astrosearch","kind":"symbol","role":"symbol","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","navigatorTitle":[{"kind":"identifier","text":"AstroSearch"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AstroSearch"}]}}}