{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures"},"abstract":[{"type":"text","text":"N-body simulations, Lagrange points, Jupiter’s moons, and more."}],"variants":[{"paths":["\/documentation\/astronomykit\/advancedfeatures"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","title":"Advanced Features","role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"anchor":"Advanced","title":"Advanced","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AstronomyKit includes advanced features for specialized astronomical calculations, including gravity simulations, Lagrange point positions, Jupiter’s Galilean moons, planetary rotation axes, and atmospheric modeling."}]},{"type":"heading","level":2,"text":"N-Body Gravity Simulation","anchor":"N-Body-Gravity-Simulation"},{"type":"paragraph","inlineContent":[{"text":"Simulate the gravitational motion of objects in the solar system.","type":"text"}]},{"type":"heading","level":3,"text":"Creating a Simulation","anchor":"Creating-a-Simulation"},{"code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Running the Simulation","anchor":"Running-the-Simulation"},{"code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Reversing Time","anchor":"Reversing-Time"},{"code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Lagrange Points","anchor":"Lagrange-Points"},{"type":"paragraph","inlineContent":[{"text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system.","type":"text"}]},{"type":"heading","level":3,"text":"Calculate Lagrange Point Position","anchor":"Calculate-Lagrange-Point-Position"},{"code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"The-Five-Lagrange-Points","text":"The Five Lagrange Points","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Point"}]}],[{"type":"paragraph","inlineContent":[{"text":"Location","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stability","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L1","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Between bodies","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond smaller body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unstable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L3"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond larger body"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° ahead","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"L5"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"60° behind"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Stable"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"anchor":"Jupiters-Galilean-Moons","text":"Jupiter’s Galilean Moons","type":"heading"},{"inlineContent":[{"type":"text","text":"Get positions of Io, Europa, Ganymede, and Callisto."}],"type":"paragraph"},{"level":3,"anchor":"Moon-States","text":"Moon States","type":"heading"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"],"type":"codeListing"},{"level":3,"anchor":"Checking-Moon-Position","text":"Checking Moon Position","type":"heading"},{"syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"],"type":"codeListing"},{"level":3,"anchor":"Using-as-CelestialBodies","text":"Using as CelestialBodies","type":"heading"},{"inlineContent":[{"text":"The moons are also available as celestial bodies:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"],"type":"codeListing"},{"level":2,"anchor":"Planetary-Rotation-Axes","text":"Planetary Rotation Axes","type":"heading"},{"inlineContent":[{"text":"Get the orientation of a body’s rotation axis and prime meridian.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"],"type":"codeListing"},{"inlineContent":[{"text":"This is useful for:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Calculating solar angles on planetary surfaces"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Rendering accurate planetary graphics","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Atmospheric-Modeling","type":"heading","text":"Atmospheric Modeling","level":2},{"type":"paragraph","inlineContent":[{"text":"Model Earth’s atmosphere based on elevation.","type":"text"}]},{"anchor":"Atmosphere-at-Elevation","type":"heading","text":"Atmosphere at Elevation","level":3},{"syntax":"swift","type":"codeListing","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"]},{"anchor":"Observers-Atmosphere","type":"heading","text":"Observer’s Atmosphere","level":3},{"code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"],"syntax":"swift","type":"codeListing"},{"text":"Extreme Altitudes","level":3,"type":"heading","anchor":"Extreme-Altitudes"},{"code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"type":"codeListing","syntax":"swift"},{"text":"Fixed Stars","level":2,"type":"heading","anchor":"Fixed-Stars"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"FixedStar","type":"codeVoice"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"code":"Astronomy_DefineStar()","type":"codeVoice"},{"text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots.","type":"text"}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Define and track fixed stars by their J2000 catalog coordinates.","type":"text"}]},{"anchor":"Defining-a-Star","type":"heading","text":"Defining a Star","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"]},{"anchor":"Getting-Positions","type":"heading","text":"Getting Positions","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Ecliptic longitude, true ecliptic and equinox of date (same frame as the planets)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"]},{"anchor":"Finding-Catalog-Data","type":"heading","text":"Finding Catalog Data","level":3},{"type":"paragraph","inlineContent":[{"text":"J2000 coordinates can be found from:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hipparcos Catalog"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Yale Bright Star Catalog"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Chiron","text":"Chiron","level":2,"type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Chiron","type":"codeVoice"},{"type":"text","text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron."}]}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation.","type":"text"}],"type":"paragraph"},{"anchor":"Getting-Chirons-Position","text":"Getting Chiron’s Position","level":3,"type":"heading"},{"code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Accuracy is highest near the reference epochs and degrades as distance increases. Within ±5 years of an epoch, error is expected to be less than 1 arcminute.","type":"text"}],"type":"paragraph"},{"anchor":"Observer-Gravity","text":"Observer Gravity","level":2,"type":"heading"},{"inlineContent":[{"text":"Calculate local gravitational acceleration:","type":"text"}],"type":"paragraph"},{"code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This accounts for:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Latitude (Earth’s oblateness)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Altitude (distance from Earth’s center)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"references":{"doc://AstronomyKit/documentation/AstronomyKit/JupiterMoons":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"JupiterMoons"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","abstract":[{"text":"State vectors for Jupiter’s four Galilean moons.","type":"text"}],"url":"\/documentation\/astronomykit\/jupitermoons","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"JupiterMoons"}],"title":"JupiterMoons","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/GravitySimulation":{"title":"GravitySimulation","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"GravitySimulation"}],"type":"topic","role":"symbol","url":"\/