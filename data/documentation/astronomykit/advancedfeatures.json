{"metadata":{"title":"Advanced Features","role":"article","modules":[{"name":"AstronomyKit"}],"roleHeading":"Article"},"abstract":[{"text":"N-body simulations, Lagrange points, Jupiter’s moons, and more.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"AstronomyKit includes advanced features for specialized astronomical calculations, including gravity simulations, Lagrange point positions, Jupiter’s Galilean moons, planetary rotation axes, and atmospheric modeling.","type":"text"}],"type":"paragraph"},{"text":"N-Body Gravity Simulation","level":2,"anchor":"N-Body-Gravity-Simulation","type":"heading"},{"inlineContent":[{"type":"text","text":"Simulate the gravitational motion of objects in the solar system."}],"type":"paragraph"},{"level":3,"text":"Creating a Simulation","type":"heading","anchor":"Creating-a-Simulation"},{"code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"type":"codeListing","syntax":"swift"},{"text":"Running the Simulation","level":3,"anchor":"Running-the-Simulation","type":"heading"},{"type":"codeListing","code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"],"syntax":"swift"},{"text":"Reversing Time","level":3,"anchor":"Reversing-Time","type":"heading"},{"type":"codeListing","code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"],"syntax":"swift"},{"text":"Lagrange Points","level":2,"anchor":"Lagrange-Points","type":"heading"},{"inlineContent":[{"type":"text","text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system."}],"type":"paragraph"},{"type":"heading","text":"Calculate Lagrange Point Position","level":3,"anchor":"Calculate-Lagrange-Point-Position"},{"type":"codeListing","code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"],"syntax":"swift"},{"type":"heading","text":"The Five Lagrange Points","level":3,"anchor":"The-Five-Lagrange-Points"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Point"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Location"}]}],[{"inlineContent":[{"type":"text","text":"Stability"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L1"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Between bodies","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond smaller body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond larger body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° ahead","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"L5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"60° behind","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]]],"header":"row"},{"type":"heading","text":"Jupiter’s Galilean Moons","level":2,"anchor":"Jupiters-Galilean-Moons"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get positions of Io, Europa, Ganymede, and Callisto."}]},{"level":3,"type":"heading","anchor":"Moon-States","text":"Moon States"},{"type":"codeListing","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Checking-Moon-Position","text":"Checking Moon Position"},{"type":"codeListing","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Using-as-CelestialBodies","text":"Using as CelestialBodies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The moons are also available as celestial bodies:"}]},{"type":"codeListing","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Planetary-Rotation-Axes","text":"Planetary Rotation Axes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get the orientation of a body’s rotation axis and prime meridian."}]},{"type":"codeListing","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Calculating solar angles on planetary surfaces","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Rendering accurate planetary graphics","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","anchor":"Atmospheric-Modeling","text":"Atmospheric Modeling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Model Earth’s atmosphere based on elevation."}]},{"level":3,"type":"heading","anchor":"Atmosphere-at-Elevation","text":"Atmosphere at Elevation"},{"type":"codeListing","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Observers-Atmosphere","text":"Observer’s Atmosphere"},{"type":"codeListing","code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Extreme-Altitudes","text":"Extreme Altitudes"},{"type":"codeListing","code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Fixed-Stars","text":"Fixed Stars"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"FixedStar","type":"codeVoice"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"code":"Astronomy_DefineStar()","type":"codeVoice"},{"text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots.","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates."}]},{"level":3,"type":"heading","anchor":"Defining-a-Star","text":"Defining a Star"},{"type":"codeListing","code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Getting-Positions","text":"Getting Positions"},{"type":"codeListing","code":["\/\/ Ecliptic longitude, true ecliptic and equinox of date (same frame as the planets)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Finding-Catalog-Data","text":"Finding Catalog Data"},{"type":"paragraph","inlineContent":[{"text":"J2000 coordinates can be found from:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Hipparcos Catalog","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","anchor":"Chiron","text":"Chiron"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"Chiron"},{"text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation.","type":"text"}]},{"level":3,"type":"heading","anchor":"Getting-Chirons-Position","text":"Getting Chiron’s Position"},{"type":"codeListing","code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Accuracy is highest near the reference epochs and degrades as distance increases. Within ±5 years of an epoch, error is expected to be less than 1 arcminute.","type":"text"}]},{"level":2,"type":"heading","anchor":"Observer-Gravity","text":"Observer Gravity"},{"type":"paragraph","inlineContent":[{"text":"Calculate local gravitational acceleration:","type":"text"}]},{"type":"codeListing","code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This accounts for:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Latitude (Earth’s oblateness)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Altitude (distance from Earth’s center)","type":"text"}],"type":"paragraph"}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/advancedfeatures"]}],"kind":"article","sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"],"title":"Advanced","anchor":"Advanced","generated":true}],"references":{"https://simbad.cds.unistra.fr/simbad/":{"type":"link","url":"https:\/\/simbad.cds.unistra.fr\/simbad\/","identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","title":"SIMBAD Astronomical Database","titleInlineContent":[{"text":"SIMBAD Astronomical Database","type":"text"}]},"doc://AstronomyKit/documentation/AstronomyKit/LagrangePointID":{"abstract":[{"text":"Identifies one of the five Lagrange points.","type":"text"}],"url":"\/documentation\/astronomykit\/lagrangepointid","type":"topic","title":"LagrangePointID","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LagrangePointID"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LagrangePointID"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/A