{"kind":"article","identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"N-body simulations, Lagrange points, Jupiter’s moons, and more."}],"seeAlsoSections":[{"title":"Advanced","anchor":"Advanced","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Gravity simulations, Lagrange points, Jupiter’s Galilean moons, rotation axes, atmospheric modeling, fixed stars, and Chiron."}]},{"anchor":"N-Body-Gravity-Simulation","level":2,"text":"N-Body Gravity Simulation","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Simulate the gravitational motion of objects in the solar system.","type":"text"}]},{"anchor":"Creating-a-Simulation","level":3,"text":"Creating a Simulation","type":"heading"},{"type":"codeListing","code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"syntax":"swift"},{"anchor":"Running-the-Simulation","level":3,"text":"Running the Simulation","type":"heading"},{"type":"codeListing","code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"],"syntax":"swift"},{"anchor":"Reversing-Time","level":3,"text":"Reversing Time","type":"heading"},{"type":"codeListing","code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"],"syntax":"swift"},{"anchor":"Lagrange-Points","level":2,"text":"Lagrange Points","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system.","type":"text"}]},{"anchor":"Calculate-Lagrange-Point-Position","level":3,"text":"Calculate Lagrange Point Position","type":"heading"},{"type":"codeListing","code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"],"syntax":"swift"},{"anchor":"The-Five-Lagrange-Points","level":3,"text":"The Five Lagrange Points","type":"heading"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Point","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Location","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stability"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L1"}]}],[{"type":"paragraph","inlineContent":[{"text":"Between bodies","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unstable"}]}]],[[{"inlineContent":[{"type":"text","text":"L2"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beyond smaller body"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Unstable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L3"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beyond larger body"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Unstable"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"L4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"60° ahead"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L5"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"60° behind"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Stable"}],"type":"paragraph"}]]]},{"level":2,"text":"Jupiter’s Galilean Moons","anchor":"Jupiters-Galilean-Moons","type":"heading"},{"inlineContent":[{"text":"Get positions of Io, Europa, Ganymede, and Callisto.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Moon States","anchor":"Moon-States","type":"heading"},{"syntax":"swift","type":"codeListing","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"]},{"level":3,"text":"Checking Moon Position","anchor":"Checking-Moon-Position","type":"heading"},{"syntax":"swift","type":"codeListing","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"]},{"level":3,"text":"Using as CelestialBodies","anchor":"Using-as-CelestialBodies","type":"heading"},{"inlineContent":[{"type":"text","text":"The moons are also available as celestial bodies:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"]},{"level":2,"text":"Planetary Rotation Axes","anchor":"Planetary-Rotation-Axes","type":"heading"},{"inlineContent":[{"type":"text","text":"Get the orientation of a body’s rotation axis and prime meridian."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"]},{"inlineContent":[{"type":"text","text":"This is useful for:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Calculating solar angles on planetary surfaces","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Rendering accurate planetary graphics","type":"text"}]}]}]},{"level":2,"text":"Atmospheric Modeling","type":"heading","anchor":"Atmospheric-Modeling"},{"inlineContent":[{"text":"Model Earth’s atmosphere based on elevation.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Atmosphere at Elevation","type":"heading","anchor":"Atmosphere-at-Elevation"},{"code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Observer’s Atmosphere","type":"heading","anchor":"Observers-Atmosphere"},{"code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Extreme Altitudes","type":"heading","anchor":"Extreme-Altitudes"},{"code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Fixed Stars","type":"heading","anchor":"Fixed-Stars"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"FixedStar","type":"codeVoice"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"code":"Astronomy_DefineStar()","type":"codeVoice"},{"text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates."}],"type":"paragraph"},{"level":3,"text":"Defining a Star","type":"heading","anchor":"Defining-a-Star"},{"code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Getting Positions","type":"heading","anchor":"Getting-Positions"},{"code":["\/\/ Ecliptic longitude (for astrological calculations)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Finding Catalog Data","type":"heading","anchor":"Finding-Catalog-Data"},{"type":"paragraph","inlineContent":[{"text":"J2000 coordinates can be found from:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Hipparcos Catalog"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Chiron","text":"Chiron"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"Chiron","type":"codeVoice"},{"type":"text","text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron."}]}],"type":"aside","name":"Note","style":"note"},{"inlineContent":[{"type":"text","text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Getting-Chirons-Position","text":"Getting Chiron’s Position"},{"code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Accuracy is highest near the reference epochs and degrades with distance from them. Within ±5 years of an epoch, error is expected to be less than 1 arcminute. C