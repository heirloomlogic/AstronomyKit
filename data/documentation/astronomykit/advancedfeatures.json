{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Gravity simulations, Lagrange points, Jupiter’s Galilean moons, rotation axes, atmospheric modeling, fixed stars, and Chiron.","type":"text"}]},{"type":"heading","anchor":"N-Body-Gravity-Simulation","text":"N-Body Gravity Simulation","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simulate the gravitational motion of objects in the solar system."}]},{"type":"heading","anchor":"Creating-a-Simulation","text":"Creating a Simulation","level":3},{"code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Running-the-Simulation","text":"Running the Simulation","level":3},{"type":"codeListing","syntax":"swift","code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"]},{"type":"heading","level":3,"anchor":"Reversing-Time","text":"Reversing Time"},{"type":"codeListing","syntax":"swift","code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"]},{"type":"heading","level":2,"anchor":"Lagrange-Points","text":"Lagrange Points"},{"type":"paragraph","inlineContent":[{"text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system.","type":"text"}]},{"type":"heading","level":3,"anchor":"Calculate-Lagrange-Point-Position","text":"Calculate Lagrange Point Position"},{"type":"codeListing","syntax":"swift","code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"]},{"type":"heading","level":3,"anchor":"The-Five-Lagrange-Points","text":"The Five Lagrange Points"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Point","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Location"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stability","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L1"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Between bodies"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Unstable"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L2"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Beyond smaller body"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unstable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L3"}]}],[{"type":"paragraph","inlineContent":[{"text":"Beyond larger body","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Unstable","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"60° ahead"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stable"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"L5"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"60° behind"}]}],[{"type":"paragraph","inlineContent":[{"text":"Stable","type":"text"}]}]]],"header":"row"},{"type":"heading","level":2,"anchor":"Jupiters-Galilean-Moons","text":"Jupiter’s Galilean Moons"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get positions of Io, Europa, Ganymede, and Callisto."}]},{"type":"heading","level":3,"anchor":"Moon-States","text":"Moon States"},{"type":"codeListing","syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"]},{"type":"heading","level":3,"anchor":"Checking-Moon-Position","text":"Checking Moon Position"},{"type":"codeListing","syntax":"swift","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"]},{"type":"heading","level":3,"anchor":"Using-as-CelestialBodies","text":"Using as CelestialBodies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The moons are also available as celestial bodies:"}]},{"type":"codeListing","syntax":"swift","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"]},{"type":"heading","level":2,"anchor":"Planetary-Rotation-Axes","text":"Planetary Rotation Axes"},{"type":"paragraph","inlineContent":[{"text":"Get the orientation of a body’s rotation axis and prime meridian.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"]},{"type":"paragraph","inlineContent":[{"text":"This is useful for:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculating solar angles on planetary surfaces"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Determining which hemisphere faces Earth"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rendering accurate planetary graphics"}]}]}]},{"type":"heading","level":2,"anchor":"Atmospheric-Modeling","text":"Atmospheric Modeling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Model Earth’s atmosphere based on elevation."}]},{"type":"heading","level":3,"anchor":"Atmosphere-at-Elevation","text":"Atmosphere at Elevation"},{"type":"codeListing","syntax":"swift","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"]},{"type":"heading","level":3,"anchor":"Observers-Atmosphere","text":"Observer’s Atmosphere"},{"type":"codeListing","syntax":"swift","code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"]},{"type":"heading","level":3,"anchor":"Extreme-Altitudes","text":"Extreme Altitudes"},{"type":"codeListing","syntax":"swift","code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"]},{"type":"heading","level":2,"anchor":"Fixed-Stars","text":"Fixed Stars"},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"FixedStar","type":"codeVoice"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"code":"Astronomy_DefineStar()","type":"codeVoice"},{"text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates."}]},{"type":"heading","level":3,"anchor":"Defining-a-Star","text":"Defining a Star"},{"type":"codeListing","syntax":"swift","code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"]},{"type":"heading","level":3,"anchor":"Getting-Positions","text":"Getting Positions"},{"type":"codeListing","syntax":"swift","code":["\/\/ Ecliptic longitude (for astrological calculations)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"]},{"type":"heading","level":3,"anchor":"Finding-Catalog-Data","text":"Finding Catalog Data"},{"type":"paragraph","inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hipparcos Catalog"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Chiron","anchor":"Chiron"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"Chiron"},{"text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"inlineContent":[{"text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Getting Chiron’s Position","anchor":"Getting-Chirons-Position"},{"syntax":"swift","type":"codeListing","code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"]},{"inlineContent":[{"type":"text","text":"Accuracy is highest near the reference epochs and degrades with distance from them. Within ±5 years of an epoch, error is expected to be less than 1 arcminute. Calculations are limited to years 1900 through 2150; times outside that range throw "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/badTime","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Observer Gravity","anchor":"Observer-Gravity"},{"inlineContent":[{"type":"text","text":"Calculate local gravitational acceleration:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"]},{"inlineContent":[{"text":"This accounts for:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Latitude (Earth’s oblateness)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Altitude (distance from Earth’s center)"}],"type":"paragraph"}]}]}]}],"kind":"article","sections":[],"seeAlsoSections":[{"anchor":"Advanced","generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"],"title":"Advanced"}],"abstract":[{"text":"N-body simulations, Lagrange points, Jupiter’s moons, and more.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/advancedfeatures"]}],"metadata":{"roleHeading":"Article","title":"Advanced Features","modules":[{"name":"AstronomyKit"}],"role":"article"},"references":{"doc://AstronomyKit/documentation/AstronomyKit/LagrangePointID":{"kind":"symbol","abstract":[{"text":"Identifies one of the five Lagrange points.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"LagrangePointID"}],"url":"\/documentation\/astronomykit\/lagrangepointid","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LagrangePointID"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","title":"LagrangePointID","role":"symbol"},"doc://AstronomyKit/documentation/AstronomyKit/RotationAxis":{"url":"\/documentation\/astronomykit\/rotationaxis","kind":"symbol"