{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"N-body simulations, Lagrange points, Jupiter’s moons, and more."}],"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","role":"article","title":"Advanced Features"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AdvancedFeatures"},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Chiron","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GravitySimulation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Jupiter","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/JupiterMoons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RotationAxis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Atmosphere"],"title":"Advanced","anchor":"Advanced","generated":true}],"variants":[{"paths":["\/documentation\/astronomykit\/advancedfeatures"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit includes advanced features for specialized astronomical calculations, including gravity simulations, Lagrange point positions, Jupiter’s Galilean moons, planetary rotation axes, and atmospheric modeling.","type":"text"}]},{"anchor":"N-Body-Gravity-Simulation","type":"heading","level":2,"text":"N-Body Gravity Simulation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simulate the gravitational motion of objects in the solar system."}]},{"anchor":"Creating-a-Simulation","type":"heading","level":3,"text":"Creating a Simulation"},{"code":["\/\/ Initial state for a small body (e.g., a comet)","let initialState = StateVector(...)  \/\/ Position and velocity","","let sim = try GravitySimulation(","    origin: .sun,","    time: .now,","    initialState: initialState",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Running-the-Simulation","type":"heading","level":3,"text":"Running the Simulation"},{"code":["\/\/ Advance 30 days","try sim.update(to: .now.addingDays(30))","","\/\/ Get the current simulation time","let currentTime = sim.currentTime()","","\/\/ Get state of a major body","let jupiterState = try sim.state(of: .jupiter)","print(\"Jupiter position: \\(jupiterState.position)\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Reversing-Time","type":"heading","level":3,"text":"Reversing Time"},{"code":["\/\/ Switch direction (forward ↔ backward)","sim.swap()","","\/\/ Now updates go backward in time","try sim.update(to: .now.addingDays(-30))"],"type":"codeListing","syntax":"swift"},{"anchor":"Lagrange-Points","type":"heading","level":2,"text":"Lagrange Points"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lagrange points are stable\/semi-stable locations in a two-body gravitational system."}]},{"anchor":"Calculate-Lagrange-Point-Position","type":"heading","level":3,"text":"Calculate Lagrange Point Position"},{"code":["\/\/ Sun-Earth L2 (where JWST orbits)","let l2 = try LagrangePoint.calculate(","    point: .l2,","    at: .now,","    majorBody: .sun,","    minorBody: .earth",")","print(\"L2 position: \\(l2.position)\")","print(\"L2 velocity: \\(l2.velocity)\")"],"type":"codeListing","syntax":"swift"},{"anchor":"The-Five-Lagrange-Points","type":"heading","level":3,"text":"The Five Lagrange Points"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Point"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Location","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stability","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"L1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Between bodies","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Unstable"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L2"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beyond smaller body"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Unstable"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"L3"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Beyond larger body"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Unstable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"L4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"60° ahead"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"L5","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"60° behind"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stable","type":"text"}],"type":"paragraph"}]]]},{"type":"heading","text":"Jupiter’s Galilean Moons","anchor":"Jupiters-Galilean-Moons","level":2},{"type":"paragraph","inlineContent":[{"text":"Get positions of Io, Europa, Ganymede, and Callisto.","type":"text"}]},{"type":"heading","text":"Moon States","anchor":"Moon-States","level":3},{"syntax":"swift","type":"codeListing","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ Each moon has position and velocity relative to Jupiter","print(\"Io: \\(moons.io.position)\")","print(\"Europa: \\(moons.europa.position)\")","print(\"Ganymede: \\(moons.ganymede.position)\")","print(\"Callisto: \\(moons.callisto.position)\")"]},{"type":"heading","text":"Checking Moon Position","anchor":"Checking-Moon-Position","level":3},{"syntax":"swift","type":"codeListing","code":["let moons = try Jupiter.moons(at: .now)","","\/\/ X > 0 means east of Jupiter","if moons.io.position.x > 0 {","    print(\"Io is east of Jupiter\")","} else {","    print(\"Io is west of Jupiter\")","}"]},{"type":"heading","text":"Using as CelestialBodies","anchor":"Using-as-CelestialBodies","level":3},{"type":"paragraph","inlineContent":[{"text":"The moons are also available as celestial bodies:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["for moon in CelestialBody.galileanMoons {","    let eq = try moon.equatorial(at: .now)","    print(\"\\(moon.name): RA \\(eq.rightAscension)h\")","}"]},{"type":"heading","text":"Planetary Rotation Axes","anchor":"Planetary-Rotation-Axes","level":2},{"type":"paragraph","inlineContent":[{"text":"Get the orientation of a body’s rotation axis and prime meridian.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let axis = try CelestialBody.mars.rotationAxis(at: .now)","","\/\/ North pole direction (J2000)","print(\"Pole RA: \\(axis.rightAscension) hours\")","print(\"Pole Dec: \\(axis.declination)°\")","","\/\/ Prime meridian rotation","print(\"Spin angle: \\(axis.spin)°\")","","\/\/ Unit vector toward north pole","let north = axis.north"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Calculating solar angles on planetary surfaces","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Determining which hemisphere faces Earth","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rendering accurate planetary graphics"}]}]}]},{"type":"heading","text":"Atmospheric Modeling","anchor":"Atmospheric-Modeling","level":2},{"type":"paragraph","inlineContent":[{"text":"Model Earth’s atmosphere based on elevation.","type":"text"}]},{"type":"heading","text":"Atmosphere at Elevation","anchor":"Atmosphere-at-Elevation","level":3},{"syntax":"swift","type":"codeListing","code":["let atmosphere = try Atmosphere.at(elevation: 5000)  \/\/ 5000m","print(\"Pressure: \\(atmosphere.pressure) mbar\")","print(\"Temperature: \\(atmosphere.temperature)°C\")","print(\"Density: \\(atmosphere.density)\")  \/\/ Relative to sea level"]},{"type":"heading","text":"Observer’s Atmosphere","anchor":"Observers-Atmosphere","level":3},{"syntax":"swift","type":"codeListing","code":["let observer = Observer(latitude: 39.7, longitude: -104.9, height: 1600)","let atm = try observer.atmosphere","print(\"Local pressure: \\(atm.pressure) mbar\")"]},{"level":3,"anchor":"Extreme-Altitudes","text":"Extreme Altitudes","type":"heading"},{"syntax":"swift","code":["\/\/ Mount Everest summit","let everest = try Atmosphere.at(elevation: 8848.86)","print(\"Pressure: \\(Int(everest.pressure)) mbar\")  \/\/ ~314 mbar (vs 1013 at sea level)"],"type":"codeListing"},{"level":2,"anchor":"Fixed-Stars","text":"Fixed Stars","type":"heading"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"FixedStar","type":"codeVoice"},{"text":" is an AstronomyKit addition. It wraps Astronomy Engine’s ","type":"text"},{"code":"Astronomy_DefineStar()","type":"codeVoice"},{"text":" with a thread-safe, Swift-idiomatic value type and mutex-protected calculation slots.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"},{"inlineContent":[{"type":"text","text":"Define and track fixed stars by their J2000 catalog coordinates."}],"type":"paragraph"},{"level":3,"anchor":"Defining-a-Star","text":"Defining a Star","type":"heading"},{"code":["\/\/ Algol (Beta Persei) - the \"Demon Star\"","let algol = FixedStar(","    name: \"Algol\",","    rightAscension: 3.136148,  \/\/ J2000 RA in hours","    declination: 40.9556,      \/\/ J2000 Dec in degrees","    distance: 92.95            \/\/ Light-years",")","","\/\/ Sirius - the brightest star","let sirius = FixedStar(","    name: \"Sirius\",","    rightAscension: 6.7525,","    declination: -16.7161,","    distance: 8.6",")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Getting-Positions","text":"Getting Positions","type":"heading"},{"code":["\/\/ Ecliptic longitude, true ecliptic and equinox of date (same frame as the planets)","let longitude = try algol.eclipticLongitude(at: .now)","","\/\/ Position in local sky","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try algol.horizon(at: .now, from: observer)","","\/\/ Constellation","let constellation = try sirius.constellation(at: .now)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Finding-Catalog-Data","text":"Finding Catalog Data","type":"heading"},{"inlineContent":[{"type":"text","text":"J2000 coordinates can be found from:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/simbad.cds.unistra.fr\/simbad\/"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Hipparcos Catalog","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Yale Bright Star Catalog","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Chiron","text":"Chiron","type":"heading"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"Chiron","type":"codeVoice"},{"text":" is an AstronomyKit addition. Astronomy Engine has no built-in support for 2060 Chiron.","type":"text"}]}],"name":"Note","type":"aside"},{"inlineContent":[{"type":"text","text":"AstronomyKit provides gravity-simulated positions for the centaur 2060 Chiron using pre-computed JPL Horizons state vectors at reference epochs (2000, 2010, 2020, 2030, 2040). The nearest epoch is selected and propagated via n-body gravity simulation."}],"type":"paragraph"},{"level":3,"anchor":"Getting-Chirons-Position","text":"Getting Chiron’s Position","type":"heading"},{"code":["\/\/ Ecliptic longitude","let longitude = try Chiron.eclipticLongitude(at: .now)","","\/\/ Full ecliptic coordinates","let ecliptic = try Chiron.ecliptic(at: .now)","","\/\/ Horizon position for an observer","let observer = Observer(latitude: 40.7, longitude: -74.0)","let horizon = try Chiron.horizon(at: .now, from: observer)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Accuracy is highest near the reference epochs and degrades as distance increases. Within ±5 years of an epoch, error is expected to be less than 1 arcminute."}],"type":"paragraph"},{"text":"Observer Gravity","level":2,"anchor":"Observer-Gravity","type":"heading"},{"inlineContent":[{"text":"Calculate local gravitational acceleration:","type":"text"}],"type":"paragraph"},{"code":["let observer = Observer(latitude: 45.0, longitude: 0.0, height: 0)","let gravity = observer.gravity  \/\/ m\/s²","print(\"Local g: \\(gravity) m\/s²\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This accounts for:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Latitude (Earth’s oblateness)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Altitude (distance from Earth’s center)","type":"text"}]}]}]}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/FixedStar":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedStar","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/FixedStar","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FixedStar"}],"abstract":[{"type":"text","text":"A fixed star defined by its J2000 equatorial coordinates."}],"title":"FixedStar","kind":"symbol","url":"\/documentation\/astronomykit\/fixedstar"},"doc://AstronomyKit/documentation/AstronomyKit/LagrangePoint":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LagrangePoint","kind":"identifier"}],"title":"LagrangePoint","role":"symbol","type":"topic","identifier":"doc:\/\/Astronomy