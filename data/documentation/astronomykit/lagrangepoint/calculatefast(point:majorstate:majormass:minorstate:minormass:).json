teFast"},{"kind":"text","text":"("},{"kind":"externalParam","text":"point"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12AstronomyKit15LagrangePointIDO","text":"LagrangePointID","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"majorState"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12AstronomyKit11StateVectorV","text":"StateVector","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/StateVector"},{"kind":"text","text":", "},{"kind":"externalParam","text":"majorMass"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"minorState"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12AstronomyKit11StateVectorV","text":"StateVector","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/StateVector"},{"kind":"text","text":", "},{"kind":"externalParam","text":"minorMass"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"StateVector","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/StateVector","preciseIdentifier":"s:12AstronomyKit11StateVectorV","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"Which Lagrange point to calculate (L1-L5).","type":"text"}],"type":"paragraph"}],"name":"point"},{"content":[{"inlineContent":[{"type":"text","text":"The state vector of the larger body."}],"type":"paragraph"}],"name":"majorState"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The mass product (GM) of the larger body in AU³\/day².","type":"text"}]}],"name":"majorMass"},{"content":[{"inlineContent":[{"text":"The state vector of the smaller body.","type":"text"}],"type":"paragraph"}],"name":"minorState"},{"content":[{"inlineContent":[{"type":"text","text":"The mass product (GM) of the smaller body in AU³\/day²."}],"type":"paragraph"}],"name":"minorMass"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"inlineContent":[{"text":"The state vector of the Lagrange point.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This is faster than "},{"type":"reference","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint\/calculate(point:at:majorBody:minorBody:)","isActive":true},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"you already have the state vectors and mass products of both bodies,"},{"type":"text","text":" "},{"type":"text","text":"avoiding redundant position lookups."}],"type":"paragraph"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/invalidParameter","isActive":true,"type":"reference"},{"type":"text","text":" if the squared distance between the two"},{"type":"text","text":" "},{"type":"text","text":"positions is zero or not finite (coincident positions or a non-finite coordinate, for"},{"type":"text","text":" "},{"type":"text","text":"example), or if either mass is not a positive finite number. Also for L4 and L5 if the"},{"type":"text","text":" "},{"type":"text","text":"tangent vector, which lies in the orbital plane at right angles to the separation, has"},{"type":"text","text":" "},{"type":"text","text":"zero or non-finite length. That happens when the relative velocity is zero or exactly"},{"type":"text","text":" "},{"type":"text","text":"parallel to the separation, which leaves the orbital plane undefined; when the relative"},{"type":"text","text":" "},{"type":"text","text":"velocity is not finite; or when the arithmetic that builds the tangent and its length"},{"type":"text","text":" "},{"type":"text","text":"underflows or overflows. Also if any field of the result would not be finite, as with an"},{"type":"text","text":" "},{"type":"text","text":"L1 to L3 relative velocity that is not finite."},{"type":"text","text":" "},{"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstronomyError\/noConvergence","type":"reference","isActive":true},{"type":"text","text":" if the iteration for L1, L2, or L3 does not converge"},{"type":"text","text":" "},{"type":"text","text":"within its step limit, as can happen for L3 with masses of similar size."},{"type":"text","text":" "},{"type":"text","text":"Other "},{"code":"AstronomyError","type":"codeVoice"},{"type":"text","text":" values if the calculation fails."}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint\/calculateFast(point:majorState:majorMass:minorState:minorMass:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePoint"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/lagrangepoint\/calculatefast(point:majorstate:majormass:minorstate:minormass:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://AstronomyKit/documentation/AstronomyKit/LagrangePointID":{"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LagrangePointID"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LagrangePointID","type":"topic","navigatorTitle":[{"kind":"identifier","text":"LagrangePointID"}],"abstract":[{"text":"Identifies one of the five Lagrange points.","type":