e a planet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculating day length"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Custom-Altitude-Searches","text":"Custom Altitude Searches"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find when a body reaches a specific altitude:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Astronomical twilight begins when Sun is 18° below horizon","let twilight = try CelestialBody.sun.searchAltitude(","    -18.0,","    direction: .set,","    after: .now,","    from: observer",")","if let time = twilight {","    print(\"Astronomical twilight begins: \\(time)\")","}"]},{"type":"heading","level":3,"anchor":"Civil-and-Nautical-Twilight","text":"Civil and Nautical Twilight"},{"type":"codeListing","syntax":"swift","code":["\/\/ Civil twilight: Sun at -6°","let civilTwilight = try CelestialBody.sun.searchAltitude(","    -6.0, direction: .set, after: .now, from: observer",")","","\/\/ Nautical twilight: Sun at -12°","let nauticalTwilight = try CelestialBody.sun.searchAltitude(","    -12.0, direction: .set, after: .now, from: observer",")"]},{"type":"heading","level":3,"anchor":"Minimum-Observation-Altitude","text":"Minimum Observation Altitude"},{"type":"codeListing","syntax":"swift","code":["\/\/ Find when Mars rises above 20° (good for observation)","let observable = try CelestialBody.mars.searchAltitude(","    20.0,","    direction: .rise,","    after: .now,","    from: observer",")"]},{"type":"heading","level":2,"anchor":"Hour-Angle-Searches","text":"Hour Angle Searches"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for a specific hour angle:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Hour angle 0 = culmination (upper transit)","let upperTransit = try CelestialBody.saturn.searchHourAngle(","    0,","    after: .now,","    from: observer",")","","\/\/ Hour angle 12 = lower culmination","let lowerTransit = try CelestialBody