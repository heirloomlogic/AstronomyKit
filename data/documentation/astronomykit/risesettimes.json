{"metadata":{"title":"Rise and Set Times","roleHeading":"Article","role":"article","modules":[{"name":"AstronomyKit"}]},"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"AstronomyKit can find rise times, set times, culmination (transit), and times when bodies reach specific altitudes. These calculations account for atmospheric refraction."}],"type":"paragraph"},{"level":2,"anchor":"Basic-Rise-and-Set","text":"Basic Rise and Set","type":"heading"},{"level":3,"anchor":"Sunrise-and-Sunset","text":"Sunrise and Sunset","type":"heading"},{"syntax":"swift","code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","if let sunset = try CelestialBody.sun.setTime(after: .now, from: observer) {","    print(\"Sunset: \\(sunset.date)\")","}"],"type":"codeListing"},{"level":3,"anchor":"Moonrise-and-Moonset","text":"Moonrise and Moonset","type":"heading"},{"syntax":"swift","code":["if let moonrise = try CelestialBody.moon.riseTime(after: .now, from: observer) {","    print(\"Moonrise: \\(moonrise)\")","}","","if let moonset = try CelestialBody.moon.setTime(after: .now, from: observer) {","    print(\"Moonset: \\(moonset)\")","}"],"type":"codeListing"},{"level":3,"anchor":"Planet-Rise-and-Set","text":"Planet Rise and Set","type":"heading"},{"syntax":"swift","code":["if let marsRise = try CelestialBody.mars.riseTime(after: .now, from: observer) {","    print(\"Mars rises at \\(marsRise)\")","}"],"type":"codeListing"},{"level":2,"anchor":"Culmination-Transit","text":"Culmination (Transit)","type":"heading"},{"inlineContent":[{"type":"text","text":"Culmination is when a body crosses the meridian and reaches its highest altitude:"}],"type":"paragraph"},{"syntax":"swift","code":["let transit = try CelestialBody.sun.culmination(after: .now, from: observer)","print(\"Solar noon: \\(transit.time)\")","print(\"Max altitude: \\(transit.horizon.altitude)°\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is useful for:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Finding solar noon","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Determining the best time to observe a planet","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calculating day length","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Custom-Altitude-Searches","text":"Custom Altitude Searches","type":"heading"},{"inlineContent":[{"type":"text","text":"Find when a body reaches a specific altitude:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Astronomical twilight begins when Sun is 18° below horizon","let twilight = try CelestialBody.sun.searchAltitude(","    -18.0,","    direction: .set,","    after: .now,","    from: observer",")","if let time = twilight {","    print(\"Astronomical twilight begins: \\(time)\")","}"],"type":"codeListing"},{"level":3,"anchor":"Civil-and-Nautical-Twilight","text":"Civil and Nautical Twilight","type":"heading"},{"syntax":"swift","code":["\/\/ Civil twilight: Sun at -6°","let civilTwilight = try CelestialBody.sun.searchAltitude(","    -6.0, direction: .set, after: .now, from: observer",")","","\/\/ Nautical twilight: Sun at -12°","let nauticalTwilight = try CelestialBody.sun.searchAltitude(","    -12.0, direction: .set, after: .now, from: observer",")"],"type":"codeListing"},{"level":3,"anchor":"Minimum-Observation-Altitude","text":"Minimum Observation Altitude","type":"heading"},{"syntax":"swift","code":["\/\/ Find when Mars rises above 20° (good for observation)","let observable = try CelestialBody.mars.searchAltitude(","    20.0,","    direction: .rise,","    after: .now,","    from: observer",")"],"type":"codeListing"},{"level":2,"anchor":"Hour-Angle-Searches","text":"Hour Angle Searches","type":"heading"},{"inlineContent":[{"type":"text","text":"Search for a specific hour angle:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Hour angle 0 = culmination (upper transit)","let upperTransit = try CelestialBody.saturn.searchHourAngle(","    0,","    after: .now,","    from: observer",")","","\/\/ Hour angle 12 = lower culmination","let lowerTransit = try CelestialBody.saturn.searchHourAngle(","    12,","    after: .now,","    from: observer",")"],"type":"codeListing"},{"level":2,"anchor":"Search-Limits","text":"Search Limits","type":"heading"},{"inlineContent":[{"type":"text","text":"All searches have a time limit (default: 366 days):"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Limit search to next 30 days","let sunrise = try CelestialBody.sun.riseTime(","    after: .now,","    from: observer,","    limitDays: 30",")"],"type":"codeListing"},{"level":2,"anchor":"Handling-No-Result","text":"Handling “No Result”","type":"heading"},{"inlineContent":[{"type":"text","text":"Rise\/set searches return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if no event occurs in the search period:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ In polar regions, the Sun may not rise\/set","let arcticObserver = Observer(latitude: 78.0, longitude: 15.0)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: arcticObserver) {","    print(\"Sunrise: \\(sunrise)\")","} else {","    print(\"Sun does not rise during this period (polar night\/day)\")","}"],"type":"codeListing"},{"level":2,"anchor":"Daily-Events","text":"Daily Events","type":"heading"},{"inlineContent":[{"type":"text","text":"Get all events for a single day:"}],"type":"paragraph"},{"syntax":"swift","code":["let events = try DailyEvents(","    body: .sun,","    date: .now,","    from: observer",")","","if let rise = events.rise {","    print(\"Rise: \\(rise)\")","}","if let transit = events.culmination {","    print(\"Transit: \\(transit.time) at \\(transit.horizon.altitude)°\")","}","if let set = events.set {","    print(\"Set: \\(set)\")","}","","if events.isVisible {","    print(\"Sun is visible at some point today\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is convenient for building daily almanac displays."}],"type":"paragraph"},{"level":2,"anchor":"Time-Zones","text":"Time Zones","type":"heading"},{"inlineContent":[{"type":"text","text":"All returned times are in UTC. Convert for display:"}],"type":"paragraph"},{"syntax":"swift","code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise: \\(formatter.string(from: sunrise.date))\")"],"type":"codeListing"}],"kind":"content"}],"sections":[],"abstract":[{"text":"Calculate when celestial bodies rise, set, and reach their highest point.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/risesettimes"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseEvent","doc:\/\/Astro