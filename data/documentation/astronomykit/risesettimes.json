","    direction: .rise,","    after: .now,","    from: observer",")"]},{"text":"Hour Angle Searches","type":"heading","level":2,"anchor":"Hour-Angle-Searches"},{"type":"paragraph","inlineContent":[{"text":"Search for a specific hour angle:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Hour angle 0 = culmination (upper transit)","let upperTransit = try CelestialBody.saturn.searchHourAngle(","    0,","    after: .now,","    from: observer",")","","\/\/ Hour angle 12 = lower culmination","let lowerTransit = try CelestialBody.saturn.searchHourAngle(","    12,","    after: .now,","    from: observer",")"]},{"text":"Search Limits","type":"heading","level":2,"anchor":"Search-Limits"},{"type":"paragraph","inlineContent":[{"text":"All searches have a time limit (default: 366 days):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Limit search to next 30 days","let sunrise = try CelestialBody.sun.riseTime(","    after: .now,","    from: observer,","    limitDays: 30",")"]},{"text":"Handling “No Result”","type":"heading","level":2,"anchor":"Handling-No-Result"},{"type":"paragraph","inlineContent":[{"text":"Rise\/set searches return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if no event occurs in the search period:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ In polar regions, the Sun may not rise\/set","let arcticObserver = Observer(latitude: 78.0, longitude: 15.0)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: arcticObserver) {","    print(\"Sunrise: \\(sunrise)\")","} else {","    print(\"Sun does not rise during this period (polar night\/day)\")","}"]},{"text":"Daily Events","type":"heading","level":2,"anchor":"Daily-Events"},{"type":"paragraph","inlineContent":[{"text":"Get all events for a single day:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let events = try DailyEvents(","    body: .sun,","    date: .now,","    from: observer",")","","if let rise = events.rise {","    print(\"Rise: \\(rise)\")","}","if let transit = events.culmination {","    print(\"Transit: \\(transit.time) at \\(transit.horizon.altitude)°\")","}","if let set = events.set {","    print(\"Set: \\(set)\")","}","","if events.isVisible {","    print(\"Sun is visible at some point today\")","}"]},{"type":"paragraph","inlineContent":[{"text":"This is convenient for building daily almanac displays.","type":"text"}]},{"text":"Time Zones","type":"heading","level":2,"anchor":"Time-Zones"},{"type":"paragraph","inlineContent":[{"text":"All returned times are in UTC. Convert for display:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise: \\(formatter.string(from: sunrise.date))\")"]}]}],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"AstronomyKit"}],"roleHeading":"Article","role":"article","title":"Rise and Set Times"},"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","doc:\/\/AstronomyK