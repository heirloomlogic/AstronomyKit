{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Calculate when celestial bodies rise, set, and reach their highest point.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","title":"Rise and Set Times","modules":[{"name":"AstronomyKit"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes"},"seeAlsoSections":[{"identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LocalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseEvent","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/EclipseKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Apsis","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/ApsisKind","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Elongation","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Visibility"],"generated":true,"anchor":"Events","title":"Events"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/astronomykit\/risesettimes"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"AstronomyKit can find rise times, set times, culmination (transit), and times when bodies reach specific altitudes. These calculations account for atmospheric refraction.","type":"text"}]},{"anchor":"Basic-Rise-and-Set","type":"heading","level":2,"text":"Basic Rise and Set"},{"anchor":"Sunrise-and-Sunset","type":"heading","level":3,"text":"Sunrise and Sunset"},{"code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","if let sunset = try CelestialBody.sun.setTime(after: .now, from: observer) {","    print(\"Sunset: \\(sunset.date)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Moonrise-and-Moonset","type":"heading","level":3,"text":"Moonrise and Moonset"},{"code":["if let moonrise = try CelestialBody.moon.riseTime(after: .now, from: observer) {","    print(\"Moonrise: \\(moonrise)\")","}","","if let moonset = try CelestialBody.moon.setTime(after: .now, from: observer) {","    print(\"Moonset: \\(moonset)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Planet-Rise-and-Set","type":"heading","level":3,"text":"Planet Rise and Set"},{"code":["if let marsRise = try CelestialBody.mars.riseTime(after: .now, from: observer) {","    print(\"Mars rises at \\(marsRise)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Culmination-Transit","type":"heading","level":2,"text":"Culmination (Transit)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Culmination is when a body crosses the meridian and reaches its highest altitude:"}]},{"code":["let transit = try CelestialBody.sun.culmination(after: .now, from: observer)","print(\"Solar noon: \\(transit.time)\")","print(\"Max altitude: \\(transit.horizon.altitude)°\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is useful for:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Finding solar noon"}]}]},{"content":[{"inlineContent":[{"text":"Determining the best time to observe a planet","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculating day length"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Custom Altitude Searches","anchor":"Custom-Altitude-Searches"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find when a body reaches a specific altitude:"}]},{"type":"codeListing","code":["\/\/ Astronomical twilight begins when Sun is 18° below horizon","let twilight = try CelestialBody.sun.searchAltitude(","    -18.0,","    direction: .set,","    after: .now,","    from: observer",")","if let time = twilight {","    print(\"Astronomical twilight begins: \\(time)\")","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Civil and Nautical Twilight","anchor":"Civil-and-Nautical-Twilight"},{"type":"codeListing","code":["\/\/ Civil twilight: Sun at -6°","let civilTwilight = try CelestialBody.sun.searchAltitude(","    -6.0, direction: .set, after: .now, from: observer",")","","\/\/ Nautical twilight: Sun at -12°","let nauticalTwilight = try CelestialBody.sun.searchAltitude(","    -12.0, direction: .set, after: .now, from: observer",")"],"syntax":"swift"},{"type":"heading","level":3,"text":"Minimum Observation Altitude","anchor":"Minimum-Observation-Altitude"},{"type":"codeListing","code":["\/\/ Find when Mars rises above 20° (good for observation)","let observable = try CelestialBody.mars.searchAltitude(","    20.0,","    direction: .rise,","    after: .now,","    from: observer",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Hour Angle Searches","anchor":"Hour-Angle-Searches"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for a specific hour angle:"}]},{"type":"codeListing","code":["\/\/ Hour angle 0 = culmination (upper transit)","let upperTransit = try CelestialBody.saturn.searchHourAngle(","    0,","    after: .now,","    from: observer",")","","\/\/ Hour angle 12 = lower culmination","let lowerTransit = try CelestialBody.saturn.searchHourAngle(","    12,","    after: .now,","    from: observer",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Search Limits","anchor":"Search-Limits"},{"type":"paragraph","inlineContent":[{"text":"All searches have a time limit (default: 366 days):","type":"text"}]},{"type":"codeListing","code":["\/\/ Limit search to next 30 days","let sunrise = try CelestialBody.sun.riseTime(","    after: .now,","    from: observer,","    limitDays: 30",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Handling “No Result”","anchor":"Handling-No-Result"},{"type":"paragraph","inlineContent":[{"text":"Rise\/set searches return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if no event occurs in the search period:","type":"text"}]},{"type":"codeListing","code":["\/\/ In polar regions, the Sun may not rise\/set","let arcticObserver = Observer(latitude: 78.0, longitude: 15.0)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: arcticObserver) {","    print(\"Sunrise: \\(sunrise)\")","} else {","    print(\"Sun does not rise during this period (polar night\/day)\")","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Daily Events","anchor":"Daily-Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Get all events for a single day:"}]},{"type":"codeListing","code":["let events = try DailyEvents(","    body: .sun,","    date: .now,","    from: observer",")","","if let rise = events.rise {","    print(\"Rise: \\(rise)\")","}","if let transit = events.culmination {","    print(\"Transit: \\(transit.time) at \\(transit.horizon.altitude)°\")","}","if let set = events.set {","    print(\"Set: \\(set)\")","}","","if events.isVisible {","    print(\"Sun is visible at some point today\")","}"],"syntax":"swift"},{"inlineContent":[{"text":"This is convenient for building daily almanac displays.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Time Zones","anchor":"Time-Zones"},{"inlineContent":[{"text":"All returned times are in UTC. Convert for display:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise: \\(formatter.string(from: sunrise.date))\")"]}]}],"references":{"doc://AstronomyKit/documentation/AstronomyKit/GlobalSolarEclipse":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GlobalSolarEclipse","kind":"identifier"}],"title":"GlobalSolarEclipse","role":"symbol","type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","url":"\/documentation\/astronomykit\/globalsolareclipse","navigatorTitle":[{"text":"GlobalSolarEclipse","kind":"identifier"}],"abstract":[{"text":"Information about a solar eclipse as seen globally.","type":"text"}],"kind":"symbol"},"https://github.com/cosinekitty/astronomy":{"type":"link","identifier":"https:\/\/github.com\/cosinekitty\/astronomy","title":"Astronomy Engine","titleInlineContent":[{"type":"text","text":"Astronomy Engine"}],"url":"https:\/\/github.com\/cosinekitty\/astronomy"},"doc://AstronomyKit/documentation/AstronomyKit/AstroSearch":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AstroSearch","kind":"identifier"}],"identifier":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","type":"topic","navigatorTitle":[{"text":"AstroSearch","kind":"identifier"}],"abstract":[{"type":"text","text":"Generic root-finding search for custom astronomical events."}],"kind":"symbol","title":"AstroSearch","url":"\/documentation\/astronomykit\/astrosearch"},"doc://AstronomyKit/documentation/AstronomyKit/Visibility":{"navigatorTitle":[{"kind":"identifier","text":"Visibility"}],"type":"topic","identifier":"doc:\/\/AstronomyKit\/documentation\/Astronom