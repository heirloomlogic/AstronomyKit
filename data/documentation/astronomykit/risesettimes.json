servation-Altitude","level":3,"type":"heading","text":"Minimum Observation Altitude"},{"syntax":"swift","code":["\/\/ Find when Mars rises above 20° (good for observation)","let observable = try CelestialBody.mars.searchAltitude(","    20.0,","    direction: .rise,","    after: .now,","    from: observer",")"],"type":"codeListing"},{"anchor":"Hour-Angle-Searches","level":2,"type":"heading","text":"Hour Angle Searches"},{"type":"paragraph","inlineContent":[{"text":"Search for a specific hour angle:","type":"text"}]},{"code":["\/\/ Hour angle 0 = culmination (upper transit)","let upperTransit = try CelestialBody.saturn.searchHourAngle(","    0,","    after: .now,","    from: observer",")","","\/\/ Hour angle 12 = lower culmination","let lowerTransit = try CelestialBody.saturn.searchHourAngle(","    12,","    after: .now,","    from: observer",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Search Limits","anchor":"Search-Limits"},{"type":"paragraph","inlineContent":[{"text":"All searches have a time limit (default: 366 days):","type":"text"}]},{"code":["\/\/ Limit search to next 30 days","let sunrise = try CelestialBody.sun.riseTime(","    after: .now,","    from: observer,","    limitDays: 30",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Handling-No-Result","level":2,"text":"Handling “No Result”","type":"heading"},{"inlineContent":[{"type":"text","text":"Rise\/set searches return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if no event occurs in the search period:"}],"type":"paragraph"},{"code":["\/\/ In polar regions, the Sun may not rise\/set","let arcticObserver = Observer(latitude: 78.0, longitude: 15.0)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: arcticObserver) {","    print(\"Sunrise: \\(sunrise)\")","} else {","    print(\"Sun does not rise during this period (polar night\/day)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Daily-Events","level":2,"text":"Daily E