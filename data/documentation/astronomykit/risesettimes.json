{"kind":"article","abstract":[{"text":"Calculate when celestial bodies rise, set, and reach their highest point.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"AstronomyKit can find rise times, set times, culmination (transit), and times when bodies reach specific altitudes. These calculations account for atmospheric refraction."}],"type":"paragraph"},{"text":"Basic Rise and Set","anchor":"Basic-Rise-and-Set","type":"heading","level":2},{"text":"Sunrise and Sunset","anchor":"Sunrise-and-Sunset","type":"heading","level":3},{"code":["let observer = Observer(latitude: 40.7128, longitude: -74.0060)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","if let sunset = try CelestialBody.sun.setTime(after: .now, from: observer) {","    print(\"Sunset: \\(sunset.date)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Moonrise and Moonset","anchor":"Moonrise-and-Moonset","type":"heading","level":3},{"code":["if let moonrise = try CelestialBody.moon.riseTime(after: .now, from: observer) {","    print(\"Moonrise: \\(moonrise)\")","}","","if let moonset = try CelestialBody.moon.setTime(after: .now, from: observer) {","    print(\"Moonset: \\(moonset)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Planet Rise and Set","anchor":"Planet-Rise-and-Set","type":"heading","level":3},{"code":["if let marsRise = try CelestialBody.mars.riseTime(after: .now, from: observer) {","    print(\"Mars rises at \\(marsRise)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Culmination (Transit)","anchor":"Culmination-Transit","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Culmination is when a body crosses the meridian and reaches its highest altitude:"}],"type":"paragraph"},{"code":["let transit = try CelestialBody.sun.culmination(after: .now, from: observer)","print(\"Solar noon: \\(transit.time)\")","print(\"Max altitude: \\(transit.horizon.altitude)°\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is useful for:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Finding solar noon","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Determining the best time to observe a planet","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Calculating day length","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Custom Altitude Searches","anchor":"Custom-Altitude-Searches","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Find when a body reaches a specific altitude:"}],"type":"paragraph"},{"code":["\/\/ Astronomical twilight begins when Sun is 18° below horizon","let twilight = try CelestialBody.sun.searchAltitude(","    -18.0,","    direction: .set,","    after: .now,","    from: observer",")","if let time = twilight {","    print(\"Astronomical twilight begins: \\(time)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Civil and Nautical Twilight","anchor":"Civil-and-Nautical-Twilight","type":"heading","level":3},{"code":["\/\/ Civil twilight: Sun at -6°","let civilTwilight = try CelestialBody.sun.searchAltitude(","    -6.0, direction: .set, after: .now, from: observer",")","","\/\/ Nautical twilight: Sun at -12°","let nauticalTwilight = try CelestialBody.sun.searchAltitude(","    -12.0, direction: .set, after: .now, from: observer",")"],"syntax":"swift","type":"codeListing"},{"text":"Minimum Observation Altitude","anchor":"Minimum-Observation-Altitude","type":"heading","level":3},{"code":["\/\/ Find when Mars rises above 20° (good for observation)","let observable = try CelestialBody.mars.searchAltitude(","    20.0,","    direction: .rise,","    after: .now,","    from: observer",")"],"syntax":"swift","type":"codeListing"},{"text":"Hour Angle Searches","anchor":"Hour-Angle-Searches","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Search for a specific hour angle:"}],"type":"paragraph"},{"code":["\/\/ Hour angle 0 = culmination (upper transit)","let upperTransit = try CelestialBody.saturn.searchHourAngle(","    0,","    after: .now,","    from: observer",")","","\/\/ Hour angle 12 = lower culmination","let lowerTransit = try CelestialBody.saturn.searchHourAngle(","    12,","    after: .now,","    from: observer",")"],"syntax":"swift","type":"codeListing"},{"text":"Search Limits","anchor":"Search-Limits","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"All searches have a time limit (default: 366 days):"}],"type":"paragraph"},{"code":["\/\/ Limit search to next 30 days","let sunrise = try CelestialBody.sun.riseTime(","    after: .now,","    from: observer,","    limitDays: 30",")"],"syntax":"swift","type":"codeListing"},{"text":"Handling “No Result”","anchor":"Handling-No-Result","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Rise\/set searches return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if no event occurs in the search period:"}],"type":"paragraph"},{"code":["\/\/ In polar regions, the Sun may not rise\/set","let arcticObserver = Observer(latitude: 78.0, longitude: 15.0)","","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: arcticObserver) {","    print(\"Sunrise: \\(sunrise)\")","} else {","    print(\"Sun does not rise during this period (polar night\/day)\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Daily Events","anchor":"Daily-Events","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Get all events for a single day:"}],"type":"paragraph"},{"code":["let events = try DailyEvents(","    body: .sun,","    date: .now,","    from: observer",")","","if let rise = events.rise {","    print(\"Rise: \\(rise)\")","}","if let transit = events.culmination {","    print(\"Transit: \\(transit.time) at \\(transit.horizon.altitude)°\")","}","if let set = events.set {","    print(\"Set: \\(set)\")","}","","if events.isVisible {","    print(\"Sun is visible at some point today\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is convenient for building daily almanac displays."}],"type":"paragraph"},{"text":"Time Zones","anchor":"Time-Zones","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"All returned times are in UTC. Convert for display:"}],"type":"paragraph"},{"code":["let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer)!","","let formatter = DateFormatter()","formatter.timeZone = TimeZone(identifier: \"America\/New_York\")","formatter.timeStyle = .short","print(\"Sunrise: \\(formatter.string(from: sunrise.date))\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/astronomykit\/risesettimes"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"AstronomyKit"}],"role":"article","roleHeading":"Article","title":"Rise and Set Times"},"hierarchy":{"paths":[["doc:\/\/AstronomyKit\/documentation\/AstronomyKit"]]},"identifier":{"url":"doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/RiseSetTimes","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Events","anchor":"Events","identifiers":["doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipses","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/SeasonsAndEvents","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/AstroSearch","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Seasons","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Sun","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Eclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/LunarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/GlobalSolarEclipse","doc:\/\/AstronomyKit\/documentation\/AstronomyKit\/Loc