on and velocity in one call: longitude, latitude, distance, and their rates"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Moon phase angles, quarter searches, illumination, and libration","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Sunrise, sunset, moonrise, culmination, and custom altitude searches","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Lunar and solar eclipse prediction with timing"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Equinoxes and solstices for any year"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Transforms between equatorial, ecliptic, horizontal, and galactic frames","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Full ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" conformance for Swift 6"}]}]}],"type":"unorderedList"},{"level":3,"type":"heading","anchor":"Quick-Start","text":"Quick Start"},{"type":"codeListing","code":["import AstronomyKit","","\/\/ Your location","let observer = Observer(latitude: 40.7128, longitude: -74.0060)  \/\/ NYC","","\/\/ Current moon phase","let angle = try Moon.phaseAngle(at: .now)","print(\"\\(Moon.emoji(for: angle)) \\(Moon.phaseName(for: angle))\")","","\/\/ Next sunrise","if let sunrise = try CelestialBody.sun.riseTime(after: .now, from: observer) {","    print(\"Sunrise: \\(sunrise.date)\")","}","","\/\/ Where is Mars?","let mars = try CelestialBody.mars.horizon(at: .now, from: observer)","print(\"Mars: \\(mars.altitude)° \\(mars.compassDirection)\")"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Planetary-evaluation","text":"Planetary evaluation"},{"type":"paragraph","inlineContent":[{"text":"Qualified segments from 1900 through 2100 TT use compiled polynomial approximations of the full VSOP87B model. Position and heliocentric velocity share one representation. Dates outside that interval and 